.DS_Store
Thumbs.db
.idea/
.vscode/
.agents/
/agents/

# Temp
*.tmp
.cache/
.runtime/

# Test & build artifacts
coverage/
*.tsbuildinfo
.swc/
# AdminJS bundler output (tao khi chay panel /admin — artifact, khong commit)
.adminjs/
# Playwright E2E output (trace/screenshot cua lan chay gan nhat)
test-results/
playwright-report/
# Anh chup deterministic cua man bang gia (#144) — sinh lai tu bo test, khong commit
apps/web/e2e/__focus__/

# File khoa tam cua Microsoft Word (sinh ra khi mo .docx trong docs/khach-hang/)
~$*

# Thu muc nhap cuc bo. Da tung chua anh chup BANG GIA cua khach (tmp/pdfs/) va suyt bi commit bang
# mot `git add -A` — dung de no co co hoi lan sau. .dockerignore da loai `tmp` tu truoc.
tmp/

# Bao cao tin hieu deploy — sinh ra o goc checkout luc chay CD (deploy-ci.sh), khong commit.
deploy-signals.json
deploy-signals.log

# Conversation Bridge V0 (tools/conversation-bridge) — cau hinh CUC BO cua tung may va so khoa
# giao. `config.example.json` la ban mau duy nhat duoc commit; ban that mang ten kho, danh sach
# principal va duong dan may cua nguoi dung. So khoa giao la trang thai chay, khong phai ma nguon.
tools/conversation-bridge/config.json
tools/conversation-bridge/state/
tools/conversation-bridge/native-host/launch-host.cmd
tools/conversation-bridge/install/com.nexagnet.conversation_bridge.json
