# Copy thanh .env va dien gia tri that. KHONG commit file .env.

# Moi truong: development | test | production
NODE_ENV=development

# Backend API
PORT=3001

# PostgreSQL (khop docker-compose.yml khi chay local)
DATABASE_URL=postgresql://ultty:ultty_local@localhost:5432/ultty

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# --- XAC THUC API (header x-api-key) ---
# BO TRONG -> API MO cho bat ky ai goi duoc (chi dung o may local/demo, KHONG dua ra Internet).
# DAT GIA TRI (>=16 ky tu ngau nhien) -> moi route can header `x-api-key`, tru /health.
# NODE_ENV=production BAT BUOC co, thieu la API khong khoi dong duoc — vi POST /broadcast gui tin
# Zalo THAT toi nhieu nhom khach va GET /knowledge tra bang gia + map nhom -> dai ly.
# Sinh khoa:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LUU Y: app web goi API tu TRINH DUYET -> TUYET DOI khong dat khoa nay vao bien NEXT_PUBLIC_*
# (se lo cho moi nguoi xem duoc). Production: cho web goi qua proxy phia server.
API_KEY=

# Claude API - dung cho parser (PARSER_MODE=claude). De trong -> chay MockParser.
ANTHROPIC_API_KEY=
# DeepSeek API - dung truc tiep khi PARSER_MODE=deepseek; hoac luu trong credential cua Flowise.
DEEPSEEK_API_KEY=
# Flowise Agentflow V2 - BAT BUOC day du khi PARSER_MODE=flowise.
# Local Compose: http://flowise:3000. Khong mo Flowise ra Internet.
FLOWISE_BASE_URL=http://localhost:3002
FLOWISE_FLOW_ID=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT_MS=30000

# Zalo Bot Platform - token bot (BOT_MODE=on de doc tin that tu nhom)
# Lay token: app Zalo -> OA "Zalo Bot Manager" -> Tao bot
ZALO_BOT_TOKEN=
# Secret tu chon de verify webhook (khi test che do webhook)
ZALO_BOT_WEBHOOK_SECRET=

# --- Demo Ultty AI ---
# Parser: mock (tat dinh) | claude (Anthropic) | deepseek (DeepSeek, tuong thich OpenAI)
PARSER_MODE=mock

# --- Kenh Zalo (chon runtime qua CHANNEL_MODE) ---
# mock = offline (demo qua /demo/simulate) — mac dinh, khong can dang nhap Zalo
# bot  = Zalo Bot Platform chinh thuc (can ZALO_BOT_TOKEN) — CHI nhan tin @mention bot
# zca  = thu vien ngoai zca-js (dang nhap tai khoan ca nhan) — doc MOI tin nhom, khong can tag
# hybrid = Bot Platform xu ly tin native @mention; zca xu ly tin khong tag. Bat buoc ZALO_BOT_TOKEN.
# Moi kenh co chatId rieng: map ca Bot chat.id va zca threadId ve cung dai ly trong Knowledge.
# CANH BAO: zca vi pham ToS Zalo, co the bi KHOA tai khoan -> dung TAI KHOAN PHU + can van ban
# chap nhan rui ro cua khach (xem CLAUDE.md muc "Kenh Zalo GD1").
CHANNEL_MODE=mock
# Duong dan luu phien zca (cookie+imei+userAgent) sau khi quet QR lan dau — KHONG commit (secrets/).
ZALO_CRED_PATH=./secrets/zalo-cred.json
# Nghe ca tin do chinh tai khoan zca gui (isSelf)? Mac dinh off (tranh vong lap + nhieu).
ZALO_SELF_LISTEN=off
# Bot Platform (cu): giu cho tuong thich nguoc — neu CHANNEL_MODE khong dat nhung BOT_MODE=on
# thi coi la kenh 'bot'. Uu tien dung CHANNEL_MODE.
BOT_MODE=off
# Auto-ack: on -> bot tu nhan "Da ghi nhan, Sale se phan hoi..." khi LLM khong hieu (intent=Khac).
# Mac dinh off (GD1: AI khong tu tra loi nhom); chi bat khi khach dong y cho bot nhan tin.
AUTO_ACK=off
# Auto-send (GD2): on -> AI TU CHOT + gui xac nhan don vao nhom khi Giam sat khong phat hien
# rui ro (khong can Sale duyet); co van de (don lon/dai ly la/khieu nai/canh bao) -> giu Sale.
# Mac dinh off (GD1). Bat on CAN co van ban dong y cua khach (tuan thu CLAUDE.md).
AUTO_SEND=off
# Ten bot de boc @mention khoi noi dung tin
BOT_NAME=Bot ultty AI orders
# Origin cua app web (CORS)
CORS_ORIGIN=http://localhost:3000

# --- Broadcast khuyen mai (KH2) ---
# Gian cach giua 2 lan gui (ms) de tranh vuot rate-limit Zalo (chua cong bo). Mac dinh 1500.
BROADCAST_THROTTLE_MS=1500
# Tran so nhom moi lan gui — chan blast nham. Mac dinh 50.
BROADCAST_MAX_TARGETS=50

# --- Admin panel "Nguon su that" (AdminJS, mount /admin) ---
# Bat panel quan tri nguon su that (Dealer/Group/Product/Price/Glossary/Override).
# CHI mount khi ADMIN_UI=on VA PERSISTENCE=prisma (AdminJS can Postgres). Mac dinh off.
# Vi du chay panel:  PERSISTENCE=prisma ADMIN_UI=on pnpm --filter @ultty/api dev
ADMIN_UI=off
# Dang nhap panel. GIA TRI DEV — production BAT BUOC dat lai (mat khau + secret manh qua env).
ADMIN_EMAIL=admin@ultty.local
ADMIN_PASSWORD=ultty-admin
# Secret ky cookie phien AdminJS — production PHAI thay bang chuoi ngau nhien dai.
ADMIN_COOKIE_SECRET=ultty-admin-dev-cookie-secret-doi-o-production
