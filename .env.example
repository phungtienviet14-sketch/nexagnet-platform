# Copy thanh .env va dien gia tri that. KHONG commit file .env.

# Moi truong: development | test | production
NODE_ENV=development

# Backend API
PORT=3001

# PostgreSQL (khop docker-compose.yml khi chay local)
DATABASE_URL=postgresql://ultty:ultty_local@localhost:5432/ultty

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Claude API - dung cho parser (PARSER_MODE=claude). De trong -> chay MockParser.
ANTHROPIC_API_KEY=
# DeepSeek API - dung cho parser (PARSER_MODE=deepseek). Tuong thich OpenAI, re hon Claude.
DEEPSEEK_API_KEY=

# Zalo Bot Platform - token bot (BOT_MODE=on de doc tin that tu nhom)
# Lay token: app Zalo -> OA "Zalo Bot Manager" -> Tao bot
ZALO_BOT_TOKEN=
# Secret tu chon de verify webhook (khi test che do webhook)
ZALO_BOT_WEBHOOK_SECRET=

# --- Demo Ultty AI ---
# Parser: mock (tat dinh) | claude (Anthropic) | deepseek (DeepSeek, tuong thich OpenAI)
PARSER_MODE=mock
# Bot: off (demo qua /demo/simulate) | on (long-polling nhom Zalo, can ZALO_BOT_TOKEN)
BOT_MODE=off
# Auto-ack: on -> bot tu nhan "Da ghi nhan, Sale se phan hoi..." khi LLM khong hieu (intent=Khac).
# Mac dinh off (GD1: AI khong tu tra loi nhom); chi bat khi khach dong y cho bot nhan tin.
AUTO_ACK=off
# Ten bot de boc @mention khoi noi dung tin
BOT_NAME=Bot ultty AI orders
# Origin cua app web (CORS)
CORS_ORIGIN=http://localhost:3000
