{
  "permissions": {
    "defaultMode": "bypassPermissions" ,
    "deny": [
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose start:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker run:*)",
      "Bash(docker start:*)",
      "Bash(docker stop:*)",
      "Bash(docker volume rm:*)",
      "Bash(gh workflow run:*)",
      "Bash(./deploy/netviet/*)",
      "Bash(deploy/netviet/*)",
      "Bash(bash deploy/netviet/*)",
      "Bash(sh deploy/netviet/*)",
      "Bash(pwsh deploy/netviet/*)",
      "Bash(powershell deploy/netviet/*)",
      "Bash(gcloud secrets versions access:*)",
      "Read(./.env)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./secrets/**)"
    ]
  },
  "env": { "ECC_GATEGUARD": "off" },
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "worktree",
    "symlinkDirectories": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-check.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
