{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@netviet/web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@netviet/api", "dev"],
      "port": 3001
    },
    {
      "name": "web-transport",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/dev-transport.mjs"],
      "port": 3002
    }
  ]
}
