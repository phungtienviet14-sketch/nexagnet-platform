{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      // zca-js root index.d.ts dung `export * from "./dist"` (khong duoi file) — NodeNext khong
      // resolve directory import. Tro thang toi types day du o dist. Runtime van dung exports map.
      "zca-js": ["./node_modules/zca-js/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
