{
  "name": "@ultty/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage:zca": "vitest run src/channels/zalo-user.client.spec.ts src/channels/zalo.controller.spec.ts src/ingest/zca-listener.spec.ts --coverage --coverage.include=src/channels/zalo-user.client.ts --coverage.include=src/channels/zalo.controller.ts --coverage.include=src/ingest/zca-listener.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/nestjs": "^7.0.0",
    "@adminjs/prisma": "^5.0.4",
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@ultty/shared": "workspace:*",
    "adminjs": "^7.8.17",
    "dotenv": "^16.4.5",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zca-js": "^2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.0"
  }
}
