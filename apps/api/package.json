{
  "name": "@netviet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage:zca": "vitest run src/channels/zalo-user.client.spec.ts src/channels/zalo.controller.spec.ts src/ingest/zca-listener.spec.ts --coverage --coverage.include=src/channels/zalo-user.client.ts --coverage.include=src/channels/zalo.controller.ts --coverage.include=src/ingest/zca-listener.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/nestjs": "^7.0.0",
    "@adminjs/prisma": "^5.0.4",
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@date-fns/tz": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@netviet/shared": "workspace:*",
    "@netviet/tenant": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@quixo3/prisma-session-store": "3.1.21",
    "adminjs": "^7.8.17",
    "argon2": "0.44.0",
    "csrf-sync": "4.2.1",
    "csv-parse": "6.1.0",
    "date-fns": "4.4.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "p-limit": "^7.3.1",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "^0.2.2",
    "rrule": "2.8.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zca-js": "^2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.0.0"
  }
}
