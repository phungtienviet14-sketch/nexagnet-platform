// Prisma schema — Phase 3 (luu tru ben Postgres).
// Nguon su that mo hinh: docs/khach-hang/ultty/nghiep-vu/mo-ta-nghiep-vu.md + docs/phat-trien/kien-truc/he-thong.md (ERD).
// GHI CHU QUAN TRONG: app VAN chay in-memory mac dinh (PERSISTENCE=memory). Prisma chi bat khi
// PERSISTENCE=prisma -> demo/test khong can DB. Migration tao khi co Postgres: docker compose up -d postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Enums (khop literal union trong packages/shared) -----

enum DealerTier {
  dai_ly
  ctv
}

enum DealerStatus {
  active
  inactive
}

enum PolicyType {
  cong_no_30
  cong_no_45
  ky_gui
  thanh_toan_ngay
  cod
}

enum OrderStatus {
  draft
  pending_review
  needs_edit
  approved
  rejected
  sent
  synced
}

/// Trang thai map nhom -> dai ly. `pending` = nhom la (hop thu "nhom chua map").
enum GroupMappingStatus {
  pending
  mapped
  ignored
}

enum CustomerRank {
  dai_ly
  ctv
  khach_le
  unknown
}

enum OperationalRole {
  khach_hang
  sale
  ke_toan
  quan_ly
  ksnb
  bpvh
  ky_thuat
  unknown
}

enum ParticipantHandlingMode {
  inherit_group
  process
  ignore
  manual_review
}

enum ParticipantSource {
  zca_sync
  manual
  // Hoc tu luong tin: moi tin (zca lan Bot) deu kem uid + ten nguoi gui. Duong duy nhat con lai
  // sau khi getGroupInfo tra danh sach rong va Bot Platform khong co API thanh vien (04/08/2026).
  message_stream
}

enum RuleConfigStatus {
  draft
  preview
  active
  archived
}

enum CampaignStatus {
  draft
  approved
  scheduled
  running
  completed
  partially_failed
  cancelled
}

enum CampaignDeliveryStatus {
  pending
  claimed
  sent
  failed
  cancelled
}

enum CampaignKind {
  one_off
  recurring
  birthday
  lunar_month_start
  lunar_full_moon
}

enum PricePeriodStatus {
  draft
  active
  archived
}

enum ContentStatus {
  draft
  reviewed
  approved
  active
}

enum ContentAssetKind {
  image
  video
  pdf
  catalog
  company_profile
}

enum ContentSourceKind {
  local_manifest
  google_drive
  object_storage
  operator
}

enum ContentLinkKind {
  video
  catalog
  company_profile
}

enum UserRole {
  SALE
  MANAGER
  ACCOUNTING
  ADMIN
}

// ----- Nguon su that (tang 6) -----

model Dealer {
  id            String                @id @default(cuid())
  code          String?               @unique
  name          String
  aliases       String[]              @default([])
  tier          DealerTier
  defaultPolicy PolicyType
  phone         String?
  status        DealerStatus          @default(active)
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  groups        Group[]
  overrides     DealerPriceOverride[]
  orders        Order[]
}

/// 1 nhom Zalo -> 1 dai ly. Identity theo globalId khi Zalo co tra; chatId chi de routing.
model Group {
  id              String                @id @default(cuid())
  platform        String                @default("zalo")
  chatId          String
  /// Dinh danh on dinh cua Zalo cho cung mot nhom qua nhieu tai khoan. `chatId` chi la routing
  /// ID theo tai khoan dang dang nhap va co the thay doi khi doi tai khoan zca.
  globalId        String?               @unique
  name            String?
  branch          String?
  dealerId        String?
  dealer          Dealer?               @relation(fields: [dealerId], references: [id])
  status          GroupMappingStatus    @default(pending)
  source          String? // manual | auto_suggest | import
  lastSeenAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        Message[]
  orders          Order[]
  participants    GroupParticipant[]
  campaignTargets CampaignTarget[]
  mappingHistory  GroupMappingHistory[]

  @@unique([platform, chatId])
  @@index([status])
}

/// Lich su append-only cho moi lan map/remap/unmap. Group canonical giu nguyen id noi bo khi
/// routing chatId thay doi theo tai khoan Zalo.
model GroupMappingHistory {
  id               String             @id @default(cuid())
  groupId          String
  group            Group              @relation(fields: [groupId], references: [id])
  previousDealerId String?
  nextDealerId     String?
  previousStatus   GroupMappingStatus
  nextStatus       GroupMappingStatus
  source           String
  actor            String
  requestId        String?
  createdAt        DateTime           @default(now())

  @@index([groupId, createdAt])
}

model GroupParticipant {
  id              String                  @id @default(cuid())
  groupId         String
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalUserId  String
  /// Dinh danh on dinh cua thanh vien qua nhieu tai khoan zca; externalUserId chi la routing UID.
  globalId        String?
  displayName     String
  zaloName        String?
  avatarUrl       String?
  customerRank    CustomerRank            @default(unknown)
  operationalRole OperationalRole         @default(unknown)
  handlingMode    ParticipantHandlingMode @default(inherit_group)
  active          Boolean                 @default(true)
  source          ParticipantSource       @default(zca_sync)
  lastSeenAt      DateTime?
  syncedAt        DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([groupId, externalUserId])
  @@unique([groupId, globalId])
  @@index([groupId, active])
  @@index([externalUserId])
}

model Product {
  sku          String                @id
  name         String
  aliases      String[]              @default([])
  unit         String
  description  String?
  prices       Price[]
  overrides    DealerPriceOverride[]
  orderItems   OrderItem[]
  assets       ProductAsset[]
  faqs         FAQ[]
  advice       AdviceContent[]
  contentLinks ContentLink[]
  readiness    ContentReadiness?
}

/// Bang gia thang (gia dai ly/CTV TRA = wholesale = "Don gia CTV").
model Price {
  id             String      @id @default(cuid())
  periodId       String
  period         PricePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sku            String
  product        Product     @relation(fields: [sku], references: [sku])
  wholesale      Int
  minRetailPrice Int?
  retailPrice    Int?
  listPrice      Int?
  updatedAt      DateTime    @updatedAt

  @@unique([periodId, sku])
  @@index([sku])
}

model Campaign {
  id          String             @id @default(cuid())
  name        String
  content     String
  kind        CampaignKind       @default(one_off)
  templateKey String?
  recurrence  Json?
  metadata    Json               @default("{}")
  status      CampaignStatus     @default(draft)
  approvedBy  String?
  approvedAt  DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  scheduledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  targets     CampaignTarget[]
  deliveries  CampaignDelivery[]

  @@index([status, scheduledAt])
}

model CampaignTarget {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  chatId      String
  displayName String?
  enabled     Boolean           @default(true)
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())
  delivery    CampaignDelivery?

  @@unique([campaignId, chatId])
  @@index([groupId])
}

model CampaignDelivery {
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId       String                 @unique
  target         CampaignTarget         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status         CampaignDeliveryStatus @default(pending)
  scheduledFor   DateTime
  nextAttemptAt  DateTime?
  attempts       Int                    @default(0)
  claimedAt      DateTime?
  claimedBy      String?
  claimExpiresAt DateTime?
  sentAt         DateTime?
  lastError      String?
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, scheduledFor, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([campaignId, status])
}

/// Mot ky gia co vong doi draft -> active -> archived. validMonth nullable CHI de giu du lieu
/// legacy khong co thang; row null luon archived va khong bao gio duoc dung/activate.
model PricePeriod {
  id          String            @id @default(cuid())
  validMonth  String?
  status      PricePeriodStatus @default(draft)
  source      String?
  note        String?
  createdBy   String?
  activatedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activatedAt DateTime?
  prices      Price[]

  @@index([validMonth])
  @@index([status])
}

/// Deal rieng: override gia si theo dealer + sku.
model DealerPriceOverride {
  id            String    @id @default(cuid())
  dealerId      String
  dealer        Dealer    @relation(fields: [dealerId], references: [id])
  sku           String
  product       Product   @relation(fields: [sku], references: [sku])
  price         Int
  /// So luong toi thieu de deal co hieu luc. NULL = ap cho moi so luong (hanh vi truoc 12/08/2026).
  minQuantity   Int?
  enabled       Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([dealerId, sku])
  @@index([enabled, effectiveFrom, effectiveTo])
}

model GlossaryEntry {
  term    String @id
  meaning String
}

// ----- Product content (metadata only; binary remains in Drive/object storage) -----

model SourceProvenance {
  id         String            @id
  kind       ContentSourceKind
  sourceId   String
  locator    String?
  hash       String?
  version    String?
  importedAt DateTime          @default(now())
  assets     Asset[]
  faqs       FAQ[]
  advice     AdviceContent[]
  links      ContentLink[]

  @@unique([kind, sourceId])
}

model Asset {
  id             String            @id
  externalId     String
  kind           ContentAssetKind
  title          String?
  locator        String
  mimeType       String?
  source         ContentSourceKind
  sourceFileId   String?
  hash           String?
  version        String?
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductAsset[]

  @@unique([provenanceId, externalId])
  @@index([status, kind])
}

model ProductAsset {
  productSku String
  product    Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([productSku, assetId])
  @@index([assetId])
}

model FAQ {
  id                String            @id
  externalId        String
  productSku        String?
  product           Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  question          String
  answer            String
  status            ContentStatus     @default(draft)
  /// #205: ban ghi nay co duoc KE LAI trong loi nhan khong.
  /// NULL = chua ai tuyen bo = KHONG ke duoc. Vang mat la tu choi, khong bao gio la cho phep.
  narrativeEligible Boolean?
  provenanceId      String?
  provenance        SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model AdviceContent {
  id                String            @id
  externalId        String
  productSku        String?
  product           Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  title             String
  body              String
  status            ContentStatus     @default(draft)
  /// #205: ban ghi nay co duoc KE LAI trong loi nhan khong.
  /// NULL = chua ai tuyen bo = KHONG ke duoc. Vang mat la tu choi, khong bao gio la cho phep.
  narrativeEligible Boolean?
  provenanceId      String?
  provenance        SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model ContentLink {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  kind           ContentLinkKind
  title          String
  url            String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status, kind])
}

model ContentReadiness {
  key        String   @id
  productSku String?  @unique
  product    Product? @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  ready      Boolean  @default(false)
  missing    String[] @default([])
  checkedAt  DateTime @updatedAt
}

// ----- Tin nhan & don (tuan thu: luu MOI tin ngay khi nhan) -----

model Message {
  id                String         @id @default(cuid())
  externalMessageId String
  platform          String         @default("zalo")
  source            String // zca_listener | bot | copilot
  chatId            String
  groupId           String?
  group             Group?         @relation(fields: [groupId], references: [id])
  senderExternalId  String?
  senderDisplayName String?
  text              String
  // Pha 1 (18/08/2026) — huong tin: 'inbound' = khach/dai ly gui vao, 'outbound' = he thong gui ra.
  // Cot da ton tai tren DB tu migration 20260815140000_message_direction; truoc do schema thieu
  // field nay nen `prisma migrate dev` se sinh migration DROP cot. Dung xoa.
  direction         String         @default("inbound")
  // Vai nguoi gui, de dung lai lich su hoi thoai co nhan cho LLM. 'customer' | 'bot' | 'sale'.
  senderRole        String         @default("customer")
  imageUrl          String?
  // Dot A' Task 2 — anh da TAI VE kho ben vung. `imageUrl` la link Zalo, chet sau <=35 ngay
  // (Zalo xoa object phia server); `mediaKey` moi la thu con lai sau do.
  // mediaError != null = da thu tai va that bai — tin VAN nguyen ven, chi thieu file anh.
  mediaKey          String?
  mediaBytes        Int?
  mediaFetchedAt    DateTime?
  mediaError        String?
  sentAt            DateTime
  receivedAt        DateTime       @default(now())
  raw               Json?
  orders            Order[] // legacy first-message relation
  orderProvenance   OrderMessage[]

  @@unique([platform, externalMessageId])
  @@index([chatId])
  // Cua so hoi thoai doc theo nhom + thoi gian giam dan (ConversationContextBuilder.build).
  @@index([chatId, sentAt])
}

model Order {
  id                String          @id @default(cuid())
  status            OrderStatus     @default(pending_review)
  orderType         String? // TH1 | TH2
  intent            String
  senderType        String
  chatId            String
  groupId           String?
  group             Group?          @relation(fields: [groupId], references: [id])
  dealerId          String?
  dealer            Dealer?         @relation(fields: [dealerId], references: [id])
  dealerName        String?
  branch            String?
  groupName         String?
  rawText           String
  imageUrl          String?
  messageId         String?
  message           Message?        @relation(fields: [messageId], references: [id])
  confidence        Json?
  parsed            Json?
  priced            Json?
  trace             Json?
  grandTotal        Int?
  /// Ma don ben ERP cua khach. Trung tinh theo nha cung cap (G1-12); GD1 khong ghi truong nay.
  erpCode           String?
  ruleConfigVersion Int?
  /// Ban day du OrderView (nguon su that cho repo — round-trip khong mat field long nhau).
  view              Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  feedback          ParseFeedback[]
  sourceMessages    OrderMessage[]

  @@index([status])
  @@index([chatId])
}

/// Complete, append-only provenance for orders assembled from one or more chat messages.
/// Order.messageId is retained as a forward-compatible legacy pointer to the first message.
model OrderMessage {
  orderId   String
  messageId String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([orderId, messageId])
  @@index([messageId])
}

/// MACH HOI THOAI theo TUNG KHACH trong MOT nhom (Pha 6 — 21/08/2026).
///
/// Khoa la `(chatId, senderExternalId)`, KHONG phai chatId: mot nhom Zalo co 200 dai ly cung ban
/// tin, khoa theo nhom nghia la cau tra loi "20 cai" cua nguoi nay dien vao don nhap cua nguoi kia.
///
/// `draft` la JSON cua `OrderDraft` (don NUA VOI). Khong tach thanh bang dong hang: no la trang
/// thai tam, song vai chuc phut roi chot thanh `Order` — bang con chi them viec don dep.
model ConversationThread {
  id                String   @id @default(cuid())
  chatId            String
  senderExternalId  String
  senderDisplayName String?
  /// collecting | awaiting_answer | closed | handed_off
  status            String   @default("collecting")
  draft             Json
  /// Slot dang cho khach tra loi: product | quantity | recipient
  awaitingSlots     String[] @default([])
  askCount          Int      @default(0)
  lastQuestion      String?
  lastOrderId       String?
  /// Qua moc nay, tin sau mo mach MOI — khong ke thua don nhap cu.
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([chatId, senderExternalId])
  @@index([chatId, status])
  @@index([expiresAt])
}

model RuleConfigVersion {
  id          String           @id @default(cuid())
  version     Int              @unique @default(autoincrement())
  status      RuleConfigStatus @default(draft)
  payload     Json
  createdBy   String?
  activatedBy String?
  createdAt   DateTime         @default(now())
  activatedAt DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actor])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String?
  product     Product? @relation(fields: [sku], references: [sku])
  skuRaw      String
  productName String?
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  matched     Boolean  @default(false)
}

/// Feedback loop: cap (AI output, ban Sale sua) -> mo rong glossary/few-shot.
model ParseFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  aiOutput  Json
  corrected Json
  createdAt DateTime @default(now())
}

// ----- Quan tri (Phase 5) -----

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String
  role              UserRole
  disabledAt        DateTime?
  credentialVersion Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
}

/// Persistent backing store for express-session. `data` contains the serialized server-side
/// session; the browser receives only the opaque signed sid cookie.
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model KpiEvent {
  id      String   @id @default(cuid())
  type    String
  orderId String?
  payload Json?
  at      DateTime @default(now())

  @@index([type])
}

/// Trang thai mot hang OUTBOX. `dispatched` = engine DA nhan; no KHONG noi gi ve viec workflow
/// chay xong hay chua — do la viec cua engine, va Nexagnet khong nhan ban sao lich su do.
enum WorkflowOutboxStatus {
  pending
  claimed
  dispatched
  failed
  cancelled
}

/// BAN GIAO TIN CAY tu DB nghiep vu sang workflow engine (bai toan ghi hai noi).
///
/// Hang nay duoc ghi TRONG CUNG `$transaction` voi thay doi nghiep vu, nen khong co cua so nao
/// de mot su kien bien mat giua "Order da commit" va "engine da nhan". Xem
/// `apps/api/src/workflow/workflow-outbox.repository.ts` de biet ranh gioi voi Hatchet.
///
/// KHONG phai workflow engine thu hai: khong buoc, khong cay thuc thi, khong replay, khong lich su.
model WorkflowOutbox {
  id                 String               @id @default(cuid())
  /// Khoa thao tac cua Nexagnet. DUY NHAT — xep hai lan cung mot thao tac chi ra mot hang.
  operationKey       String               @unique
  workflowKey        String
  /// Phien ban khuon (`v1`). Ghim tai thoi diem XEP HANG: mot su kien xep hom qua phai chay
  /// bang phien ban cua hom qua, ke ca khi hom nay khach da chuyen sang v2.
  workflowVersion    String
  entityType         String
  entityId           String
  /// Da qua `buildWorkflowInput` — danh sach trang, khong PII, khong bi mat.
  payload            Json
  /// Da qua `buildWorkflowMetadata` — chi neo tuong quan.
  metadata           Json
  traceId            String?
  status             WorkflowOutboxStatus @default(pending)
  attempts           Int                  @default(0)
  maxAttempts        Int
  baseBackoffSeconds Int
  nextAttemptAt      DateTime?
  claimedAt          DateTime?
  claimedBy          String?
  claimExpiresAt     DateTime?
  dispatchedAt       DateTime?
  /// Tham chieu sang lan thuc thi ben engine. Day la SOI DAY duy nhat Nexagnet giu — lich su
  /// chi tiet nam ben engine va bi xoa sau 30 ngay theo cau hinh luu tru cua no.
  engineRunId        String?
  lastError          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([entityType, entityId])
}

// ----- Transport domain: TX-01 Fleet + TX-02 Trip Operations (capability `transport-core`) -----
//
// Nguon mo hinh: docs/kien-truc/transport-domain-contract.md §5 (aggregate), §6 (bat bien),
// §7.1 (may trang thai chuyen). Day la schema CUA MIEN VAN TAI, dung chung cho MOI khach van tai —
// khong co gi rieng cua mot khach o day (guardrail NO_TRANSPORT_TENANT_SLUG_IN_DOMAIN_CODE).
//
// Tien: `BigInt` = SO NGUYEN DONG, kem mot cot `currencyCode`. `GD-03` — VND khong co don vi phu,
// va them cot tien te ve sau la mot migration doc du lieu; them bay gio gan nhu mien phi.
// T2.1/F1 doi `Int` -> `BigInt`: `INTEGER` tran o ~2,1 ty dong, thap hon bien ma HTTP va `money()`
// deu chap nhan, nen ton tai mot khoang gia tri "hop le voi mien, chet o DB".
//
// Ngay nghiep vu: `VarChar(10)` chua `YYYY-MM-DD` theo mui gio tenant (`INV-25`, `GD-04`). CO Y
// khong dung `DateTime`: mot cot timestamp la thu duy nhat ma nguoi doc co the "suy nguoc ra ngay"
// — va suy nguoc bang UTC chinh la loi ma `INV-25` sinh ra de chan. Khong co timestamp thi khong
// co gi de suy nguoc. So sanh khoang va sap xep van dung vi ISO-8601 sap xep theo tu dien.
// T2.1/F3 GIU nguyen quyet dinh nay va them `CHECK` o DB cho dang chuoi (xem duoi).
//
// NAM DOI TUONG DB CUA MIEN NAY KHONG BIEU DIEN DUOC BANG PRISMA SCHEMA
// -----------------------------------------------------------------------------------------------
// Chung song trong SQL tho cua migration `20260830090000_transport_storage_invariants`.
//
//   HAI unique MOT PHAN
//     1. `TransportTripAssignment_activeTrip_key`        — `WHERE "effectiveTo" IS NULL`, theo chuyen
//     2. `TransportVehicleAssignment_activeVehicle_key`  — nhu tren, theo xe
//   BA rang buoc CHECK
//     3. `TransportTrip_freightAmount_money_range`       — khoang tien +-(2^53-1)
//     4. `TransportTrip_businessDate_iso`                — ngay nghiep vu dang YYYY-MM-DD
//     5. `TransportDriver_licenceExpiry_iso`             — han GPLX, cung rang buoc
//
// Prisma khong co cu phap cho `WHERE` tren index lan cho `CHECK`. `migrate deploy` — duong cua CI
// va cua trien khai trong repo nay — giu ca NAM nguyen ven. Nhung `prisma migrate dev` sinh
// migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca NAM: dung nhu su co cot
// `direction` da ghi o ke-hoach/tong-quan.md §Pha 0. Ai chay `migrate dev` PHAI doc lai migration
// sinh ra va bo cac dong `DROP INDEX`/`DROP CONSTRAINT` do truoc khi commit.
// -----------------------------------------------------------------------------------------------

enum TransportVehicleStatus {
  IDLE
  ON_TRIP
  UNDER_MAINTENANCE
}

enum TransportDriverStatus {
  ACTIVE
  INACTIVE
}

enum TransportPartyStatus {
  ACTIVE
  INACTIVE
}

/// VT-054: mot doi tac mang NHIEU vai. Day la enum cua tung DONG vai, khong phai cot loai doi tac.
enum TransportPartnerRoleKind {
  CARRIER
  ORDER_REFERRER
}

enum TransportTripKind {
  OWN_DIRECT
  EXTERNAL_CARRIER
  PARTNER_REFERRED_INTERNAL_RUN
}

enum TransportTripStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  RECONCILED
  CANCELLED
}

model TransportVehicle {
  id                        String                             @id @default(cuid())
  registrationPlate         String                             @unique
  vehicleClass              String
  /// VT-010. NULL = chua nhap.
  allowedPayloadKg          Int?
  /// VT-012. T2 chi GIU so; cap nhat tu dong moi lan do dau la viec cua T4.
  currentOdoKm              Int                                @default(0)
  status                    TransportVehicleStatus             @default(IDLE)
  /// AI DIEU HANH xe nay — TRUC DOC LAP voi quyen so huu (TX-08, #242 E1).
  ///
  /// Mac dinh `INTERNAL_OPERATED`, va them mot ben huu quan KHONG doi cot nay: mot xe dong so huu
  /// ma B van dieu hanh la xe NOI BO. Xem khoi canh bao dau muc TX-08 o cuoi tep.
  operationalControl        TransportVehicleOperationalControl @default(INTERNAL_OPERATED)
  /// SO DANG KY SO HUU DA DAY DU hay chua — #242 E2.
  ///
  /// `false` (mac dinh) nghia la du lieu so huu co the con THIEU, va tong ty le duoc phep nho hon
  /// 100%. Do la trang thai THAT cua mot doanh nghiep dang nhap dan, va tu choi mot ty le dung vi
  /// chua du 100% se buoc nguoi nhap BIA NOT phan con lai.
  ///
  /// `true` la mot LOI KHAI co chu the: tu luc do tong cac ty le dang hieu luc phai dung 10000
  /// diem co ban, va dich vu cuong che bat bien do o moi lan ghi.
  ownershipRegisterComplete Boolean                            @default(false)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt

  driverAssignments  TransportVehicleAssignment[]
  tripAssignments    TransportTripAssignment[]
  /// `TX-04` — phieu do dau va cac dong bang ke da nhan dien duoc ra xe nay.
  fuelEntries        TransportFuelEntry[]
  fuelStatementLines TransportFuelStatementLine[]
  /// `TX-08` — cac quyen loi so huu tren xe nay, KE CA cac ban da dong. Xem cuoi tep.
  ownershipInterests TransportVehicleOwnershipInterest[]
  /// `TX-06` — lich bao duong va lenh sua cua xe nay. Chi co mat khi khach bat
  /// `transport-asset-compliance`.
  maintenancePlans   TransportMaintenancePlan[]
  workOrders         TransportMaintenanceWorkOrder[]
  /// R1-B: cac vong chay vat ly cua chinh chiec xe nay.
  runs               TransportVehicleRun[]
  /// `transport-proof` — cac phien bam vi tri gan voi xe nay. Xe do MAY CHU dien tu ban phan
  /// cong; may khach khong bao gio duoc noi minh dang lai xe nao.
  trackingSessions   TransportTrackingSession[]
  /// `transport-toll` (#269) — cac doan noi voi mot tai khoan giao thong, KE CA cac doan da dong,
  /// va cac dong sao ke ETC da nhan dien duoc ra xe nay. ETC la CONG TY TRA: khong duong nao tu
  /// day di vao so quy lai xe.
  tollAccountLinks   TransportTollAccountVehicleLink[]
  tollCandidates     TransportTollTransactionCandidate[]

  @@index([status])
}

model TransportDriver {
  id            String                @id @default(cuid())
  fullName      String
  phone         String
  licenceClass  String
  /// Han GPLX — NGAY nghiep vu, khong phai khoanh khac.
  licenceExpiry String                @db.VarChar(10)
  status        TransportDriverStatus @default(ACTIVE)
  /// Cau noi user dang nhap -> ho so lai xe. CHI aggregate nay giu no.
  authUserId    String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  vehicleAssignments  TransportVehicleAssignment[]
  tripAssignments     TransportTripAssignment[]
  /// `TX-03` — mot lai xe MOT so quy. Chi co mat khi khach bat `transport-costing`.
  fundAccount         TransportDriverFundAccount?
  tripExpenses        TransportTripExpense[]
  /// `TX-04` — phieu do dau lai xe nay da khai.
  fuelEntries         TransportFuelEntry[]
  /// `TX-07` — phieu luong cua lai xe nay. Chi co mat khi khach bat `transport-workforce`.
  payslips            TransportPayslip[]
  /// `TX-07b` — cac lan lai xe rut tien da duoc ghi nhan. Xem khoi `TransportDriverCashout`.
  cashouts            TransportDriverCashout[]
  /// R1-B: lich su cam lai cac vong chay v2.
  runAssignments      TransportRunAssignment[]
  /// R1-C: de nghi chi cua chinh lai xe nay.
  expenseClaims       TransportExpenseClaim[]
  /// `transport-proof` — cac phien bam vi tri va cac ma cai dat ung dung cua lai xe nay.
  trackingSessions    TransportTrackingSession[]
  deviceInstallations TransportDeviceInstallation[]
  operationalProofs   TransportOperationalProof[]
  /// F1 (#243): moc van hanh do chinh lai xe nay ghi.
  runCheckpoints      TransportRunCheckpoint[]
  proofChallenges     TransportProofChallenge[]
  /// `#267` H3/H4: cac lan chinh lai xe nay xac nhan dia diem A va tao vong chay.
  siteIntakes         TransportRunSiteIntake[]

  @@index([status])
  @@index([licenceExpiry])
}

/// Gan lai xe phu trach mot xe — tang DOI XE. `effectiveTo = NULL` la ban dang hieu luc.
///
/// MOT ban hieu luc cho moi xe duoc CUONG CHE O DB bang unique mot phan
/// `TransportVehicleAssignment_activeVehicle_key` (`WHERE "effectiveTo" IS NULL`), khai trong SQL
/// tho vi Prisma khong co cu phap cho no. Xem khoi canh bao dau muc Transport.
///
/// Unique do cuong che DUNG MOT DIEU: toi da mot ban DANG hieu luc. NHIEU ban DA DONG cua cung mot
/// xe van ghi duoc — `GD-06` doi hoi giu lich su. Dieu do KHONG noi bat bien T1 §5 `TX-01`
/// (*khong chong lap thoi gian cho cung mot xe*): duong ghi dong ban cu DUNG TAI moc mo ban moi,
/// nen ghi binh thuong khong sinh chong lap. Chan chong lap TUY Y can EXCLUSION CONSTRAINT
/// (`btree_gist` + `tstzrange`) — ghi nhan la lua chon siet them ve sau, khong lam o T2.1.
model TransportVehicleAssignment {
  id            String           @id @default(cuid())
  vehicleId     String
  vehicle       TransportVehicle @relation(fields: [vehicleId], references: [id])
  driverId      String
  driver        TransportDriver  @relation(fields: [driverId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime         @default(now())

  @@index([vehicleId, effectiveTo])
  @@index([driverId])
}

/// KHACH HANG VAN TAI — ben thue van chuyen. KHONG dung chung bang voi `Dealer` cua mien ban hang.
model TransportCustomer {
  id        String               @id @default(cuid())
  name      String
  phone     String?
  address   String?
  taxCode   String?
  status    TransportPartyStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  trips                 TransportTrip[]
  /// R1-B: nghia vu thuong mai cua khach nay.
  orders                TransportOrder[]
  /// `TX-05` — dieu khoan thanh toan + han muc tin dung. Tuy chon: khach chua khai thi khong co hang.
  terms                 TransportCustomerTerms?
  /// Lane Q: doi soat/thu tien phai thu khach. Payment la su kien rieng, khong phai boolean tren don.
  reconciliationBatches TransportCustomerReconciliationBatch[]
  reconciliations       TransportCustomerReconciliation[]
  payments              TransportCustomerPayment[]

  @@index([status])
}

model TransportPartner {
  id        String               @id @default(cuid())
  name      String
  phone     String?
  status    TransportPartyStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  roles           TransportPartnerRole[]
  carriedTrips    TransportTrip[]           @relation("TransportTripCarrier")
  referredTrips   TransportTrip[]           @relation("TransportTripReferrer")
  /// `TX-05` — luat hoa hong dat rieng cho doi tac nay. KHONG phai cong no: cong no cua doi tac
  /// nam o `TransportSettlementDocument` va tach theo `flow`, vi mot doi tac mang hai vai (VT-054).
  commissionRules TransportCommissionRule[]

  @@index([status])
}

/// VAI cua doi tac — mot BANG rieng, khong phai mot cot tren `TransportPartner`.
///
/// Khoa chinh kep `(partnerId, role)` lam hai viec cung luc: mot vai khong lap lai duoc, va khong
/// co cho nao de dat mot cot `partnerType` loai tru. Mo hinh XOR ma VT-054 dan tranh khong bieu
/// dien duoc o day — do la ly do bang nay ton tai thay vi mot cot enum.
model TransportPartnerRole {
  partnerId String
  partner   TransportPartner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  role      TransportPartnerRoleKind
  createdAt DateTime                 @default(now())

  @@id([partnerId, role])
  @@index([role])
}

model TransportTrip {
  id                 String              @id @default(cuid())
  code               String              @unique
  kind               TransportTripKind
  status             TransportTripStatus @default(PLANNED)
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate       String              @db.VarChar(10)
  /// `GD-05`: v1 mot diem di, mot diem den. Da diem se la bang `TransportTripStop` khi co nguon.
  originLabel        String
  destinationLabel   String
  cargoDescription   String?
  customerId         String?
  customer           TransportCustomer?  @relation(fields: [customerId], references: [id])
  /// Nha xe cho chuyen `EXTERNAL_CARRIER`.
  carrierPartnerId   String?
  carrierPartner     TransportPartner?   @relation("TransportTripCarrier", fields: [carrierPartnerId], references: [id])
  /// Doi tac mang don cho chuyen `PARTNER_REFERRED_INTERNAL_RUN`.
  referrerPartnerId  String?
  referrerPartner    TransportPartner?   @relation("TransportTripReferrer", fields: [referrerPartnerId], references: [id])
  /// DOANH THU — gia cuoc thu khach (VT-021), SO NGUYEN DONG. Be mat lai xe khong bao gio thay
  /// cot nay (`INV-09`): `DriverTripView` khong co truong tuong ung de nhan no.
  ///
  /// `BigInt` = `BIGINT` chu khong `INTEGER`: T2.1/F1 — `INTEGER` tran o 2.147.483.647 dong, tuc
  /// mot cuoc 3 ty qua duoc kiem HTTP va kiem mien roi chet o `INSERT`. Khoang thuc te bi `CHECK`
  /// `TransportTrip_freightAmount_money_range` bo hep ve `+-(2^53-1)` cho khop `money()`.
  freightAmount      BigInt?
  currencyCode       String              @default("VND") @db.VarChar(3)
  /// `GD-14` — nhap tay, nullable.
  distanceKm         Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  /// `GD-02` — huy THAY CHO xoa. Khong co duong xoa cung nao cho mot chuyen.
  cancelledAt        DateTime?
  cancellationReason String?

  assignments         TransportTripAssignment[]
  /// `TX-03` — hai lop cua mot khoan chi (`INV-03`). Chuyen la NGUON SU THAT cua ca hai.
  fundEntries         TransportDriverFundEntry[]
  expenses            TransportTripExpense[]
  /// `TX-04` — phieu do dau cua chuyen. `INV-04`: chuyen thue xe ngoai khong duoc co dong nao o day.
  fuelEntries         TransportFuelEntry[]
  /// `TX-05` — chung tu AR/AP sinh ra tu chuyen nay. NHIEU hang la binh thuong: mot chuyen thue xe
  /// ngoai vua co doanh thu khach (`CUSTOMER_FREIGHT`) vua co cong no nha xe (`CARRIER_SERVICE`).
  settlementDocuments TransportSettlementDocument[]
  /// `TX-05` — lan tinh hoa hong cua chuyen. Nhieu nhat MOT.
  commission          TransportCommissionCalculation?
  /// `TX-06b` — cac lan hong DOC DUONG da lam dut chuyen nay. Thuong rong.
  roadsideBreakdowns  TransportMaintenanceWorkOrder[]
  /// R1-B: BANG TUONG UNG toi mot chang v2. KHONG phai quan he cha/con (#232 `D-01`) -
  /// bo `TransportTripRunLegLink` di thi chuyen nay van chay y nguyen.
  runLegLink          TransportTripRunLegLink?
  /// `#275` K5: BANG TUONG UNG toi mot NGHIA VU v2 — truc THUONG MAI, doc lap voi `runLegLink`.
  orderLink           TransportTripOrderLink?
  /// R1-C: de nghi chi gan vao chuyen nay.
  expenseClaims       TransportExpenseClaim[]
  /// `transport-proof` — cac phien bam vi tri cua chuyen. NHIEU hang la binh thuong: mot ca lai
  /// bi ngat giua chung roi mo lai la hai phien tren cung mot chuyen.
  trackingSessions    TransportTrackingSession[]
  /// `transport-proof` — chung cu bat dau/giao hang cua chuyen.
  operationalProofs   TransportOperationalProof[]

  @@index([status])
  @@index([businessDate])
  @@index([kind])
}

/// PHAN CONG CHUYEN — `GD-06`: LICH SU, khong ghi de.
///
/// `effectiveTo = NULL` la ban dang hieu luc; doi xe/lai xe giua chuyen DONG ban cu lai va mo ban
/// moi. Neu day la hai cot tren `TransportTrip` thi lan doi lai xe se xoa mat dau ai cam vo lang
/// luc mot khoan chi phat sinh — va quy trach nhiem so quy theo lai xe (T3) mat co so.
///
/// MOT ban hieu luc cho moi chuyen duoc CUONG CHE O DB bang unique mot phan
/// `TransportTripAssignment_activeTrip_key` (`WHERE "effectiveTo" IS NULL`). Giao dich dong-roi-mo
/// trong `PrismaTripRepository.assign()` la dung voi MOT nguoi ghi; unique nay la thu duy nhat
/// dung voi HAI nguoi ghi cung luc.
///
/// Nhu tren: unique chi cam ban thu hai DANG hieu luc, khong cam nhieu ban DA DONG. `assign()`
/// dat `previous.effectiveTo = current.effectiveFrom`, nen chuoi lich su noi lien nhau, khong ho
/// va khong chong lap.
model TransportTripAssignment {
  id            String            @id @default(cuid())
  tripId        String
  trip          TransportTrip     @relation(fields: [tripId], references: [id])
  vehicleId     String?
  vehicle       TransportVehicle? @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        TransportDriver?  @relation(fields: [driverId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  assignedBy    String
  createdAt     DateTime          @default(now())

  @@index([tripId, effectiveTo])
  @@index([driverId])
  @@index([vehicleId])
}

// ----- Nguon su that doanh nghiep (Source Management Foundation v0) -----
//
// TANG NAY TRUNG TINH VE KHACH VA VE MIEN. Khong mot ten khach, khong mot thuat ngu ban hang hay
// van tai nao duoc xuat hien trong khoi duoi day: cung bo bang nay phuc vu ca khach ban hang lan
// khach van tai, va do la dieu kien de no o `apps/` chu khong o `tenants/`.
//
// QUAN HE VOI `SourceProvenance` (da co, phia tren). Hai thu KHAC NHAU va co y khong gop:
//   · `SourceProvenance` = ban ghi NHAP LIEU cua duong dong bo noi dung (Drive -> Asset/FAQ):
//     "byte nay tu tep Drive nao ra". Khong co trang thai, khong co phe duyet, khong co khach.
//   · `BusinessSource`    = ban ghi QUAN TRI cua mot nguon su that nghiep vu: no da duoc ai duyet
//     chua, co hieu luc tu bao gio, ban nao thay ban nao, va duoc phep luu o dau.
// Gop lam mot se bat duong dong bo noi dung phai mang mot vong doi phe duyet ma no khong can, va
// bat tang quan tri phai chay theo nhip cua mot job dong bo. Duong di ve sau la `SourceProvenance`
// tro toi mot `BusinessSource` khi can, khong phai doi ten no.

enum SourceStatus {
  RECEIVED
  NORMALIZED
  REVIEWED
  APPROVED
  EFFECTIVE
  SUPERSEDED
  REJECTED
  QUARANTINED
}

enum SourceOrigin {
  CUSTOMER_PROVIDED
  CUSTOMER_SIGNED
  INTERNAL_DERIVED
  INTERNAL_TEST
  THIRD_PARTY
}

enum SourceAuthority {
  L1_CONTRACTUAL
  L2_CUSTOMER_PUBLISHED
  L3_CUSTOMER_INTERNAL
  L4_PRE_CONTRACT
  L5_DERIVED
}

enum DataClassification {
  PUBLIC
  INTERNAL
  BUSINESS_SENSITIVE
  PII
  SECRET
}

enum ApprovalLevel {
  INTERNAL_ACCEPTED
  CUSTOMER_CONFIRMED
}

enum BusinessFactStatus {
  PROPOSED
  WORKING_ASSUMPTION
  CONFIRMED
  SUPERSEDED
  REJECTED
}

enum BusinessConflictStatus {
  OPEN
  RESOLVED
  SUPERSEDED
  WITHDRAWN
}

enum BusinessConflictImpact {
  BLOCKING
  DEGRADING
  ADVISORY
}

/// MOT NGUON SU THAT — mot BAN (version) cu the cua mot tai lieu/bang/thoa thuan.
///
/// TEN TEP KHONG PHAI DANH TINH. Danh tinh la `(tenantId, sourceKey, contentHash)`: cung mot ten
/// tep voi hash khac nhau la HAI ban khac nhau, va phai cung ton tai duoc. Do la cai ma troi
/// phien ban thang 07/thang 08 cua Ultty da chung minh — khi danh tinh la ten tep, ban moi ghi de
/// ban cu va lich su bien mat ma khong ai bam nut xoa.
///
/// `locator` KHONG chua byte. No la duong den kho rieng (Drive/object storage/may van hanh) —
/// `docs/phat-trien/van-hanh/nguon-khach-hang.md` mo ta giao thuc. Repo nay PUBLIC; byte cua khach
/// khong duoc o day, va `tools/customer-source-guardrail` la thu thi hanh dieu do o tang git.
model BusinessSource {
  id String @id @default(cuid())

  /// Danh tinh khach. Hom nay moi khach mot DB nen cot nay du thua ve ha tang — nhung no la thu
  /// duy nhat con dung khi dieu do thoi dung. Xem `source-registry/tenant-scope.ts`.
  tenantId String

  /// Khoa on dinh do nguoi dat, KHONG doi giua cac ban (vd bang gia thang cua mot khach).
  /// Hai ban cua cung mot tai lieu dung chung `sourceKey` va khac `version`.
  sourceKey String
  title     String
  /// Loai nguon, tu do co chu y: moi vertical goi ten tai lieu cua no mot kieu. Ep enum o day se
  /// bat mot khach van tai phai muon thuat ngu cua mot khach ban hang.
  kind      String
  version   String

  origin         SourceOrigin
  authority      SourceAuthority
  classification DataClassification
  status         SourceStatus       @default(RECEIVED)

  /// Duong den byte trong kho RIENG. NULL khi moi ghi nhan su ton tai ma chua co duong.
  locator     String?
  /// SHA-256 cua byte. La thu duy nhat chung minh "van dung ban do" ma khong can giu ban sao.
  contentHash String?
  /// Kich thuoc byte — de doi chieu nhanh cung hash khi kiem chung lai.
  byteSize    Int?

  receivedAt    DateTime  @default(now())
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// Ban ma ban NAY thay the. Lich su di theo canh nay va khong bao gio bi ghi de.
  supersedesId String?         @unique
  supersedes   BusinessSource? @relation("SourceSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy BusinessSource? @relation("SourceSupersession")

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts     BusinessFact[]
  approvals BusinessApproval[]

  /// Cung ten tep + hash khac = ban khac. Rang buoc nay la cho bat bien do duoc thi hanh.
  @@unique([tenantId, sourceKey, contentHash])
  @@index([tenantId, status])
  @@index([tenantId, sourceKey, receivedAt])
  @@index([tenantId, classification])
}

/// MOT SU THAT NGHIEP VU suy ra tu mot nguon.
///
/// `(tenantId, domain, key)` la DIA CHI cua su that; nhieu ban ghi cung dia chi la LICH SU, khong
/// phai trung lap. Khong bao gio UPDATE gia tri tai cho: ban cu chuyen `SUPERSEDED` va ban moi
/// tro nguoc ve no. Doc "hien tai" = ban `CONFIRMED`/`WORKING_ASSUMPTION` con trong cua so hieu
/// luc; doc "lich su" = tat ca, theo thoi gian.
model BusinessFact {
  id       String @id @default(cuid())
  tenantId String

  /// Mien nghiep vu, tu do: mot khach ban hang dung "pricing", mot khach van tai dung
  /// "reconciliation". Nen tang khong duoc biet truoc danh sach nay.
  domain String
  key    String
  /// Gia tri co cau truc. `Json` chu khong phai `String`: mot nguong so, mot bang anh xa va mot
  /// cau chinh sach deu la su that, va ep het ve chuoi se lam moi noi doc phai tu parse lai.
  value  Json

  status         BusinessFactStatus @default(PROPOSED)
  /// Ke thua tu nguon, nhung ghi lai o day: mot trich xuat co the nhay cam hon ca tai lieu goc
  /// (vd mot dong PII rut ra tu mot bang phan lon vo hai).
  classification DataClassification

  sourceId    String
  source      BusinessSource @relation(fields: [sourceId], references: [id])
  /// Tro chinh xac vao cho trong nguon (trang/muc/o) — de nguoi kiem chung khong phai doc lai ca tep.
  sourceLocus String?

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// Bon truong cua mot GIA DINH LAM VIEC — bat buoc khi `status = WORKING_ASSUMPTION`, va dieu
  /// do duoc thi hanh o `evaluateFactTransition`, khong phai o dinh nghia cot.
  assumptionRationale     String?
  assumptionRisk          String?
  assumptionReversibility String?
  assumptionOwner         String?

  supersedesId String?       @unique
  supersedes   BusinessFact? @relation("FactSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy BusinessFact? @relation("FactSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals    BusinessApproval[]
  conflicts    BusinessConflictFact[]
  /// Cac QUYET DINH da dung ban su that nay. Quan he nguoc bat buoc cua Prisma; cung la thu tra
  /// loi nguoc lai cau "ban so lieu sai nay da lam lech nhung ca nao".
  decisionRefs BusinessDecisionFactRef[]

  @@index([tenantId, domain, key, status])
  @@index([tenantId, status])
  @@index([sourceId])
}

/// MOT XUNG DOT giua nhung su that canh tranh nhau. Thuc the HANG NHAT, khong phai mot co boolean.
model BusinessConflict {
  id       String @id @default(cuid())
  tenantId String

  /// Khoa on dinh do nguoi dat, de tai lieu va runtime goi cung mot ten cho cung mot xung dot.
  conflictKey String
  domain      String
  /// Dia chi su that dang tranh chap (`BusinessFact.key`). Cho phep NULL: co xung dot ve pham vi
  /// chu khong ve mot o cu the.
  subjectKey  String?
  summary     String
  impact      BusinessConflictImpact @default(BLOCKING)
  status      BusinessConflictStatus @default(OPEN)

  /// TIN HIEU GOI Y — co ghi so, khong bao gio tu dong. `evaluateConflictResolution` khong doc
  /// hai cot nay, va `conflict-lifecycle.spec.ts` khoa dieu do lai.
  recommendedFactId    String?
  recommendationReason String?

  /// Bang chung dong xung dot. Thieu = khong dong duoc, khong co duong tat.
  resolvedFactId  String?
  resolutionActor String?
  resolutionRef   String?
  resolutionNote  String?
  resolvedAt      DateTime?

  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts BusinessConflictFact[]

  @@unique([tenantId, conflictKey])
  @@index([tenantId, status, impact])
  @@index([tenantId, domain, subjectKey])
}

/// Cac BEN cua mot xung dot. Bang noi vi mot xung dot co the co hon hai ben (van tai C-02 co ba).
model BusinessConflictFact {
  conflictId String
  conflict   BusinessConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  factId     String
  fact       BusinessFact     @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@id([conflictId, factId])
  @@index([factId])
}

/// MOT LAN PHE DUYET — bang chung roi rac, khong phai mot cot `approved: Boolean`.
///
/// Vi sao mot BANG rieng: mot co boolean tra loi duoc "da duyet chua" va khong tra loi duoc "ai
/// duyet, luc nao, dua vao dau, va o muc nao". Bon cau sau moi la thu can den luc doi chieu — va
/// `level` la thu duy nhat phan biet duoc "chung toi chap nhan ban nay" voi "khach da xac nhan".
model BusinessApproval {
  id       String @id @default(cuid())
  tenantId String

  level       ApprovalLevel
  actor       String
  /// Dan chung: so hop dong, link mail khach tra loi, bien ban hop. Bat buoc — xem `evaluateApproval`.
  evidenceRef String
  note        String?

  /// Dung mot trong hai duoc dat; ca hai NULL la mot ban ghi vo nghia.
  sourceId String?
  source   BusinessSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  factId   String?
  fact     BusinessFact?   @relation(fields: [factId], references: [id], onDelete: Cascade)

  decidedAt DateTime @default(now())

  @@index([tenantId, decidedAt])
  @@index([sourceId])
  @@index([factId])
}

/// MOT SU THAT BAT BUOC PHAI CO de mot nang luc duoc coi la san sang.
///
/// Nguyen ban cho Tenant Doctor tuong lai: `getMissingRequiredFacts()` doc chinh bang nay. Giu
/// duoi dang DU LIEU chu khong phai mot mang hang so trong code, vi cai gi bat buoc voi khach nay
/// thi khong bat buoc voi khach kia — va do dung la thu khong duoc hard-code theo ten khach.
model BusinessRequiredFact {
  id       String @id @default(cuid())
  tenantId String

  /// Nang luc bi anh huong khi thieu (khop `CapabilityId` cua goi khach).
  capability        String
  domain            String
  key               String
  /// Muc dam bao ma nang luc nay doi: co chap nhan chay tren gia dinh hay khong.
  requiresConfirmed Boolean @default(false)
  note              String?

  createdAt DateTime @default(now())

  @@unique([tenantId, capability, domain, key])
  @@index([tenantId, capability])
}

// ----- Transport domain: TX-03 Costing + Driver Fund (capability `transport-costing`) -----
//
// CANH BAO — BON DOI TUONG DB CUA T3 KHONG CO O DAY. Chung song trong SQL tho cua migration
// `20260830140000_transport_costing` vi Prisma khong co cu phap cho chung:
//
//     1. `TransportDriverFundPeriod_no_overlap`  — EXCLUDE ... USING gist, chan hai ky chong lap
//     2. `TransportDriverFundEntry_sign_by_kind` — CHECK dau theo loai but toan
//     3. `TransportTripExpense_sign_by_kind`     — CHECK dau: khoan chi duong, dong dao am
//     4. `TransportTripExpense_fund_leg`         — CHECK: chi khoan tu quy moi co dong quy sinh doi
//
// (cong hai `CHECK` khoang tien va hai `CHECK` dang ngay — dem day du o `transport-costing-storage.spec.ts`)
//
// `prisma db push` va `prisma migrate dev --create-only` deu KHONG biet nhung thu nay. Sinh lai
// migration tu schema roi ap thang len mot DB dang chay se lam chung BIEN MAT — va he thong van
// chay binh thuong, chi khong con chan gi ca. Do la kieu hong im lang nhat co the co o mot so cai.
//
// `EXCLUDE` doi extension `btree_gist`. DO DUOC tren PostgreSQL 16.15 (30/08/2026): day la mot
// TRUSTED extension, nen role `zalo` cua stack deploy — KHONG superuser, chi la CHU database — tao
// duoc no. Da chay thu bang dung hinh dang do truoc khi viet migration.

/// LOAI BUT TOAN SO QUY. Dau BAT BUOC cua tung loai song o `driver-fund-ledger.ts` va o
/// `CHECK "TransportDriverFundEntry_sign_by_kind"` — hai lop, mot quy uoc.
///
/// `REIMBURSEMENT` (+) them o `TX-07b` (Lane D / #237), va no CO Y khong phai `ADVANCE`:
/// mot lan tam ung la tien giao TRUOC cho chi tieu sap toi, con hoan ung la tien tra LAI cho mot
/// khoan lai xe da bo tui. Gop hai thu lam mot se lam moi bao cao "da tam ung bao nhieu trong ky"
/// dem ca tien hoan ung — mot con so khong con tra loi cau hoi nao.
///
/// `ADJUSTMENT` cung khong dung duoc: chu thich cua chinh no noi ro do la sua lech KIEM KE, khong
/// phai duong de chi mot nghia vu da biet.
enum TransportDriverFundEntryKind {
  ADVANCE
  RETURN
  TRIP_EXPENSE
  ADJUSTMENT
  REVERSAL
  /// `TX-07b` — cong ty tra lai lai xe khoan ho da bo tui. Dua so du AM ve gan 0 (`DA-T3-01`).
  REIMBURSEMENT
}

enum TransportTripExpenseKind {
  EXPENSE
  REVERSAL
}

enum TransportExpenseFundingSource {
  DRIVER_FUND
  COMPANY_DIRECT
}

enum TransportFundPeriodStatus {
  OPEN
  CLOSING
  CLOSED
  REOPENED
}

/// SO QUY cua mot lai xe. MOT tai khoan cho MOT lai xe (`driverId` unique).
///
/// KHONG CO COT `balance`, va do la ca noi dung cua `INV-01`: so du la KET QUA cong don but toan.
/// Mot cot so du ghi de duoc se lech voi so cai ngay lan dau co mot loi giua hai lan ghi, va tu do
/// khong con cach nao biet ben nao dung. Doc so du = `SUM("signedAmount")`.
model TransportDriverFundAccount {
  id           String          @id @default(cuid())
  driverId     String          @unique
  driver       TransportDriver @relation(fields: [driverId], references: [id])
  currencyCode String          @default("VND") @db.VarChar(3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  entries TransportDriverFundEntry[]
  periods TransportDriverFundPeriod[]
}

/// BUT TOAN SO QUY — BAT BIEN (`INV-20`). Khong co duong `UPDATE`/`DELETE` nao o tang kho.
///
/// `signedAmount` la `BigInt` = `BIGINT`, cung ly le voi `TransportTrip.freightAmount` sau T2.1/F1:
/// `INTEGER` tran o 2.147.483.647 dong, va T3 con CONG DON nhieu but toan lai nen tran som hon nua.
/// Khoang thuc te bi `CHECK` bo hep ve +-(2^53-1) cho khop `money()`.
///
/// `tripId` NULLABLE — `INV-02`, hat giong `FUND-002`: mot lan tam ung khong gan chuyen la duong
/// chay thuong ngay, khong phai ngoai le.
///
/// `correlationKey` UNIQUE lam HAI viec cung luc: chong ghi trung (gui lai cung khoa khong sinh
/// them dong), va noi hai lop cua mot su kien (`INV-03`) — but toan quy va dong gia thanh mang cung
/// mot gia tri.
///
/// `reversalOfId` UNIQUE: mot but toan chi duoc dao DUNG MOT LAN.
model TransportDriverFundEntry {
  id             String                       @id @default(cuid())
  accountId      String
  account        TransportDriverFundAccount   @relation(fields: [accountId], references: [id])
  kind           TransportDriverFundEntryKind
  signedAmount   BigInt
  currencyCode   String                       @default("VND") @db.VarChar(3)
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate   String                       @db.VarChar(10)
  tripId         String?
  trip           TransportTrip?               @relation(fields: [tripId], references: [id])
  correlationKey String                       @unique
  reversalOfId   String?                      @unique
  reversalOf     TransportDriverFundEntry?    @relation("FundEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy     TransportDriverFundEntry?    @relation("FundEntryReversal")
  note           String?
  recordedBy     String
  createdAt      DateTime                     @default(now())

  fundedExpense     TransportTripExpense?
  /// `TX-07b` — dong phan bo hoan ung ma but toan nay la chan tien mat cua no. Toi da MOT.
  cashoutAllocation TransportDriverCashoutAllocation?

  @@index([accountId, businessDate])
  @@index([tripId])
  @@index([kind])
}

/// MOT DONG GIA THANH cua mot chuyen. `tripId` BAT BUOC — `INV-02`.
///
/// `signedAmount` CO DAU: khoan chi duong, dong dao am. Gia thanh truc tiep cua chuyen = tong cot
/// nay. Neu dong dao la mot co `boolean` thay vi mot so am, moi truy van tong se phai nho loai tru
/// no — va lan quen dau tien cho ra mot chuyen dat gap doi thuc te ma khong bao loi.
///
/// `fundedBy` la mot THUOC TINH, khong phai mot bang khac (T1 §5). Hai bang se buoc moi bao cao gia
/// thanh phai UNION hai nguon, va lan quen mot ve dau tien cho ra mot chuyen re hon thuc te.
///
/// `driverFundEntryId` UNIQUE: mot but toan quy khong the la chan cua hai khoan chi.
model TransportTripExpense {
  id                String                        @id @default(cuid())
  tripId            String
  trip              TransportTrip                 @relation(fields: [tripId], references: [id])
  kind              TransportTripExpenseKind
  categoryCode      String                        @db.VarChar(60)
  signedAmount      BigInt
  currencyCode      String                        @default("VND") @db.VarChar(3)
  businessDate      String                        @db.VarChar(10)
  fundedBy          TransportExpenseFundingSource
  driverFundEntryId String?                       @unique
  driverFundEntry   TransportDriverFundEntry?     @relation(fields: [driverFundEntryId], references: [id])
  driverId          String?
  driver            TransportDriver?              @relation(fields: [driverId], references: [id])
  correlationKey    String                        @unique
  reversalOfId      String?                       @unique
  reversalOf        TransportTripExpense?         @relation("TripExpenseReversal", fields: [reversalOfId], references: [id])
  reversedBy        TransportTripExpense?         @relation("TripExpenseReversal")
  /// Tham chieu BANG CHUNG. `PG-05` (chung tu co vong doi) thuoc Platform Track va chua co; Issue
  /// #85 cho phep giu mot tham chieu nho thuoc mien thay vi chan T3, va CAM dung mot he tai lieu
  /// song song. Khi `PG-05` dong, cot nay tro thanh khoa ngoai tro toi chung tu that.
  evidenceLocator   String?
  note              String?
  recordedBy        String
  createdAt         DateTime                      @default(now())
  /// R1-C: de nghi da sinh ra khoan chi nay. Nhieu nhat MOT (unique o phia kia).
  settledClaim      TransportExpenseClaim?

  @@index([tripId, businessDate])
  @@index([driverId])
  @@index([categoryCode])
}

/// KY QUYET TOAN QUY cua MOT so quy — T1 §7.3.
///
/// KHONG chong lap voi ky khac cua cung so quy: cuong che boi EXCLUDE constraint
/// `TransportDriverFundPeriod_no_overlap` (`btree_gist` + `daterange`), khai trong SQL tho vi Prisma
/// khong co cu phap cho EXCLUDE. Kiem o service dung voi MOT nguoi ghi; constraint kia moi dung voi
/// hai nguoi ghi cung luc — dung bai hoc T2.1/F2.
///
/// `CLOSING` va `CLOSED` deu DONG BANG ky. `REOPENED` khong quay ve `OPEN` vi hai trang thai do noi
/// hai dieu khac nhau: mot ky `REOPENED` la ky DA TUNG duoc bao cao ra ngoai.
model TransportDriverFundPeriod {
  id           String                     @id @default(cuid())
  accountId    String
  account      TransportDriverFundAccount @relation(fields: [accountId], references: [id])
  /// Khoang NGAY NGHIEP VU, hai dau DEU TINH.
  startDate    String                     @db.VarChar(10)
  endDate      String                     @db.VarChar(10)
  status       TransportFundPeriodStatus  @default(OPEN)
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  snapshots TransportDriverFundPeriodSnapshot[]

  @@index([accountId, status])
  @@index([accountId, startDate])
}

/// ANH CHUP luc dong ky — APPEND-ONLY, mot hang moi lan dong.
///
/// Mot ky co the dong, mo lai, roi dong lai. Ghi de anh cu se xoa mat "con so da bao cao lan truoc"
/// — dung thu nguoi doi soat can khi ho hoi "vi sao bao cao thang truoc khac?".
///
/// Dong ky KHONG tao but toan (T1 §7.3): bang nay khong nam trong so cai, va tong cua no khong bao
/// gio duoc cong vao so du.
model TransportDriverFundPeriodSnapshot {
  id             String                    @id @default(cuid())
  periodId       String
  period         TransportDriverFundPeriod @relation(fields: [periodId], references: [id])
  /// Lan chup thu may cua ky nay, tu 1.
  sequence       Int
  openingBalance BigInt
  periodNet      BigInt
  /// `openingBalance + periodNet`. Duoc phep AM — hat giong `FUND-003`.
  closingBalance BigInt
  entryCount     Int
  currencyCode   String                    @default("VND") @db.VarChar(3)
  takenAt        DateTime                  @default(now())
  takenBy        String

  @@unique([periodId, sequence])
  @@index([periodId])
}

// ----- Transport domain: TX-04 Fuel + doi soat bang ke (capability `transport-fuel`) -----
//
// CANH BAO — CAC RANG BUOC CUA T4 KHONG CO O DAY. Chung song trong SQL tho cua migration
// `20260831120000_transport_fuel`, vi Prisma khong co cu phap cho `CHECK`:
//
//     1. `TransportFuelEntry_amount_money_range`        — khoang tien +-(2^53-1)
//     2. `TransportFuelEntry_liters_positive`           — so lit phai duong
//     3. `TransportFuelEntry_odometer_non_negative`     — odo khong am
//     4. `TransportFuelEntry_businessDate_iso`          — ngay nghiep vu dang YYYY-MM-DD
//     5. `TransportFuelEntry_consumption_needs_odo`     — co tieu hao thi phai co odo truoc
//     6. `TransportFuelEntry_review_lifecycle`          — da duyet/tu choi thi phai co nguoi va luc
//     7. `TransportFuelStatementLine_accepted_fields`   — dong nhan phai du ngay/lit/tien
//     8. `TransportFuelStatementLine_rejected_reason`   — dong tu choi phai co ly do co ten
//     9. `TransportFuelSupplierStatement_period_order`  — ngay dau ky <= ngay cuoi ky
//    10. `TransportFuelReconciliation_period_order`     — nhu tren
//    11. `TransportFuelDiscrepancy_resolved_fields`     — da quyet thi phai co nguoi quyet + luc quyet
//    12. `TransportFuelMatch_no_self_source`            — `INV-26` o TANG DB, xem duoi
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// muoi hai. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong `DROP CONSTRAINT` truoc
// khi commit — dung nhu canh bao da co o dau muc `transport-core` va `transport-costing`.
// `transport-fuel-storage.spec.ts` doc chinh tep migration va do neu mot ten bien mat.
//
// -----------------------------------------------------------------------------------------------
// VI SAO CO `TransportFuelSupplier` RIENG chu khong them mot vai vao `TransportPartnerRole`:
//
// VT-054 dan tranh viec tach MOT doi tac thanh hai ban ghi, nen phan xa dau tien la dung lai
// `TransportPartner` voi mot vai `FUEL_SUPPLIER`. T1 §9.1 lai xep nam luong cong no thanh nam so,
// va nguon cua chung KHONG dong nhat: `PARTNER_CARRIER`/`PARTNER_COMMISSION` la hai VAI cua mot
// doi tac, con `FUEL` la mot nguon RIENG. Tuc chinh T1 khong coi cay xang la mot vai cua doi tac
// van tai — va no dung: mot cay xang khong cho thue xe, khong mang don ve, va chieu cong no cua no
// dong bang MOT BANG KE thay vi mot ky doi tac.
//
// Nen o day la mot bang rieng, THUOC `transport-fuel`. Cai gia phai tra la mot khach vua ban dau
// vua chay xe se co hai ban ghi; cai duoc la enum vai cua `transport-core` khong mang mot gia tri
// chi co nghia khi mot capability KHAC duoc bat.
//
// -----------------------------------------------------------------------------------------------
// HAI TRUC TRANG THAI DOC LAP (T1 §7.4) — `verificationStatus` va `reconciliationStatus`:
//
// Gop lam mot truc se buoc phai cho toi cuoi thang (luc co bang ke) moi duyet duoc mot phieu — mat
// dung gia tri "doi chieu noi bo theo thoi gian thuc" ma VT-042 doi. Hai cot, hai cau hoi, hai
// thoi diem dong.

/// Truc MOT: ke toan da tin so lieu tren phieu nay chua (VT-042).
enum TransportFuelVerificationStatus {
  DECLARED
  VERIFIED
  REJECTED
}

/// Truc HAI: phieu/dong bang ke nay da doi chieu duoc chua (VT-045).
///
/// MOT enum dung cho CA phieu lai xe LAN dong bang ke. Hai enum song song se troi khoi nhau ngay
/// lan dau ai do them mot gia tri cho mot ve — va bang doi soat doc hai cot bang hai tu vung khac
/// nhau la thu khong ai doc duoc.
enum TransportFuelReconciliationStatus {
  UNMATCHED
  MATCHED
  MISMATCHED
  /// Da nam trong mot ky doi soat DA DONG — khoa (`GD-11`).
  SETTLED
  /// Co nguoi quyet bo qua, kem ly do. Khong bao gio la mac dinh.
  IGNORED
}

/// AI TRA TIEN cho lan do dau nay — quyet dinh khoan chi di vao gia thanh chuyen bang nguon nao.
///
/// Khong suy duoc tu thu gi khac: cung mot cay xang, cung mot xe, lai xe co the tra tien mat tu
/// quy HOAC ky so no de cuoi thang cong ty tra theo bang ke. Doan sai chieu nay lam so quy lai xe
/// lech dung bang so tien do, va `INV-23` (mot khoan tien o dung mot cho) bi pha ngay tu lan ghi.
enum TransportFuelPaymentMethod {
  /// Lai xe tra tien mat -> `TripExpense(fundedBy = DRIVER_FUND)` + mot but toan quy am.
  DRIVER_CASH
  /// Ky so no cay xang -> `TripExpense(fundedBy = COMPANY_DIRECT)`. Cong no di duong bang ke.
  SUPPLIER_ACCOUNT
}

/// VI SAO mot phieu bi danh dau CAN KIEM TRA. Nhieu ly do cung luc la binh thuong.
///
/// Mot MANG enum chu khong mot co `boolean`: `INV-06` doi "danh dau can kiem tra" khi khong tinh
/// duoc tieu hao, va VT-046 doi canh bao khi vuot dinh muc. Hai viec khac han nhau, va mot co
/// chung se lam nguoi truc phai mo tung phieu ra doan xem cai nao.
enum TransportFuelReviewReason {
  /// `INV-06` — odo hien tai <= odo lan truoc. KHONG chia, khong bia ra mot con so.
  ODOMETER_NOT_ADVANCED
  /// Xe chua co lan do dau nao truoc do — khong co mau so, khong phai mot loi.
  NO_PREVIOUS_ODOMETER
  /// VT-046 — tieu hao vuot dinh muc cua hang xe cong dung sai cua goi khach.
  CONSUMPTION_ABOVE_NORM
}

enum TransportFuelStatementFormat {
  CSV
  XLSX
}

/// Ket qua KIEM TUNG DONG luc nhap bang ke. Khong co gia tri thu ba: hoac nhan, hoac tu choi.
enum TransportFuelStatementLineStatus {
  ACCEPTED
  REJECTED
}

/// VI SAO mot dong bang ke bi tu choi. "Khong doan ngam" nghia la moi duong tu choi co mot ten.
enum TransportFuelStatementRejectReason {
  MISSING_REQUIRED_FIELD
  MALFORMED_DATE
  MALFORMED_AMOUNT
  MALFORMED_LITERS
  /// Bien so khong khop xe nao dang co — KHONG tu tao xe moi tu mot file nhap.
  UNKNOWN_VEHICLE
  /// Trung nguyen ven mot dong khac trong cung file.
  DUPLICATE_ROW
}

/// Nguon cua mot cap khop: may tu khop theo dung sai, hay nguoi quyet.
enum TransportFuelMatchOrigin {
  AUTO
  MANUAL
}

/// LOAI chenh lech. Moi loai mot duong xu ly khac nhau, nen khong gop.
enum TransportFuelDiscrepancyKind {
  /// `GD-09` — mot dong khop duoc voi NHIEU phieu (hoac nguoc lai). KHONG tu chon cap nao.
  AMBIGUOUS_CANDIDATES
  /// `FUEL-RECON-002` — dong bang ke khong co phieu lai xe tuong ung.
  STATEMENT_LINE_ONLY
  /// Phieu lai xe khong thay tren bang ke ky nay.
  FUEL_ENTRY_ONLY
  /// Co ung vien duy nhat nhung lech tien/ngay vuot dung sai.
  OUT_OF_TOLERANCE
  /// `INV-26` — ung vien duy nhat lai chinh la phieu duoc nhap ra tu bang ke nay.
  SELF_SOURCED_BLOCKED
}

enum TransportFuelDiscrepancyStatus {
  PENDING
  RESOLVED
}

/// NGUOI quyet gi ve mot chenh lech. Danh sach dong — khong co duong "quyet tu do".
///
/// `INV-07`/`INV-27`: KHONG gia tri nao o day sinh ra mot khoan no cua lai xe hay mot khoan tru
/// luong. Duy nhat `ACCEPT_SUPPLIER_AMOUNT` cho phep so tien di tiep sang ban giao cong no T5.
enum TransportFuelDiscrepancyResolution {
  /// Cong ty chap nhan so cua cay xang — so tien nay VAO ban giao T5.
  ACCEPT_SUPPLIER_AMOUNT
  /// Khong chap nhan dong bang ke; se lam viec lai voi cay xang. KHONG vao ban giao.
  REJECT_SUPPLIER_LINE
  /// Nguoi xac nhan mot cap trong so cac ung vien nhap nhang (`GD-09`).
  MATCH_CONFIRMED
  /// Bo qua co ly do — dong/phieu khong thuoc ky nay.
  IGNORE_WITH_REASON
  /// Phieu lai xe sai; duong dung la dao/sua phieu roi chay lai so khop.
  ENTRY_CORRECTION_REQUIRED
}

/// May trang thai doi soat — T1 §7.5 + duong mo lai cua `GD-11`.
enum TransportFuelReconciliationState {
  DRAFT
  MATCHING
  RESOLVED
  CLOSED
  /// Da mo lai boi nguoi co quyen rieng. Khong quay ve `DRAFT`: ky nay DA TUNG duoc bao cao.
  REOPENED
}

/// NGUON du lieu do dau ma MOT nha cung cap that su gui ve. Mot nha cung cap co the gui CA HAI.
///
/// KHONG phai mot cot loai: `Q-08` (R0 §7) chua co loi — chua ai biet B mua dau qua hop dong cay
/// xang hay qua the/app, va hoa don dien tu dang gui ve dau. Mot cot mot gia tri se buoc phai doan
/// dieu do ngay hom nay. Mot MANG thi khong: chua khai gi la mang rong, va khai them mot nguon ve
/// sau khong phai mot lan di tru.
///
/// `EINVOICE` co mat vi ND 70/2025/ND-CP (hieu luc 01/06/2025) buoc MOI cua hang ban le xang dau
/// phat hoa don dien tu TUNG LAN BAN, ke ca cho khach le tra tien mat. Tuc du lieu do dau khong
/// con ket tren giay — no ton tai duoi dang co cau truc, phat tai diem ban.
enum TransportFuelIngestChannel {
  /// Bang ke ky (CSV/XLSX) — duong da co tu T4, `FuelStatementSource`.
  STATEMENT_FILE
  /// Hoa don dien tu tung lan ban — duong uu tien theo R0 §3.5 (`F-10`).
  EINVOICE
}

/// CAY XANG / nha cung cap nhien lieu. Xem khoi canh bao dau muc ve vi sao khong dung vai doi tac.
///
/// ---------------------------------------------------------------------------
/// SIEU DU LIEU HOP DONG (`contract*`, `paymentTermDays`, `termsNote`) KHONG DIEU KHIEN MOT DONG
/// TIEN NAO.
///
/// Chung o day de nguoi doi soat DOC, va chi vay. `Q-08` chua co loi, nen mot luat kieu "qua han
/// `paymentTermDays` thi tu sinh cong no" se la mot chinh sach KHONG AI QUYET duoc cai vao base
/// roi moi khach van tai sau deu thua huong. `fuel-station.service.spec.ts` khoa dieu do lai.
model TransportFuelSupplier {
  id                String                       @id @default(cuid())
  name              String
  /// Ma noi bo cua khach (so hop dong, ma cay xang tren bang ke). Duy nhat khi co.
  code              String?                      @unique
  phone             String?
  address           String?
  taxCode           String?
  status            TransportPartyStatus         @default(ACTIVE)
  /// Nguoi phu trach ben cay xang — de goi khi mot dong bang ke khong khop.
  contactName       String?
  contactEmail      String?
  contractNo        String?
  /// `YYYY-MM-DD`. Sieu du lieu doc, khong phai mot cong chan chung tu ngoai ky.
  contractStartDate String?                      @db.VarChar(10)
  contractEndDate   String?                      @db.VarChar(10)
  /// So ngay cong no theo hop dong. Xem khoi tren: KHONG duong tinh tien nao doc cot nay.
  paymentTermDays   Int?
  termsNote         String?
  ingestChannels    TransportFuelIngestChannel[]
  /// Ma tai khoan/hop dong ma HE THONG CUA NHA CUNG CAP dung — de dinh tuyen chung tu ve dung ho.
  ingestAccountRef  String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  entries         TransportFuelEntry[]
  statements      TransportFuelSupplierStatement[]
  reconciliations TransportFuelReconciliation[]
  stations        TransportFuelStation[]
  documents       TransportFuelDocument[]

  @@index([status])
}

/// MOT CAY XANG CU THE — mot dia diem, khong phai mot phap nhan.
///
/// ===========================================================================
/// VI SAO KHONG GOP VAO `TransportFuelSupplier`
///
/// Mot nha cung cap co hang tram cua hang. Cai ma bao cao can tra loi — *"tram nao ban thieu lit"*,
/// *"xe nay do o dau"*, *"phieu nay co the do o day khong"* — deu la cau hoi ve DIA DIEM, khong
/// phai ve phap nhan. Nhet dia chi vao mot cot `address` cua nha cung cap se lam moi cau hoi do
/// khong tra loi duoc, va khong lan sua nao ve sau lam no de hon.
///
/// ===========================================================================
/// TOA DO LA SO NGUYEN TY LE 1e-7 DO — KHONG `Float`, KHONG PostGIS
///
/// R0 §3.1 do va ket luan: PostGIS la lua chon dung KHI CO du lieu de luu, va hom nay chua co mot
/// diem toa do nao — `F-11` chan viec luu vet vi tri NGUOI LAO DONG. Toa do cua mot CAY XANG thi
/// khong phai du lieu ca nhan, nhung no cung khong dang mot lan doi image Postgres.
///
/// `Int` ty le 1e-7 (`latitudeE7`) la quy uoc san co cua Android Location: 1e-7 do ~ 1,1 cm, va
/// 180 * 1e7 = 1,8e9 nam gon trong `INTEGER` 32-bit. Loi cua no so voi `Float`: hai lan doc cho ra
/// DUNG mot con so, nen mot phep so khoang cach chay hai lan khong lech o chu so cuoi.
///
/// `geofenceRadiusM` la MOC HOP LY, khong phai mot cong chan: `INV-07`/`INV-27` cam moi duong tu
/// dong sinh no cho lai xe, nen mot phieu do ngoai ban kinh chi tro thanh mot co cho nguoi xem.
model TransportFuelStation {
  id              String                @id @default(cuid())
  supplierId      String
  supplier        TransportFuelSupplier @relation(fields: [supplierId], references: [id])
  name            String
  /// TEN da chuan hoa — khoa so khop theo ten. KHONG unique: cac chuoi ban le danh so cua hang
  /// theo tung vung, nen hai tram cung ten trong mot chuoi la chuyen co that. Lan trung ten ra
  /// `AMBIGUOUS` va nguoi dat mot bi danh phan biet — do la ly do `TransportFuelStationAlias` co.
  nameNormalized  String
  /// Ma cua hang tren chung tu cua CHINH nha cung cap.
  code            String?
  /// `code` da chuan hoa — cot mang khoa unique. Xem `normalizeStationCode()`.
  codeNormalized  String?
  address         String?
  latitudeE7      Int?
  longitudeE7     Int?
  geofenceRadiusM Int?
  status          TransportPartyStatus  @default(ACTIVE)
  note            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  aliases    TransportFuelStationAlias[]
  candidates TransportFuelCandidate[]

  /// Ma cua hang duy nhat TRONG mot nha cung cap — khong phai toan cuc. Hai chuoi khac nhau deu
  /// co the co mot `CH-05`, va ep no duy nhat toan cuc se chan mot du lieu that.
  @@unique([supplierId, codeNormalized])
  @@index([supplierId, status])
  /// HAI CHI SO MOT COT, cho duong doc nong nhat: "chung tu viet chuoi nay, tram nao khop".
  ///
  /// Khoa unique o tren KHONG phuc vu duoc cau hoi do: `codeNormalized` la cot THU HAI cua no, va
  /// Postgres chi dung duoc tien to trai cua mot chi so nhieu cot. Thieu hai chi so nay, moi lan
  /// nhan dang mot chung tu se quet ca bang tram — thu chi lo ra khi khach co mot chuoi ban le
  /// that, tuc rat muon.
  @@index([codeNormalized])
  @@index([nameNormalized])
}

/// BI DANH cua mot cay xang — duong DUY NHAT de mot NGUOI day mot chuoi chu vao dung mot tram.
///
/// Ton tai vi nguon du lieu yeu: mot to phieu nhiet chi in `CHXD SO 5 KM12`, mot bang ke viet
/// `Cua hang 5 (Km 12)`. Khong phep so gan dung nao duoc phep noi hai chuoi do la mot — nhung mot
/// NGUOI thi noi duoc, va bang nay la cho ho ghi lai lan quyet do de khong phai quyet lai.
///
/// `normalized` UNIQUE TOAN CUC, khong theo nha cung cap: mot bi danh tro toi hai tram khong tra
/// loi duoc gi ca. Khi hai tram cung muon mot bi danh, he thong TU CHOI va nguoi dat phai lam no
/// cu the hon — do la ket cuc dung, vi chinh su mo ho la thu bi danh sinh ra de xoa.
model TransportFuelStationAlias {
  id         String               @id @default(cuid())
  stationId  String
  station    TransportFuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  /// Khoa so khop. Xem `normalizeStationLabel()` — bo dau, chu hoa, gom khoang trang.
  normalized String               @unique
  /// Nguyen ban nguoi nhap, de doc lai khi ai do nghi phep chuan hoa dang doc sai.
  raw        String
  createdBy  String
  createdAt  DateTime             @default(now())

  @@index([stationId])
}

/// DINH DANG cua mot chung tu nguon nhien lieu — mot enum ve DINH DANG, khong ve nha cung cap.
///
/// MOT gia tri hom nay, va do la mot con so trung thuc chu khong mot thieu sot: duong duy nhat da
/// hien thuc la hoa don dien tu XML (C2). Gia tri ke tiep se la `RECEIPT_IMAGE` khi C3 mo duong
/// trich xuat tu anh — mot `ALTER TYPE ... ADD VALUE`, tuc cong them va re.
enum TransportFuelDocumentKind {
  EINVOICE_XML
  /// Mot BUC ANH phieu do dau, doc bang mot bo trich xuat (C3). Ung vien sinh ra tu day LUON mang
  /// mot bang muc tin — xem `TransportFuelCandidate.confidence`.
  RECEIPT_IMAGE
}

/// BA ket cuc cua mot lan nhap. Khong co gia tri thu tu.
enum TransportFuelDocumentStatus {
  PARSED
  REJECTED
  /// Doc ra duoc, nhung hoa don nay DA vao he thong tu mot tep khac. Xem `INV-C2-DUP` ben duoi.
  DUPLICATE
}

/// VI SAO mot chung tu khong nhap duoc. Moi duong mot ten — khong co ma "loi khac".
enum TransportFuelDocumentRejectReason {
  EMPTY
  TOO_LARGE
  MALFORMED_XML
  /// Tep DUNG DANG nhung tham chieu thuc the NGOAI. Mot tep doc hai, khong phai mot tep hong.
  EXTERNAL_ENTITY_REJECTED
  NOT_AN_INVOICE
  MISSING_INVOICE_IDENTITY
  NO_LINE_ITEMS
  /// Byte dau tep khong phai mot anh JPEG/PNG/WebP — hoac loi khai cua nguoi goi lech voi byte.
  UNSUPPORTED_MEDIA_TYPE
  /// Bo trich xuat khong tra loi (mang, qua han, dich vu tu choi). Nhap lai duoc.
  EXTRACTION_UNAVAILABLE
  /// Bo trich xuat co tra loi nhung khong dung khuon. Nhap lai KHONG chac giup — bao nguoi dung he thong.
  EXTRACTION_MALFORMED_OUTPUT
}

/// Ket cuc cua phep nhan dang cay xang — NAM gia tri, y het `resolveFuelStation()`.
enum TransportFuelStationMatch {
  RESOLVED
  AMBIGUOUS
  SUPPLIER_MISMATCH
  NO_MATCH
  NO_INPUT
}

/// NOI mot GOI Y duoc doc ra. Goi y khong bao gio la su that — xem khoi ve bien so ben duoi.
enum TransportFuelHintSource {
  /// `TTKhac` — truong mo rong tu dat ten cua hoa don.
  EXTENSION_FIELD
  /// Ten nguoi mua (`NMua/Ten`) — tren hoa don ban le tung lan, mot so may tinh tien go bien
  /// so vao day. Chi nhan khi CA CHUOI la mot bien so; quet tim chuoi con se la doan.
  BUYER_NAME
}

/// MOT CHUNG TU NGUON da nhap — mot tep, mot lan nhap, mot dau van tay noi dung.
///
/// ===========================================================================
/// `INV-C2-DUP` — CHONG NHAP TRUNG O HAI TANG, VA HAI TANG DO CHAN HAI KIEU HONG KHAC NHAU
///
///   · `contentDigest` UNIQUE  — chan mot lan nhap LAP DUNG MOT TEP (ai do chuyen tiep email hai
///     lan). Nhan ra bang byte, nen no dung ke ca khi noi dung khong doc duoc.
///
///   · `(sellerTaxCode, invoiceSymbol, invoiceNo, lineNumber)` UNIQUE tren bang ung vien — chan
///     CUNG MOT HOA DON den bang HAI TEP KHAC NHAU (ban XML goc va mot ban ky lai). Dau van tay
///     byte khong nhan ra duoc dieu do.
///
/// Bo lop nao cung de lai mot duong dem hai lan tien dau. Va vi khoa thu hai gom cac cot NOT NULL,
/// no co hieu luc THAT — day la ly do `MISSING_INVOICE_IDENTITY` tu choi ca chung tu thay vi nhap
/// no voi cac o rong (Postgres coi hai `NULL` la khac nhau, nen mot khoa co `NULL` khong chan gi).
///
/// ===========================================================================
/// CHUNG TU BI TU CHOI VAN DUOC LUU, va do la ca noi dung cua "khong doan ngam".
///
/// Neu mot tep hong bi bo di khong dau vet, nguoi doi soat thay mot thang thieu chung tu ma khong
/// biet thieu bao nhieu — con so ma mot bo loc im lang lay mat cua ho.
model TransportFuelDocument {
  id               String                             @id @default(cuid())
  kind             TransportFuelDocumentKind
  /// Ten tep / ma thu — de nguoi doi soat tim lai ban goc. KHONG phai duong dan he thong tep.
  sourceRef        String
  /// SHA-256 cua BYTE GOC.
  contentDigest    String                             @unique @db.VarChar(64)
  byteSize         Int
  /// MST nguoi ban DOC DUOC tu chung tu — giu nguyen ke ca khi khong khop nha cung cap nao.
  sellerTaxCodeRaw String?
  /// Nha cung cap nhan ra tu MST. `null` = chua co ai trong danh muc mang ma so thue do.
  supplierId       String?
  supplier         TransportFuelSupplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status           TransportFuelDocumentStatus
  rejectReason     TransportFuelDocumentRejectReason?
  /// Chung tu DA NHAP truoc do mang cung hoa don nay. Chi co gia tri khi `status = DUPLICATE`.
  duplicateOfId    String?
  duplicateOf      TransportFuelDocument?             @relation("TransportFuelDocumentDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates       TransportFuelDocument[]            @relation("TransportFuelDocumentDuplicate")
  candidateCount   Int                                @default(0)
  receivedAt       DateTime                           @default(now())
  receivedBy       String

  candidates TransportFuelCandidate[]

  @@index([supplierId, receivedAt])
  @@index([status, receivedAt])
}

/// MOT UNG VIEN — mot dong hang cua mot chung tu, DA CHUAN HOA nhung CHUA AI XAC NHAN.
///
/// ===========================================================================
/// BANG NAY KHONG PHAI `TransportFuelEntry`, VA DO LA CA THIET KE.
///
/// "Doc ra duoc" khong phai "da la su that tai chinh". Mot ung vien khong co chan gia thanh, khong
/// vao doi soat, khong vao ban giao cong no — khong duong tinh tien nao cua T3/T4/T5 doc bang nay
/// (`INV-C2-NOMONEY`, co mot bai test doc ma nguon de khoa dieu do). Duong tu ung vien sang mot
/// phieu that phai di qua MOT NGUOI, va duong do thuoc mot tranche sau.
///
/// ===========================================================================
/// BIEN SO VA ODO LA GOI Y, KHONG PHAI DU LIEU
///
/// ND 123/2020 Dieu 10 khong co truong bien so trong noi dung BAT BUOC cua hoa don dien tu, va
/// ND 70/2025 khong them truong do. Nen khi mot bien so xuat hien tren hoa don, no nam trong mot
/// truong mo rong TU DAT TEN (`TTKhac`) hoac lan trong ten nguoi mua — hai cho ma khong quy dinh
/// nao rang buoc. `plateHintRaw` co hau to `Hint` de moi nguoi doc code deu thay dieu do, va
/// `plateHintSource` ghi lai NOI no duoc doc ra de nguoi kiem lai duoc.
///
/// He qua thang: mot ung vien KHONG BAO GIO tu tro thanh phieu dau duoc, vi
/// `TransportFuelEntry.vehicleId` la `NOT NULL` va hoa don khong noi duoc xe nao.
model TransportFuelCandidate {
  id         String                @id @default(cuid())
  documentId String
  document   TransportFuelDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Dem tu 1 theo THU TU XUAT HIEN trong chung tu — khong theo `STT`, von co the trung hoac thieu.
  lineNumber Int

  /**
   * --- danh tinh chung tu thue: ba cot duoi la KHOA CHONG TRUNG, nen deu NOT NULL ---
   */
  sellerTaxCode   String
  invoiceSymbol   String
  invoiceNo       String
  /// `KHMSHDon`. NGOAI khoa chong trung: trong moi he thong that, `(MST, KHHDon, SHDon)` da duy nhat.
  invoiceTemplate String?
  sellerName      String?

  /**
   * --- cay xang ---
   */
  stationLabelRaw String?
  stationId       String?
  station         TransportFuelStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  stationMatch    TransportFuelStationMatch

  /**
   * --- so lieu. DON VI theo dung quy uoc cua `fuel.types.ts` ---
   */
  /// `YYYY-MM-DD` doc tu `NLap`. NULL khi khong doc duoc — khong bao gio bia mot ngay.
  issuedDate    String?  @db.VarChar(10)
  /// Phan GIO nguyen ban cua `NLap`. KHONG doi thanh khoanh khac: `NLap` khong mang mui gio.
  issuedTimeRaw String?
  /// SO LIT — `Decimal(12,3)`, cung kieu voi `TransportFuelEntry.liters`.
  liters        Decimal? @db.Decimal(12, 3)
  /// DON GIA moi lit — `Decimal(12,3)`. Ty le 3 de `so lit x don gia = thanh tien` khop CHINH XAC.
  unitPrice     Decimal? @db.Decimal(12, 3)
  /// SO NGUYEN DONG. VND khong co don vi phu (`GD-03`).
  amount        BigInt?
  currencyCode  String   @default("VND") @db.VarChar(3)
  itemName      String?
  /// `DVTinh` nguyen ban. GIU LAI ke ca khi khong phai `Lit` — loc o tang doc se la doan.
  unitRaw       String?

  /**
   * --- goi y, KHONG phai su that ---
   */
  plateHintRaw    String?
  plateHintSource TransportFuelHintSource?
  odometerHintKm  Int?

  /// XUAT XU tung truong: `ten truong -> { path, raw, unreadable? }`. Xem `fuel-einvoice-parse.ts`.
  provenance Json
  /// MUC TIN theo tung truong, cung bo khoa voi `provenance`. `NULL` = ung vien den tu mot nguon
  /// TAT DINH (hoa don XML), noi ma khai niem "muc tin" khong ap dung.
  confidence Json?
  createdAt  DateTime @default(now())

  @@unique([documentId, lineNumber])
  /// `INV-C2-DUP` lop hai — bon cot deu NOT NULL nen khoa nay co hieu luc THAT.
  @@unique([sellerTaxCode, invoiceSymbol, invoiceNo, lineNumber])
  @@index([stationId])
  @@index([issuedDate])
}

/// PHIEU DO DAU — aggregate root cua `TX-04`, giu hai truc trang thai doc lap (T1 §7.4).
///
/// `tripId` BAT BUOC: mot lan do dau khong gan chuyen thi khong vao duoc gia thanh chuyen nao, va
/// ca `TX-04` ton tai de lam dung viec do (VT-034, VT-040). Day la cho khac `DriverFundEntry`, noi
/// `tripId` nullable vi mot lan tam ung khong gan chuyen la chuyen thuong ngay (`INV-02`).
///
/// `sourceStatementId` la SOI DAY CUA `INV-26`. Mot phieu co the duoc SINH RA tu chinh bang ke
/// (duong "cay xang ban gi thi ta ghi nay", dung khi lai xe quen nhap). Neu doi soat cho phep dong
/// bang ke khop voi phieu duoc de ra tu chinh no, he thong LUON bao khop 100% va toan bo gia tri
/// chong that thoat bien mat. Cot nay + `CHECK TransportFuelMatch_no_self_source` chan dieu do o
/// TANG DB, khong chi o tang mien.
///
/// `costExpenseId` UNIQUE la cach "chi phi dau vao gia thanh chuyen DUNG MOT LAN" duoc giu bang
/// CAU TRUC: mot khoan chi cua `TX-03` khong the la chan gia thanh cua hai phieu dau.
model TransportFuelEntry {
  id                   String                            @id @default(cuid())
  tripId               String
  trip                 TransportTrip                     @relation(fields: [tripId], references: [id])
  vehicleId            String
  vehicle              TransportVehicle                  @relation(fields: [vehicleId], references: [id])
  driverId             String
  driver               TransportDriver                   @relation(fields: [driverId], references: [id])
  supplierId           String
  supplier             TransportFuelSupplier             @relation(fields: [supplierId], references: [id])
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate         String                            @db.VarChar(10)
  /// KHOANH KHAC tren phieu (bang chung gio do dau). Ngay nghiep vu KHONG suy tu cot nay.
  occurredAt           DateTime
  /// SO LIT — `Decimal(12,3)`, KHONG bao gio `Float`. Mien doc/ghi qua chuoi, xem `fuel-quantity.ts`.
  liters               Decimal                           @db.Decimal(12, 3)
  /// SO NGUYEN DONG. `BigInt` cung ly le voi `TransportTrip.freightAmount` (T2.1/F1).
  amount               BigInt
  currencyCode         String                            @default("VND") @db.VarChar(3)
  odometerKm           Int
  /// Odo cua lan do dau TRUOC cua chinh xe nay, CHUP LAI luc ghi. NULL = chua co lan nao truoc.
  previousOdometerKm   Int?
  /// L/100km, `Decimal(10,3)`. NULL khi mau so <= 0 — `INV-06` cam bia mot con so ra.
  consumptionL100km    Decimal?                          @db.Decimal(10, 3)
  reviewReasons        TransportFuelReviewReason[]
  paymentMethod        TransportFuelPaymentMethod
  verificationStatus   TransportFuelVerificationStatus   @default(DECLARED)
  reconciliationStatus TransportFuelReconciliationStatus @default(UNMATCHED)
  /// `INV-26` — bang ke da de ra phieu nay. NULL o moi phieu do lai xe khai.
  sourceStatementId    String?
  sourceStatement      TransportFuelSupplierStatement?   @relation(fields: [sourceStatementId], references: [id])
  /// Chan gia thanh o `TX-03`. UNIQUE: mot khoan chi khong the thuoc hai phieu dau.
  costExpenseId        String?                           @unique
  /// Khoa chong ghi trung cua duong nop phieu.
  correlationKey       String                            @unique
  invoiceNo            String?
  note                 String?
  /// AI khai phieu nay — danh tinh do may chu dung len, xem `transport-actor.ts`.
  declaredBy           String
  verifiedAt           DateTime?
  verifiedBy           String?
  rejectedAt           DateTime?
  rejectedBy           String?
  reviewNote           String?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  evidence      TransportFuelReceiptEvidence[]
  match         TransportFuelMatch?
  discrepancies TransportFuelDiscrepancy[]

  @@index([tripId])
  @@index([vehicleId, businessDate])
  @@index([driverId])
  @@index([supplierId, businessDate])
  @@index([verificationStatus])
  @@index([reconciliationStatus])
  @@index([sourceStatementId])
  /// HOP THU PHIEU NHIEN LIEU cua ca doi — #222 P1-B.
  ///
  /// Thu tu doc cua hop thu la `(verificationStatus ASC, businessDate DESC)`: `DECLARED` la gia
  /// tri DAU TIEN cua enum Postgres o tren, nen phieu DANG CHO XAC THUC len truoc, moi nhat truoc
  /// trong tung nhom. Chi so mot cot `verificationStatus` da co khong phuc vu duoc phan sap xep
  /// theo ngay, va man Nhien lieu la mot man mo hang ngay.
  @@index([verificationStatus, businessDate])
}

/// ANH CHUNG TU cua mot phieu dau — `PG-05` chua co, nen day la THAM CHIEU co vong doi TOI THIEU.
///
/// Mot BANG CON chu khong mot cot `evidenceLocator` nhu `TripExpense`: nguon (VT-042) noi ve "anh
/// phieu" so nhieu — mot lan do dau co the co anh phieu, anh dong ho odo va anh hoa don. Nhet
/// chung vao mot cot se dan toi mot chuoi phan cach bang dau phay, va cai do khong phai mot mo
/// hinh du lieu.
///
/// `GD-20` — demo GIU VO THOI HAN: khong cot retention, khong job don. Xoa nham bang chung dat hon
/// giu thua, va chua co chinh sach nao de ma hien thuc.
model TransportFuelReceiptEvidence {
  id          String             @id @default(cuid())
  fuelEntryId String
  fuelEntry   TransportFuelEntry @relation(fields: [fuelEntryId], references: [id], onDelete: Cascade)
  /// Dinh vi trong kho anh (`MediaStore`). Khi `PG-05` dong, cot nay thanh khoa ngoai tro chung tu.
  locator     String
  contentType String?
  byteSize    Int?
  capturedAt  DateTime?
  uploadedBy  String
  createdAt   DateTime           @default(now())
  /// BIA MO, khong phai mot lan xoa hang — #222 P1-C.
  ///
  /// Lai xe tai nham mot tep thi phai go duoc no, nhung mot chung tu tai chinh KHONG duoc bien mat
  /// khong dau vet. Nen duong "go" ghi hai cot nay roi moi don byte o kho anh; hang van o lai, va
  /// `listEvidence` loc no ra khoi danh sach dang hieu luc.
  ///
  /// Vi sao tombstone TRUOC roi purge SAU, khong nguoc lai: neu xoa metadata truoc va lenh xoa
  /// object hong, ta mat CA duong tim lai object mo coi LAN dau vet cua nguoi go. Theo thu tu nay,
  /// truong hop xau nhat chi de lai mot object khong con ai tro toi — va `locator` van con o hang
  /// da bia mo de don ve sau.
  withdrawnAt DateTime?
  /// AI go — danh tinh do may chu dung len (`transport-actor.ts`), khong tu than yeu cau.
  withdrawnBy String?

  @@index([fuelEntryId])
  /// Duong doc thuong xuyen nhat sau lan sua nay: "cac bang chung CON HIEU LUC cua mot phieu".
  @@index([fuelEntryId, withdrawnAt])
}

/// BANG KE CAY XANG — MOT bang ke duy nhat cho mot `(cay xang, ky)` (T1 §5).
///
/// Unique `(supplierId, periodStart, periodEnd)`: nhap lai cung mot ky la mot VA CHAM on ao, khong
/// phai mot lan ghi de. Ghi de se lam bien mat cac dong da khop va cac chenh lech da co nguoi quyet.
model TransportFuelSupplierStatement {
  id            String                       @id @default(cuid())
  supplierId    String
  supplier      TransportFuelSupplier        @relation(fields: [supplierId], references: [id])
  /// Khoang NGAY NGHIEP VU, hai dau DEU TINH.
  periodStart   String                       @db.VarChar(10)
  periodEnd     String                       @db.VarChar(10)
  format        TransportFuelStatementFormat
  /// Ten file nguon — de nguoi doi soat tim lai ban giay. Khong phai mot duong dan he thong tep.
  sourceRef     String
  /// Bam noi dung file. Hai lan nhap cung mot file vao hai ky khac nhau van doc ra duoc.
  sourceDigest  String                       @db.VarChar(64)
  rowCount      Int
  acceptedCount Int
  rejectedCount Int
  importedAt    DateTime                     @default(now())
  importedBy    String

  lines          TransportFuelStatementLine[]
  reconciliation TransportFuelReconciliation?
  /// `INV-26` — cac phieu duoc de ra TU bang ke nay.
  derivedEntries TransportFuelEntry[]

  @@unique([supplierId, periodStart, periodEnd])
  @@index([supplierId])
}

/// MOT DONG cua bang ke. Dong bi TU CHOI van duoc LUU — do la ca noi dung cua "khong doan ngam".
///
/// Neu dong hong bi bo di luc nhap thi nguoi doi soat nhin thay mot bang ke thieu dong ma khong
/// biet thieu bao nhieu, va so tong cua ho se khong bao gio khop voi ban giay.
model TransportFuelStatementLine {
  id                   String                              @id @default(cuid())
  statementId          String
  statement            TransportFuelSupplierStatement      @relation(fields: [statementId], references: [id], onDelete: Cascade)
  /// So dong TRONG FILE, tu 1 — de nguoi doi soat mo file ra tim dung dong.
  rowNumber            Int
  status               TransportFuelStatementLineStatus
  rejectReason         TransportFuelStatementRejectReason?
  /// Bien so DOC DUOC TU FILE, giu nguyen ke ca khi khong khop xe nao.
  vehiclePlateRaw      String
  vehicleId            String?
  vehicle              TransportVehicle?                   @relation(fields: [vehicleId], references: [id])
  /// NULL o dong bi tu choi vi ngay hong — khong dat mot ngay bia vao cho do.
  businessDate         String?                             @db.VarChar(10)
  liters               Decimal?                            @db.Decimal(12, 3)
  amount               BigInt?
  currencyCode         String                              @default("VND") @db.VarChar(3)
  invoiceNo            String?
  note                 String?
  /// Dong nguyen ban, de doi chieu khi ai do nghi bo anh xa cot dang doc sai file.
  rawValues            Json
  reconciliationStatus TransportFuelReconciliationStatus   @default(UNMATCHED)
  createdAt            DateTime                            @default(now())

  match         TransportFuelMatch?
  discrepancies TransportFuelDiscrepancy[]

  @@unique([statementId, rowNumber])
  @@index([statementId, status])
  @@index([vehicleId, businessDate])
}

/// KY DOI SOAT mot bang ke — T1 §7.5. MOT doi soat cho MOT bang ke.
model TransportFuelReconciliation {
  id            String                           @id @default(cuid())
  supplierId    String
  supplier      TransportFuelSupplier            @relation(fields: [supplierId], references: [id])
  statementId   String                           @unique
  statement     TransportFuelSupplierStatement   @relation(fields: [statementId], references: [id])
  periodStart   String                           @db.VarChar(10)
  periodEnd     String                           @db.VarChar(10)
  state         TransportFuelReconciliationState @default(DRAFT)
  /// Lan chay so khop gan nhat — de biet bang doi soat dang cu hay moi.
  lastMatchedAt DateTime?
  closedAt      DateTime?
  closedBy      String?
  reopenedAt    DateTime?
  reopenedBy    String?
  reopenReason  String?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt

  matches       TransportFuelMatch[]
  discrepancies TransportFuelDiscrepancy[]
  handoffs      TransportFuelSettlementHandoff[]

  @@index([supplierId, state])
}

/// MOT CAP DA KHOP — mot dong bang ke voi mot phieu lai xe.
///
/// UNIQUE o CA HAI VE: mot dong khong khop duoc voi hai phieu, va mot phieu khong khop duoc voi
/// hai dong. Do la quan he 1-1 ma `GD-09` gia dinh, va no phai duoc DB giu — kiem o tang mien chi
/// dung khi co MOT nguoi ghi.
model TransportFuelMatch {
  id                    String                      @id @default(cuid())
  reconciliationId      String
  reconciliation        TransportFuelReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementLineId       String                      @unique
  statementLine         TransportFuelStatementLine  @relation(fields: [statementLineId], references: [id])
  fuelEntryId           String                      @unique
  fuelEntry             TransportFuelEntry          @relation(fields: [fuelEntryId], references: [id])
  /// Chenh lech DA DO, giu lai de nguoi doi soat thay vi sao cap nay duoc coi la khop.
  amountDeltaVnd        BigInt
  businessDateDeltaDays Int
  origin                TransportFuelMatchOrigin
  matchedAt             DateTime                    @default(now())
  matchedBy             String

  @@index([reconciliationId])
}

/// MOT CHENH LECH CHO NGUOI QUYET. `PENDING` la trang thai chan cua `FUEL-RECON-004`.
model TransportFuelDiscrepancy {
  id                String                              @id @default(cuid())
  reconciliationId  String
  reconciliation    TransportFuelReconciliation         @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  kind              TransportFuelDiscrepancyKind
  status            TransportFuelDiscrepancyStatus      @default(PENDING)
  statementLineId   String?
  statementLine     TransportFuelStatementLine?         @relation(fields: [statementLineId], references: [id])
  fuelEntryId       String?
  fuelEntry         TransportFuelEntry?                 @relation(fields: [fuelEntryId], references: [id])
  /// Cac ung vien cua mot chenh lech `AMBIGUOUS_CANDIDATES` — id, khong phai ban sao du lieu.
  candidateEntryIds String[]
  candidateLineIds  String[]
  resolution        TransportFuelDiscrepancyResolution?
  resolutionNote    String?
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime                            @default(now())

  @@index([reconciliationId, status])
  @@index([statementLineId])
  @@index([fuelEntryId])
}

/// BAN GIAO SANG T5 — mot CHUOI BAN SUA DOI chi them, khong phai mot hang cho mot ky (T4R §2).
///
/// ---------------------------------------------------------------------------
/// VI SAO KHONG CON `reconciliationId @unique`.
///
/// Ban dau moi ky co dung mot ban giao, va dong lai lan hai chi tra ve hang cu. Dieu do idempotent
/// DUNG khi ket qua kinh te khong doi, va SAI hoan toan khi no doi:
///
/// ```text
/// dong lan 1                 -> ban giao 10.000.000d
/// mo lai, sua mot dong bang ke
/// dong lan 2                 -> van tra ve 10.000.000d cu
/// ```
///
/// T5 khong bao gio hoc duoc ve lan sua, va cay xang duoc tra sai so tien. Nen tu T4R:
///
///   · ket qua KHONG doi  -> phat lai ban gan nhat, khong them hang nao;
///   · ket qua DOI        -> them mot ban moi, `supersedesId` tro nguoc ve ban truoc.
///
/// `@@unique([reconciliationId, revision])` la thu giu cho hai lan dong dong thoi khong the cung
/// sinh ra ban thu N. Khoa hang doi soat (`SELECT ... FOR UPDATE`) da noi tiep hoa chung tu truoc,
/// nen day la luoi thu hai — va la luoi DUY NHAT con dung neu mot duong ghi tuong lai quen lay khoa.
///
/// T4 KHONG ghi bang cua T5 — bang nay thuoc `transport-fuel` va la mot HOP THU DI: T5 se doc no
/// de tao `PayableDocument`. Ghi thang sang bang cua T5 se lam hai capability dinh chat vao nhau
/// truoc khi T5 co mot dong code nao.
model TransportFuelSettlementHandoff {
  id                String                          @id @default(cuid())
  reconciliationId  String
  reconciliation    TransportFuelReconciliation     @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  /// Dem tu 1. Ban N+1 thay the ban N; khong ban nao bi sua sau khi da phat.
  revision          Int                             @default(1)
  /// Ban giao ma ban nay THAY THE. `null` o ban dau tien. UNIQUE: mot ban chi bi thay the mot lan.
  supersedesId      String?                         @unique
  supersedes        TransportFuelSettlementHandoff? @relation("TransportFuelHandoffRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy      TransportFuelSettlementHandoff? @relation("TransportFuelHandoffRevision")
  supplierId        String
  periodStart       String                          @db.VarChar(10)
  periodEnd         String                          @db.VarChar(10)
  /// Tong so tien DA DUOC CHAP NHAN, so nguyen dong. Khong gom dong bi tu choi hay bo qua.
  acceptedAmount    BigInt
  currencyCode      String                          @default("VND") @db.VarChar(3)
  acceptedLineCount Int
  /// DUNG nhung dong bang ke nao lam nen so tien tren. T5 tra tien theo BO DONG, khong theo mot so.
  acceptedLineIds   String[]
  emittedAt         DateTime                        @default(now())
  emittedBy         String

  @@unique([reconciliationId, revision])
  @@index([reconciliationId])
  @@index([supplierId])
}

// ----- So cai quyet dinh nghiep vu (Business Decision Ledger v0) -----
//
// TANG NAY TRUNG TINH VE KHACH VA VE MIEN, cung dieu kien voi khoi nguon su that phia tren: khong
// mot ten khach, khong mot thuat ngu ban hang hay van tai nao duoc xuat hien duoi day.
//
// BON MAT PHANG SU THAT — day la mat phang thu nhat, va no KHONG thay the ba mat phang kia:
//   · Postgres (khoi nay)  = SU THAT NGHIEP VU ben vung: "vi sao he thong da quyet dinh nhu vay";
//   · Hatchet              = su that THUC THI ben vung: buoc nao chay, chay lai bao nhieu lan;
//   · OTel/ClickHouse      = su that QUAN SAT: do dai, cay span, log — het han sau 30 ngay;
//   · Git/release          = trang thai PHAN MEM mong muon.
// So cai TUONG QUAN bon mat phang bang cac cot `traceId`/`spanId`/`workflowRunId`/`releaseSha`.
// No KHONG chua payload OTel, khong chua cay span, va khong tro thanh mot he event-sourcing.
//
// QUAN HE VOI `AuditLog` (da co, phia tren). Hai thu KHAC NHAU va co y khong gop:
//   · `AuditLog`         = AI DA SUA GI: mot con nguoi/tien trinh doi mot ban ghi, kem before/after.
//     Chu the la NGUOI THAO TAC va doi tuong la MOT HANG DU LIEU.
//   · `BusinessDecision` = VI SAO HE THONG XU SU NHU VAY: mot cong nghiep vu da mo hay dong, bang
//     ma ly do nao, dua tren su that/chinh sach nao, o ban phat hanh nao.
//     Chu the la MOT QUYET DINH va doi tuong la MOT CA NGHIEP VU.
// Mot lan nguoi van hanh bam nut duyet sinh ra CA HAI: audit ghi "truong status doi", so cai ghi
// "cong da mo voi ma ly do X". Gop lai thi mot trong hai cau hoi se khong con tra loi duoc.
//
// KHONG CHUA PAYLOAD. Xem `decision-ledger/decision-evidence.ts`: `detail` di qua mot DANH SACH
// TRANG (khong phai bo loc) truoc khi duoc ghi, va cong do NEM chu khong che. Repo nay PUBLIC.

enum BusinessDecisionStatus {
  RECORDED
  /// Bi mot quyet dinh SAU thay the tai cung mot cong, cung mot ca. Hang cu GIU NGUYEN.
  SUPERSEDED
  /// Da duoc sua bang mot quyet dinh dao/dieu chinh. Hang cu GIU NGUYEN.
  CORRECTED
}

/// AI QUYET DINH — va day la cot chan "mot de xuat cua LLM bi ghi nhu mot quyet dinh da duyet".
enum BusinessDecisionActorKind {
  /// Rules engine tat dinh. Chay lai voi cung dau vao ra cung ket qua.
  DETERMINISTIC_RULE
  /// Mot con nguoi co tham quyen da bam nut.
  HUMAN
  /// LLM phan loai/trich xuat/de xuat/soan thao. KHONG BAO GIO la tham quyen ben vung.
  LLM_RECOMMENDATION
  /// He qua do workflow/he thong sinh ra tu mot quyet dinh truoc do.
  SYSTEM_CONSEQUENCE
}

/// MUC NGHIEM TRONG — chinh sach that bai o `decision-ledger/decision-criticality.ts`.
enum BusinessDecisionCriticality {
  /// Tien hoac tham quyen. Ghi that bai -> NGHIEP VU DUNG (fail closed).
  FINANCIAL_OR_AUTHORIZATION
  /// Quyet dinh nghiep vu thuong. Ghi that bai -> di tiep, nhung phat yeu cau doi soat ben vung.
  BUSINESS_STANDARD
  /// Quan sat/goi y. Ghi that bai -> di tiep, chi con dau vet o telemetry.
  ADVISORY
}

enum BusinessDecisionRelationKind {
  /// Quyet dinh CHA da dan toi quyet dinh nay (vd de xuat cua LLM -> quyet dinh cua nguoi).
  PARENT_DECISION
  /// Ban ghi phe duyet / ban giao da cho phep quyet dinh nay.
  APPROVAL
  /// Thuc the hoac su kien nghiep vu do quyet dinh nay sinh ra.
  RESULTING_ENTITY
}

/// MOT QUYET DINH NGHIEP VU — APPEND-ONLY.
///
/// KHONG CO DUONG UPDATE NAO cho decisionPoint/outcome/reasonCode/occurredAt/detail.
/// Sua = ghi mot hang MOI tro nguoc ve hang cu (`supersedesId`), roi doi `status` cua hang cu.
/// Do la cot duy nhat cua hang cu duoc phep doi, va no khong xoa mot thong tin nao.
///
/// DANH TINH CHONG TRUNG la `(tenantId, idempotencyKey)`. Hatchet chay lai, HTTP thu lai va giao
/// hang at-least-once deu di qua duong nay: cung khoa -> tra lai hang da ghi, KHONG ghi hang thu
/// hai. Xem `decision-ledger/decision-idempotency.ts` de biet vi sao khoa nay BAT BUOC va vi sao
/// no khong duoc phep tu sinh ra tu ban than quyet dinh.
model BusinessDecision {
  id String @id @default(cuid())

  /// Danh tinh khach. Cung ly do voi `BusinessSource.tenantId`: hom nay moi khach mot DB nen cot
  /// nay du thua ve ha tang, nhung no la thu duy nhat con dung khi dieu do thoi dung.
  tenantId String

  /// `<mien>.<viec>` — DUNG BO TU VUNG cua capability so huu (`*-decisions.ts`), khong phai chuoi
  /// tu do o tang goi. Kieu duoc rang buoc o `DecisionLedgerService.record()`.
  decisionPoint String
  /// `allowed` | `denied` | `degraded` — dung lai `DecisionOutcome` cua nen tang quan sat.
  outcome       String
  /// Ma ly do CO KIEU, thuoc dung bo tu vung cua `decisionPoint`. Khong bao gio la mot cau tieng Viet.
  reasonCode    String

  /// CA NGHIEP VU ma quyet dinh nay noi ve. `subjectType` la loai (`order`, `trip`, `message`…),
  /// `subjectId` la dinh danh NOI BO — khong bao gio la SDT/email/ma khach.
  subjectType String
  subjectId   String

  /// Luc quyet dinh XAY RA trong nghiep vu. Tach khoi `recordedAt`: hai thu lech nhau khi ghi
  /// muon (chay lai, doi soat), va gop lam mot se lam dong thoi gian nghiep vu bi keo theo su co
  /// ha tang.
  occurredAt DateTime
  /// Luc hang nay duoc ghi vao DB. Do ta dat, khong do ben goi.
  recordedAt DateTime @default(now())

  actorKind   BusinessDecisionActorKind
  /// Ai/cai gi — username phien, ten dich vu, ten khuon workflow. KHONG phai ten nguoi dung cuoi.
  actorRef    String?
  criticality BusinessDecisionCriticality @default(BUSINESS_STANDARD)

  /// CHINH SACH/QUY TAC da duoc ap. `policyRef` la dia chi, `policyVersion` la ban.
  /// Khong chua GIA TRI cua chinh sach — gia tri o `BusinessFact`.
  policyRef     String?
  policyVersion String?

  /// LLM co gop phan hay khong, va bang gi. Chi metadata: nha cung cap + ten model.
  /// KHONG BAO GIO chua prompt hay cau tra loi.
  modelProvider String?
  modelRef      String?

  /// TUONG QUAN sang ba mat phang kia. Tat ca deu tuy chon: mot quyet dinh chay ngoai request
  /// scope khong co `traceId`, va do la mot cau tra loi HOP LE chu khong phai mot cho trong.
  releaseSha    String?
  traceId       String?
  spanId        String?
  workflowRunId String?

  /// Tham chieu toi ban ghi CHO PHEP (phe duyet/ban giao) khi cong nay doi mot cai.
  approvalRef String?

  status BusinessDecisionStatus @default(RECORDED)

  /// Khoa chong trung. BAT BUOC — xem `decision-idempotency.ts`.
  idempotencyKey String
  /// Dau tay noi dung cua quyet dinh. Cung khoa + khac dau tay = LOI CUA BEN GOI, khong phai mot
  /// lan chay lai — va cong se tu choi thay vi tra ve mot hang khac.
  fingerprint    String

  /// Quyet dinh nay THAY THE / SUA quyet dinh nao. Cot tuong minh chu khong nam trong bang quan
  /// he chung: may trang thai `status` phu thuoc vao no, va mot bat bien phu thuoc mot bang phu
  /// la mot bat bien khong kiem duoc trong mot cau truy van.
  supersedesId String?           @unique
  supersedes   BusinessDecision? @relation("DecisionSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy BusinessDecision? @relation("DecisionSupersession")

  /// Bang chung BO SUNG, da qua danh sach trang cua `decision-evidence.ts`. Rong la binh thuong.
  detail Json?

  factRefs  BusinessDecisionFactRef[]
  relations BusinessDecisionRelation[]

  /// Chong trung TRONG PHAM VI KHACH. Hai khach dung cung mot khoa la hai quyet dinh khac nhau.
  @@unique([tenantId, idempotencyKey])
  /// "Ke lai mot ca nghiep vu theo thu tu" — duong doc so mot cua so cai.
  @@index([tenantId, subjectType, subjectId, occurredAt])
  /// "Cong nay da dong bao nhieu lan trong thang" — duong doc thu hai.
  @@index([tenantId, decisionPoint, occurredAt])
  /// Tu mot trace/mot run quan sat duoc, tim ve bang chung ben vung.
  @@index([tenantId, traceId])
  @@index([tenantId, workflowRunId])
}

/// SU THAT DA DUOC DUNG de ra quyet dinh nay — `DecisionFactReference` cua hop dong nhiem vu.
///
/// CO CA KHOA NGOAI LAN ANH CHUP, va hai thu tra loi hai cau khac nhau:
///   · khoa ngoai (`factId`) chung minh ban ghi su that do THUC SU TON TAI, va chan xoa no;
///   · anh chup (`factStatusAtUse`, `sourceVersion`…) giu lai trang thai LUC DUNG.
/// Thieu anh chup thi khi ban su that bi thay the, `status` cua chinh hang do doi thanh
/// `SUPERSEDED` — va mot quyet dinh dung dan hom qua se doc lai nhu "da dung mot su that het
/// hieu luc". Do la dung kieu viet lai lich su ma muc 9 hop dong cam.
///
/// KHONG CHUA `value` cua su that. Gia tri co the la so tien mat cua khach; so cai chi can biet
/// DIA CHI va BAN.
model BusinessDecisionFactRef {
  id         String           @id @default(cuid())
  decisionId String
  decision   BusinessDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict` — mot su that da tung dung de quyet dinh thi khong con xoa duoc.
  factId String
  fact   BusinessFact @relation(fields: [factId], references: [id], onDelete: Restrict)

  /// Anh chup DIA CHI su that. Doc duoc ma khong phai join, va con dung neu mo hinh doi ve sau.
  factDomain      String
  factKey         String
  /// Trang thai su that LUC DUOC DUNG (`CONFIRMED`, `WORKING_ASSUMPTION`…). Chuoi, khong enum:
  /// mot hang lich su khong duoc phep hong vi hom nay ta them mot trang thai moi.
  factStatusAtUse String

  /// Ban nguon dang sau su that do, luc duoc dung.
  sourceId      String?
  sourceKey     String?
  sourceVersion String?

  @@unique([decisionId, factId])
  @@index([factId])
}

/// QUAN HE toi thieu quanh mot quyet dinh — `DecisionRelation` cua hop dong nhiem vu.
///
/// BANG CHUNG, khong phai do thi. Ba loai quan he o `BusinessDecisionRelationKind` va het; day
/// KHONG phai Evidence Graph (ngoai pham vi, muc 16), va khong co duong duyet de quy nao doc no.
model BusinessDecisionRelation {
  id         String           @id @default(cuid())
  decisionId String
  decision   BusinessDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  kind       BusinessDecisionRelationKind
  /// Loai dich (`decision`, `approval`, `order`, `trip`…) — chuoi tu do co chu y: moi vertical
  /// goi ten thuc the cua no mot kieu.
  targetType String
  targetId   String
  note       String?

  @@unique([decisionId, kind, targetType, targetId])
  @@index([targetType, targetId])
}

// ===================================================================
// TX-05 SETTLEMENT — AR/AP, doi tac, hoa hong, bien truc tiep (Issue #87)
// ===================================================================

enum TransportSettlementDirection {
  RECEIVABLE
  PAYABLE
}

enum TransportSettlementFlow {
  CUSTOMER_FREIGHT
  FUEL_SUPPLIER
  CARRIER_SERVICE
  PARTNER_COMMISSION
}

enum TransportSettlementCounterpartyKind {
  CUSTOMER
  PARTNER
  FUEL_SUPPLIER
}

enum TransportSettlementDocumentKind {
  ORIGINAL
  ADJUSTMENT
  REVERSAL
}

enum TransportSettlementDocumentStatus {
  POSTED
  REVERSED
}

enum TransportCommissionCalcKind {
  PERCENTAGE
  FIXED
}

enum TransportCommissionRuleStatus {
  ACTIVE
  ARCHIVED
}

enum TransportSettlementPeriodStatus {
  OPEN
  CLOSING
  CLOSED
  REOPENED
}

/// CHUNG TU quyet toan — mot hang cho MOT nghia vu tien, o MOT dong, theo MOT chieu.
///
/// `direction` + `flow` + `counterpartyKind` deu BAT BUOC: mot chung tu khong thuoc dong nao la
/// thu khong bieu dien duoc. Do la cach "nam dong giu rieng" duoc giu bang CAU TRUC thay vi bang
/// ky luat truy van.
///
/// BAT BIEN: mot hang `ORIGINAL` khong bao gio bi sua noi dung (`INV-20`). Sua = ghi them mot hang
/// `ADJUSTMENT` (chenh lech co dau) hoac `REVERSAL` (dao toan bo), ca hai tro nguoc ve ban goc qua
/// `adjustsId`. Ban goc giu nguyen MOI truong; chi `status` doi sang `REVERSED` khi bi dao.
///
/// `@@unique([sourceContext, sourceId])` la khoa chong ghi trung ma Issue #87 yeu cau. Mot su kien
/// kinh te chi sinh ra DUNG mot chung tu goc du duong goi chay lai bao nhieu lan.
/// `sourceFingerprint` la nua thu hai: cung khoa ma khac noi dung la LOI BEN GOI, va tra ve ban cu
/// se lam ho tin rang con so MOI cua ho da duoc ghi.
///
/// `signedAmount` CO DAU vi `ADJUSTMENT` mang chenh lech, va chenh lech co the am. Doc mot chuoi
/// chung tu = cong `signedAmount` cua ban goc va moi ban sua cua no.
model TransportSettlementDocument {
  id                String                              @id @default(cuid())
  direction         TransportSettlementDirection
  flow              TransportSettlementFlow
  counterpartyKind  TransportSettlementCounterpartyKind
  counterpartyId    String
  kind              TransportSettlementDocumentKind     @default(ORIGINAL)
  status            TransportSettlementDocumentStatus   @default(POSTED)
  /// So nguyen dong CO DAU. Khoang bi `CHECK` bo hep cho khop `money()` — xem migration.
  signedAmount      BigInt
  currencyCode      String                              @default("VND") @db.VarChar(3)
  /// `INV-25` — ngay GHI NHAN, tinh mot lan luc ghi theo mui gio tenant.
  businessDate      String                              @db.VarChar(10)
  /// `businessDate` cong dieu khoan thanh toan cua khach. NULL o chung tu khong co han rieng.
  dueDate           String?                             @db.VarChar(10)
  tripId            String?
  trip              TransportTrip?                      @relation(fields: [tripId], references: [id])
  sourceContext     String                              @db.VarChar(60)
  sourceId          String                              @db.VarChar(160)
  sourceFingerprint String
  /// Ban goc ma hang nay sua. NULL o `ORIGINAL`.
  adjustsId         String?
  adjusts           TransportSettlementDocument?        @relation("TransportSettlementAdjustment", fields: [adjustsId], references: [id], onDelete: Restrict)
  adjustedBy        TransportSettlementDocument[]       @relation("TransportSettlementAdjustment")
  /// `GD-16` — CHI la so tham chieu. Khong co hoa don dien tu nao duoc phat o day.
  invoiceRef        String?
  note              String?
  recordedBy        String
  createdAt         DateTime                            @default(now())

  allocations                TransportSettlementAllocation[]
  commission                 TransportCommissionCalculation?
  customerReconciliation     TransportCustomerReconciliation?
  customerPaymentAllocations TransportCustomerPaymentAllocation[]

  @@unique([sourceContext, sourceId])
  @@index([direction, flow, counterpartyId])
  @@index([direction, dueDate])
  @@index([tripId])
  @@index([adjustsId])
}

/// PHAN BO thanh toan vao mot chung tu. Cong don cua no la "da tra/da thu duoc bao nhieu".
///
/// KHONG co cot `paidAmount` tren `TransportSettlementDocument`, cung ly le voi `INV-01` cua
/// `TX-03`: so da tra la KET QUA cong don, khong phai mot o nho. Mot o nho se lech vinh vien ngay
/// lan dau mot loi xay ra giua "ghi phan bo" va "cap nhat so da tra".
model TransportSettlementAllocation {
  id            String                      @id @default(cuid())
  documentId    String
  document      TransportSettlementDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  /// DUONG. Mot lan tra lai tien la mot `ADJUSTMENT` tren chung tu, khong phai mot phan bo am.
  amount        BigInt
  businessDate  String                      @db.VarChar(10)
  method        String                      @db.VarChar(40)
  sourceContext String                      @db.VarChar(60)
  sourceId      String                      @db.VarChar(160)
  note          String?
  recordedBy    String
  createdAt     DateTime                    @default(now())

  @@unique([sourceContext, sourceId])
  @@index([documentId])
}

enum TransportCustomerReconciliationBatchStatus {
  DRAFT
  CLOSED
  CANCELLED
}

enum TransportCustomerReconciliationLineState {
  PENDING
  CONFIRMED
  DEFERRED
}

enum TransportCustomerPaymentAllocationKind {
  APPLY
  RELEASE
}

/// NHOM DOI SOAT voi ben A. Batch chi la tien ich quy trinh; Order van la grain su that.
model TransportCustomerReconciliationBatch {
  id                String                                     @id @default(cuid())
  customerId        String
  customer          TransportCustomer                          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currencyCode      String                                     @default("VND") @db.VarChar(3)
  status            TransportCustomerReconciliationBatchStatus @default(DRAFT)
  periodStart       String?                                    @db.VarChar(10)
  periodEnd         String?                                    @db.VarChar(10)
  reference         String?
  note              String?
  sourceContext     String                                     @db.VarChar(60)
  sourceId          String                                     @db.VarChar(160)
  sourceFingerprint String
  createdBy         String
  createdAt         DateTime                                   @default(now()) @db.Timestamptz(6)
  closedBy          String?
  closedAt          DateTime?                                  @db.Timestamptz(6)

  lines TransportCustomerReconciliationBatchLine[]

  @@unique([sourceContext, sourceId])
  @@index([customerId, status])
  @@index([periodStart, periodEnd])
}

/// Dong cong viec trong batch. Dong PENDING duoc giai quyet dung mot lan thanh CONFIRMED/DEFERRED.
model TransportCustomerReconciliationBatchLine {
  id                    String                                   @id @default(cuid())
  batchId               String
  batch                 TransportCustomerReconciliationBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  orderId               String
  order                 TransportOrder                           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderCode             String
  proposedAmount        BigInt
  currencyCode          String                                   @default("VND") @db.VarChar(3)
  state                 TransportCustomerReconciliationLineState @default(PENDING)
  resolutionReason      String?
  resolvedBy            String?
  resolvedAt            DateTime?                                @db.Timestamptz(6)
  resolutionSourceId    String?                                  @db.VarChar(160)
  resolutionFingerprint String?
  reconciliation        TransportCustomerReconciliation?
  createdAt             DateTime                                 @default(now()) @db.Timestamptz(6)

  @@unique([batchId, orderId])
  @@index([batchId, state])
  @@index([orderId])
}

/// Ket qua A xac nhan o grain Order. Bat bien; sua tien bang settlement adjustment/reversal hien co.
model TransportCustomerReconciliation {
  id                    String                                    @id @default(cuid())
  orderId               String                                    @unique
  order                 TransportOrder                            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId            String
  customer              TransportCustomer                         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  batchLineId           String?                                   @unique
  batchLine             TransportCustomerReconciliationBatchLine? @relation(fields: [batchLineId], references: [id], onDelete: Restrict)
  proposedAmount        BigInt
  confirmedAmount       BigInt
  differenceAmount      BigInt
  currencyCode          String                                    @default("VND") @db.VarChar(3)
  businessDate          String                                    @db.VarChar(10)
  dueDate               String?                                   @db.VarChar(10)
  differenceReason      String?
  confirmationReference String?
  evidenceRefs          String[]                                  @default([])
  sourceContext         String                                    @db.VarChar(60)
  sourceId              String                                    @db.VarChar(160)
  sourceFingerprint     String
  confirmedBy           String
  confirmedAt           DateTime                                  @default(now()) @db.Timestamptz(6)
  settlementDocumentId  String                                    @unique
  settlementDocument    TransportSettlementDocument               @relation(fields: [settlementDocumentId], references: [id], onDelete: Restrict)
  createdAt             DateTime                                  @default(now()) @db.Timestamptz(6)

  @@unique([sourceContext, sourceId])
  @@index([customerId, businessDate])
}

/// TIEN A CHUYEN cho B. Co the den truoc doi soat, nen khong tro thang vao Order/chung tu.
model TransportCustomerPayment {
  id                String            @id @default(cuid())
  customerId        String
  customer          TransportCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount            BigInt
  currencyCode      String            @default("VND") @db.VarChar(3)
  receivedAt        DateTime          @db.Timestamptz(6)
  businessDate      String            @db.VarChar(10)
  externalRef       String?
  note              String?
  recordedBy        String
  sourceContext     String            @db.VarChar(60)
  sourceId          String            @db.VarChar(160)
  sourceFingerprint String
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)

  allocations TransportCustomerPaymentAllocation[]

  @@unique([sourceContext, sourceId])
  @@index([customerId, businessDate])
}

/// Phan bo many-to-many giua payment va cong no da confirm.
model TransportCustomerPaymentAllocation {
  id                String                                 @id @default(cuid())
  paymentId         String
  payment           TransportCustomerPayment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  documentId        String
  document          TransportSettlementDocument            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  kind              TransportCustomerPaymentAllocationKind @default(APPLY)
  amount            BigInt
  businessDate      String                                 @db.VarChar(10)
  reversesId        String?                                @unique
  reverses          TransportCustomerPaymentAllocation?    @relation("TransportCustomerPaymentAllocationRelease", fields: [reversesId], references: [id], onDelete: Restrict)
  releasedBy        TransportCustomerPaymentAllocation?    @relation("TransportCustomerPaymentAllocationRelease")
  sourceContext     String                                 @db.VarChar(60)
  sourceId          String                                 @db.VarChar(160)
  sourceFingerprint String
  note              String?
  recordedBy        String
  createdAt         DateTime                               @default(now()) @db.Timestamptz(6)

  @@unique([sourceContext, sourceId])
  @@index([paymentId])
  @@index([documentId])
}

/// KY QUYET TOAN theo DONG TIEN. `CLOSED`/`CLOSING` deu dong bang ky: mot chung tu co ngay nghiep
/// vu roi vao khoang do se bi tu choi (Issue #87 — "closed period rejects silent backdated
/// mutation"). Khong chong lap trong cung mot dong — cuong che bang EXCLUDE constraint trong
/// migration, cung khuon voi `TransportDriverFundPeriod` cua `TX-03`.
model TransportSettlementPeriod {
  id           String                          @id @default(cuid())
  flow         TransportSettlementFlow
  startDate    String                          @db.VarChar(10)
  endDate      String                          @db.VarChar(10)
  status       TransportSettlementPeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  @@index([flow, status])
  @@index([flow, startDate, endDate])
}

/// DIEU KHOAN THUONG MAI cua mot khach — han thanh toan va han muc tin dung.
///
/// `paymentTermDays` la CAU HINH (15/30/45 theo Issue #87), khong phai hang so trong code: hai
/// khach cua cung mot tenant co the co han khac nhau, va do la thu thay doi trong doi hop dong.
///
/// `creditLimit` NULLABLE = khong dat han muc. `null` KHAC `0`: `0` nghia la khach nay khong duoc
/// no dong nao, va gop hai thu do lai se bien mot khach chua khai han muc thanh mot khach bi chan.
/// Ca hai deu chi sinh ra CANH BAO, khong bao gio chan chuyen (Issue #87 — "warning, not block").
model TransportCustomerTerms {
  customerId      String            @id
  customer        TransportCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentTermDays Int
  creditLimit     BigInt?
  currencyCode    String            @default("VND") @db.VarChar(3)
  updatedBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// LUAT HOA HONG — PHAM VI, khong phai con so. Con so nam o `TransportCommissionRuleVersion`.
///
/// Tach hai bang vi chung co VONG DOI khac nhau: pham vi ("doi tac X tren tuyen Y") ben vung, con
/// ty le thi doi theo dot dam phan. Gop lai thi moi lan doi ty le se hoac ghi de mat ty le cu —
/// tuc mot chuyen da quyet toan doc lai ra con so khac — hoac sinh mot hang pham vi trung lap thu
/// hai, va tu do phep chon luat khong con tat dinh.
///
/// `@@unique([partnerId, routeKey])` giu cho mot pham vi chi co MOT luat. Khong co no thi hai luat
/// cung pham vi se lam phep chon nhap nhang, va Issue #87 doi nhap nhang phai FAIL CLOSED — de bat
/// duoc thi truoc het khong duoc phep tao ra no mot cach im lang.
model TransportCommissionRule {
  id        String                        @id @default(cuid())
  /// NULL = moi doi tac.
  partnerId String?
  partner   TransportPartner?             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// NULL = moi tuyen. Khoa tuyen chuan hoa, xem `commissionRouteKey()`.
  routeKey  String?                       @db.VarChar(160)
  status    TransportCommissionRuleStatus @default(ACTIVE)
  createdBy String
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  versions TransportCommissionRuleVersion[]

  @@unique([partnerId, routeKey])
  @@index([status])
  @@index([partnerId])
}

/// MOT BAN cua mot luat hoa hong — CHI THEM, khong bao gio sua.
///
/// `rateBasisPoints` la DIEM CO BAN (1% = 100), so NGUYEN. Khong dung so thuc cho ty le vi cung
/// mot ly do `GD-03` cam so thuc cho tien: `0.1 + 0.2` khong bang `0.3`, va mot ty le hoa hong sai
/// o chu so thu muoi lam se thanh mot khoan tien sai sau khi nhan voi gia cuoc.
model TransportCommissionRuleVersion {
  id              String                      @id @default(cuid())
  ruleId          String
  rule            TransportCommissionRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version         Int
  calcKind        TransportCommissionCalcKind
  /// BAT BUOC khi `calcKind = PERCENTAGE`, NULL khi `FIXED`. Cuong che bang `CHECK` o migration.
  rateBasisPoints Int?
  /// BAT BUOC khi `calcKind = FIXED`, NULL khi `PERCENTAGE`.
  fixedAmount     BigInt?
  effectiveFrom   String                      @db.VarChar(10)
  /// NULL = con hieu luc.
  effectiveTo     String?                     @db.VarChar(10)
  publishedAt     DateTime                    @default(now())
  publishedBy     String

  calculations TransportCommissionCalculation[]

  @@unique([ruleId, version])
  @@index([ruleId, effectiveFrom])
}

/// ANH CHUP mot lan tinh hoa hong — dau vao, ban luat da chon, ket qua tho va ket qua cuoi.
///
/// VI SAO CHUP LAI THAY VI TRO KHOA NGOAI KHONG: mot chuyen da quyet toan phai doc ra CUNG mot con
/// so mai mai (Issue #87 acceptance 8). Chi giu `ruleVersionId` thi cau tra loi "vi sao la con so
/// nay" phu thuoc vao mot hang khac con song va con nguyen — va bang luat la thu nguoi dung sua.
///
/// `rawAmount` la chuoi thap phan TRUOC lam tron, giu de doi soat duoc phep lam tron. Mot con so
/// `resultAmount` don doc khong tra loi duoc "lam tron len hay xuong, tu bao nhieu".
///
/// `@@unique([tripId])` — mot chuyen sinh DUNG mot lan tinh hoa hong.
model TransportCommissionCalculation {
  id                      String                         @id @default(cuid())
  tripId                  String                         @unique
  trip                    TransportTrip                  @relation(fields: [tripId], references: [id], onDelete: Restrict)
  ruleVersionId           String
  ruleVersion             TransportCommissionRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  /// `PARTNER_ROUTE` / `PARTNER` / `ROUTE` / `GLOBAL` — bac uu tien da thang, chup lai.
  ruleScopeSnapshot       String                         @db.VarChar(20)
  calcKindSnapshot        TransportCommissionCalcKind
  rateBasisPointsSnapshot Int?
  fixedAmountSnapshot     BigInt?
  /// Gia cuoc lam CAN CU tinh. Chup lai vi gia cuoc chuyen co the bi sua sau do.
  basisAmount             BigInt
  rawAmount               String                         @db.VarChar(40)
  resultAmount            BigInt
  documentId              String?                        @unique
  document                TransportSettlementDocument?   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  partnerId               String
  businessDate            String                         @db.VarChar(10)
  createdAt               DateTime                       @default(now())

  @@index([partnerId])
  @@index([ruleVersionId])
}

// ===================================================================
// TX-06 ASSET & COMPLIANCE — bao duong, giay to va han (Issue #88)
// ===================================================================

/// CAN CU tinh han bao duong. VT-063: lich dinh ky theo km HOAC thoi gian, cai nao toi truoc. Ca
/// hai cung bat la truong hop thuong gap nhat, khong phai ngoai le.
enum TransportMaintenanceTriggerKind {
  ODOMETER
  CALENDAR
  ODOMETER_OR_CALENDAR
}

enum TransportMaintenancePlanStatus {
  ACTIVE
  INACTIVE
}

/// VONG DOI mot lenh sua. `OPEN` la trang thai KHOA XE — xem phep hop thanh o
/// `effective-vehicle-state.ts`.
///
/// `CANCELLED` ton tai vi mot lenh mo nham phai go duoc ma KHONG duoc xoa (cung tinh than `GD-02`):
/// mot lenh sua da tung khoa xe la mot su kien van hanh, khong phai mot dong nhap sai.
enum TransportMaintenanceWorkOrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// BAN CHAT cua mot lenh sua — `TX-06b` (Lane D, Issue #237).
///
/// Ba gia tri nay KHONG phai ba cai nhan cho dep: chung tra loi ba cau hoi khac nhau ma bao cao
/// van hanh phai tach duoc.
///
///   · `SCHEDULED_SERVICE`   — bao duong theo lich. LUON co `planId`, va lan dong no dat lai moc
///                             chu ky. Day la chi phi CO KE HOACH.
///   · `REPAIR`              — sua chua tai xuong, khong theo lich nao. Chi phi NGOAI ke hoach.
///   · `ROADSIDE_BREAKDOWN`  — hong doc duong. Khac `REPAIR` o cho no lam DUT mot chuyen dang
///                             chay, nen no la ban ghi duy nhat duoc phep tro toi `tripId`.
///
/// Gop `ROADSIDE_BREAKDOWN` vao `REPAIR` se lam phep dem "bao nhieu lan xe chet doc duong" mat dap
/// an — va do la con so mot doanh nghiep van tai nhin truoc khi quyet dinh thay xe.
enum TransportMaintenanceWorkOrderKind {
  SCHEDULED_SERVICE
  REPAIR
  ROADSIDE_BREAKDOWN
}

/// LOAI GIAY TO — VT-011 (dang kiem, bao hiem, phu hieu) + VT-014 (GPLX) + VT-065 (giay phep kinh
/// doanh van tai cua CONG TY, giay phep van chuyen hang co dieu kien).
///
/// Enum chu khong bang danh muc: sau loai nay la LUAT, khong phai lua chon cua khach — mot doanh
/// nghiep van tai Viet Nam khong the khong co dang kiem. Khach them loai rieng la mot yeu cau chua
/// ai neu; khi co, day thanh mot bang danh muc, va do la mot thay doi CO CHU DICH chu khong phai
/// mot o trong de san.
enum TransportComplianceDocumentType {
  VEHICLE_INSPECTION
  VEHICLE_INSURANCE
  VEHICLE_TRANSPORT_BADGE
  DRIVER_LICENCE
  COMPANY_TRANSPORT_LICENSE
  CONDITIONAL_CARGO_PERMIT
}

/// CHU THE mot giay to gan vao. `COMPANY` khong co `subjectId` — giay phep kinh doanh van tai la
/// cua phap nhan, khong cua mot xe hay mot nguoi.
enum TransportComplianceSubjectKind {
  VEHICLE
  DRIVER
  COMPANY
}

/// TRANG THAI QUAN TRI cua mot ban giay to — KHONG phai tinh trang het han.
///
/// Hai thu nay CO Y tach doi. Het han hay chua la mot HAM cua (`validTo`, hom nay, nguong cua
/// khach): no doi moi ngay va doi khi khach doi nguong, nen luu no thanh cot se sai ngay hom sau va
/// sai lang le. Cot nay chi noi ban ghi con hieu luc quan tri hay da bi thay the/thu hoi.
enum TransportComplianceDocumentStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

/// LICH BAO DUONG DINH KY cua mot xe.
///
/// `intervalKm` + `intervalDays` la CHU KY, khong phai moc. Moc duoc tinh tu lan bao duong gan nhat
/// da hoan thanh cua cung ke hoach, hoac tu `baselineOdoKm`/`baselineDate` khi chua co lan nao. Luu
/// moc thanh cot se lam moi lan doi chu ky phai viet lai lich su — dung cai ma acceptance 3 cua
/// Issue #88 cam o phia giay to.
model TransportMaintenancePlan {
  id            String                          @id @default(cuid())
  vehicleId     String
  vehicle       TransportVehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// Ten hang muc — "Thay dau may", "Bao duong 20.000km". Van ban tu do: danh muc hang muc bao
  /// duong la thu tung khach tung doi xe mot khac, khong phai mot enum cua mien.
  name          String
  triggerKind   TransportMaintenanceTriggerKind
  /// Chu ky theo km. NULL khi `triggerKind = CALENDAR`.
  intervalKm    Int?
  /// Chu ky theo ngay. NULL khi `triggerKind = ODOMETER`.
  intervalDays  Int?
  /// Moc goc khi chua co lan bao duong nao. `INV-25` — NGAY nghiep vu, khong phai khoanh khac.
  baselineOdoKm Int
  baselineDate  String                          @db.VarChar(10)
  status        TransportMaintenancePlanStatus  @default(ACTIVE)
  createdBy     String
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  workOrders TransportMaintenanceWorkOrder[]

  @@index([vehicleId, status])
}

/// LENH SUA — bao duong theo lich HOAC sua dot xuat tai xuong.
///
/// TACH KHOI `TransportTripExpense` loai sua chua dung yeu cau VT-063 ("tach biet voi chi phi sua
/// chua phat sinh tren duong"). Hai thu khac nhau ve BAN CHAT: mot khoan chi doc duong la tien lai
/// xe ung ra giua chuyen; mot lenh sua la mot lan xe RA KHOI doi hinh. Gop lai se lam moi lan va
/// quet cho mot cai guong bien thanh mot lan xe bi khoa.
///
/// `costingExpenseRef` la SO THAM CHIEU sang chung tu chi phi cua `transport-costing`, KHONG phai
/// khoa ngoai: T6 khong duoc so vao bang cua T3, va mot lenh sua ton tai duoc ca khi khach tat
/// `transport-costing`. Chi duoc dat khi nguoi dung DAY chi phi sang costing mot cach tuong minh.
model TransportMaintenanceWorkOrder {
  id                 String                              @id @default(cuid())
  vehicleId          String
  vehicle            TransportVehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// Ke hoach sinh ra lenh nay. NULL = sua dot xuat, khong theo lich nao.
  planId             String?
  plan               TransportMaintenancePlan?           @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             TransportMaintenanceWorkOrderStatus @default(OPEN)
  description        String
  /// `INV-25` — ngay nghiep vu mo lenh.
  openedDate         String                              @db.VarChar(10)
  openedOdoKm        Int
  openedBy           String
  openedAt           DateTime                            @default(now())
  completedDate      String?                             @db.VarChar(10)
  completedOdoKm     Int?
  completedBy        String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?
  /// Chi phi cua lenh sua, so nguyen dong. NULL = chua ghi nhan chi phi. Xem `partsCost` ben duoi.
  costAmount         BigInt?
  currencyCode       String                              @default("VND") @db.VarChar(3)
  /// Tham chieu chung tu chi phi ben `transport-costing`. Xem ghi chu dau model.
  costingExpenseRef  String?
  note               String?
  updatedAt          DateTime                            @updatedAt

  // ----- `TX-06b` (Lane D, Issue #237) — cac truong CONG THEM, tat ca deu nullable -----

  /// BAN CHAT cua lenh. Xem `TransportMaintenanceWorkOrderKind`.
  ///
  /// `DEFAULT 'REPAIR'` cong mot lan backfill tat dinh trong migration
  /// (`planId IS NOT NULL` => `SCHEDULED_SERVICE`): hang cu khong co cach nao noi ban chat cua no
  /// ngoai viec no co theo mot ke hoach hay khong, va do la phep suy DUY NHAT khong bia gi them.
  kind TransportMaintenanceWorkOrderKind @default(REPAIR)

  /// XUONG SUA — ten va so dien thoai. Van ban tu do, KHONG phai mot bang danh muc.
  ///
  /// Mot bang `Workshop` doi mot vong doi (them/sua/ngung hop tac), mot man hinh quan tri va mot
  /// quyen rieng — trong khi khong nguon nao noi B quan ly danh sach xuong. Hai cot van ban tra
  /// loi dung cau hoi dang co ("xe nay sua o dau"), va nang cap thanh mot bang sau nay chi la mot
  /// lan them khoa ngoai.
  vendorName  String?
  vendorPhone String?

  /// TACH chi phi: phu tung / cong tho. `costAmount` van la TONG.
  ///
  /// Ca ba deu nullable va doc lap: mot hoa don xuong thuong co du ca ba, nhung mot lenh sua nho
  /// chi co tong. Rang buoc `..._cost_parts_labour` cuong che DUNG mot dieu — khi ca ba cung co
  /// mat thi `costAmount = partsCost + labourCost`. Khong ep co mat, chi ep KHOP.
  partsCost  BigInt?
  labourCost BigInt?

  /// Tham chieu BANG CHUNG (anh hoa don xuong). Cung quy uoc voi
  /// `TransportTripExpense.evidenceLocator`: `PG-05`/#223 chua dong, nen day la mot tham chieu
  /// van ban thuoc mien, va CAM dung mot he tai lieu song song. Khi #223 dong, cot nay tro thanh
  /// khoa ngoai tro toi chung tu that.
  evidenceLocator String?

  /// CHUYEN bi dut vi lan hong nay. CHI co nghia voi `ROADSIDE_BREAKDOWN` — cuong che bang `CHECK`.
  ///
  /// `onDelete: SetNull` chu khong `Restrict`: mot lenh sua da xay ra that, va no khong duoc bien
  /// mat theo mot chuyen. `GD-02` cam xoa chuyen, nhung neu mot ngay nao do co duong xoa thi lenh
  /// sua phai song sot.
  tripId String?
  trip   TransportTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// MOC DEN HAN da chup lai luc mo lenh — "ke hoach" cua cap ke-hoach/thuc-te.
  ///
  /// KHONG tinh lai luc doc. `maintenance-schedule.ts` tinh moc tu chu ky va lan bao duong gan
  /// nhat; con so do DOI khi khach doi chu ky. Mot bao cao "sua som/muon bao nhieu" phai so voi
  /// moc CUA LUC DO, khong phai moc cua hom nay.
  plannedDate  String? @db.VarChar(10)
  plannedOdoKm Int?

  @@index([vehicleId, status])
  @@index([planId])
  @@index([status])
  @@index([kind])
  @@index([tripId])
}

/// GIAY TO PHAP LY — mot loai, mot chu the, mot ky hieu luc (T1 §5 `TX-06`).
///
/// TINH TRANG HET HAN KHONG NAM O DAY. `expired`/`due soon`/`healthy` duoc tinh luc DOC tu
/// (`validTo`, hom nay, nguong cua khach) — xem `compliance-alerts.ts`. Do la dieu kien de
/// acceptance 3 cua Issue #88 dung duoc: doi nguong canh bao thi hinh chieu doi, con BANG CHUNG
/// lich su khong mot byte nao bi ghi lai.
model TransportComplianceDocument {
  id           String                            @id @default(cuid())
  subjectKind  TransportComplianceSubjectKind
  /// `NULL` khi va chi khi `subjectKind = COMPANY`. Cuong che bang CHECK trong migration.
  subjectId    String?
  documentType TransportComplianceDocumentType
  /// So hieu giay to — so dang kiem, so don bao hiem, so GPLX.
  documentNo   String?
  /// `INV-25` — NGAY nghiep vu, khong phai khoanh khac.
  validFrom    String                            @db.VarChar(10)
  validTo      String                            @db.VarChar(10)
  status       TransportComplianceDocumentStatus @default(ACTIVE)
  /// Tro toi anh/ban scan da luu. Van ban tu do: T6 khong so huu tang luu tru tep.
  evidenceRef  String?
  note         String?
  recordedBy   String
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt

  @@index([subjectKind, subjectId])
  @@index([documentType, validTo])
  @@index([status, validTo])
}

// ===================================================================
// TX-07 WORKFORCE — ky luong, phieu luong, thanh phan (Issue #88)
// ===================================================================

enum TransportPayrollPeriodStatus {
  OPEN
  CLOSED
}

/// VONG DOI mot phieu luong.
///
/// `DRAFT` sua duoc; tu `APPROVED` tro di BAT BIEN — sua = phieu bo sung (`SUPPLEMENTAL`) hoac dao
/// (`REVERSAL`). Cung khuon `INV-20` cua T3/T5, va la dieu kien cua acceptance 12.
enum TransportPayslipStatus {
  DRAFT
  APPROVED
  PAID
  REVERSED
}

/// LOAI PHIEU. `ORIGINAL` la ket qua cua mot lan chay luong; hai loai con lai luon tro nguoc ve mot
/// ban goc qua `correctsId`.
enum TransportPayslipKind {
  ORIGINAL
  SUPPLEMENTAL
  REVERSAL
}

/// LOAI THANH PHAN luong. `EARNING` cong, `DEDUCTION` tru.
///
/// `GD-12`: KHONG co loai nao mang nghia "tru vi lai xe con no ung / thieu chung tu". So du quy
/// hien thi tren phieu la THONG TIN (`TransportPayslip.driverFundBalanceSnapshot`), khong bao gio di
/// vao mot `DEDUCTION`. Xem `payroll-calculator.ts` va bai test cua acceptance 11.
enum TransportPayslipComponentKind {
  EARNING
  DEDUCTION
}

/// NGUON mot thanh phan luong — tra loi "con so nay o dau ra".
///
/// `MANUAL_BONUS`/`MANUAL_DEDUCTION` la duong DUY NHAT de mot khoan tru xuat hien, va no doi mot
/// nguoi ky ten (`recordedBy`). Khong mot ma nao trong bo nay sinh tu dong tu ket qua doi soat hay
/// tu so du quy — do la `INV-27` + `GD-12` duoc giu bang CHINH BO TU VUNG NAY.
enum TransportPayslipComponentSource {
  BASE_SALARY
  PER_TRIP
  PER_KM
  FUEL_SAVING_BONUS
  MANUAL_BONUS
  MANUAL_DEDUCTION
}

/// KY LUONG — khong chong lap, cuong che bang EXCLUDE trong migration (cung khuon
/// `TransportDriverFundPeriod` cua T3 va `TransportSettlementPeriod` cua T5).
model TransportPayrollPeriod {
  id        String                       @id @default(cuid())
  /// Nhan doc duoc cua ky — "Thang 8/2026". Khong phai khoa.
  label     String
  startDate String                       @db.VarChar(10)
  endDate   String                       @db.VarChar(10)
  status    TransportPayrollPeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?
  createdBy String
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  runs TransportPayrollRun[]

  @@index([status])
  @@index([startDate, endDate])
}

/// MOT LAN CHAY LUONG cho mot ky — mang ANH CHUP chinh sach da dung.
///
/// `policySnapshot` la JSON, khong phai khoa ngoai sang cau hinh: cau hinh la thu nguoi dung sua, va
/// mot ky luong da tra phai doc ra CUNG mot con so mai mai. Cung ly le voi
/// `TransportCommissionCalculation` cua T5 — chup thay vi tro.
///
/// `policyVersion` la ma bam noi dung cua anh chup do, de hai lan chay cung chinh sach nhan ra nhau
/// ma khong phai so tung truong.
model TransportPayrollRun {
  id             String                 @id @default(cuid())
  periodId       String
  period         TransportPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  /// Lan chay thu may trong ky. Mot ky chay lai duoc; moi lan la mot ban ghi rieng.
  sequence       Int
  policySnapshot Json
  policyVersion  String                 @db.VarChar(64)
  /// Nguon du lieu KHONG san co luc chay, ghi ten thay vi de ngam. Vi du `FUEL_SAVING_UNAVAILABLE`
  /// khi khach tat `transport-fuel`. Doc duoc tren phieu, nen mot con so thieu khong bi doc nham
  /// thanh so khong.
  missingInputs  String[]
  runBy          String
  runAt          DateTime               @default(now())

  payslips TransportPayslip[]

  @@unique([periodId, sequence])
  @@index([periodId])
}

/// PHIEU LUONG cua mot lai xe trong mot lan chay.
///
/// `driverFundBalanceSnapshot` la THONG TIN, khong phai mot khoan tru (`GD-12`). No nam tren phieu
/// vi VT-062 muon nguoi duyet NHIN THAY so du truoc khi quyet dinh — nhung quyet dinh do la cua
/// NGUOI, va neu ho quyet tru thi khoan do di qua `MANUAL_DEDUCTION` co ten nguoi ky.
///
/// `netAmount` la KET QUA cong don cua `components`, chup lai luc chot de phieu da duyet doc ra cung
/// mot so mai mai — khong phai mot o nho song song voi cac dong.
model TransportPayslip {
  id                        String                 @id @default(cuid())
  runId                     String
  run                       TransportPayrollRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  driverId                  String
  driver                    TransportDriver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  kind                      TransportPayslipKind   @default(ORIGINAL)
  status                    TransportPayslipStatus @default(DRAFT)
  grossEarnings             BigInt
  totalDeductions           BigInt
  netAmount                 BigInt
  currencyCode              String                 @default("VND") @db.VarChar(3)
  /// `GD-12` — THONG TIN. NULL khi khach tat `transport-costing`, va `null` KHAC `0`.
  driverFundBalanceSnapshot BigInt?
  /// Dau vao tat dinh da dung, chup lai: so chuyen va tong km trong ky.
  tripCount                 Int
  distanceKm                Int
  /// Ban goc ma phieu nay sua. NULL o `ORIGINAL`.
  correctsId                String?
  corrects                  TransportPayslip?      @relation("TransportPayslipCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy               TransportPayslip[]     @relation("TransportPayslipCorrection")
  correctionReason          String?
  approvedAt                DateTime?
  approvedBy                String?
  paidAt                    DateTime?
  paidBy                    String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  components         TransportPayslipComponent[]
  /// `TX-07b` — cac lan rut tien da lay tu phieu nay. Tong cua chung la "da rut bao nhieu"; KHONG
  /// co cot `cashedOutAmount` tren phieu, cung ly le voi `INV-01` cua `TX-03`.
  cashoutAllocations TransportDriverCashoutAllocation[]

  @@index([runId])
  @@index([driverId, status])
  @@index([correctsId])
}

/// MOT DONG tren phieu luong. T1 §5: component CHI TRINH BAY, khong phai nguon su that cua so du
/// nao — no khong bao gio ghi vao so quy lai xe.
model TransportPayslipComponent {
  id         String                          @id @default(cuid())
  payslipId  String
  payslip    TransportPayslip                @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind       TransportPayslipComponentKind
  source     TransportPayslipComponentSource
  label      String
  /// DUONG, luon. Chieu nam o `kind`. Mot so am o day se lam mot `DEDUCTION` am thanh mot khoan cong
  /// tra hinh — dung kieu nham lan ma bang phan quyen khong bao gio noi len duoc.
  amount     BigInt
  /// Can cu tinh, de truy nguoc: so chuyen, so km, so lit tiet kiem. NULL o khoan thu cong.
  quantity   Int?
  /// Don gia da dung, so nguyen dong. NULL o khoan thu cong.
  unitAmount BigInt?
  /// Nguoi ky cho `MANUAL_*`. NULL o thanh phan tinh tu dong.
  recordedBy String?
  note       String?
  createdAt  DateTime                        @default(now())

  @@index([payslipId])
}

// ----- Transport domain: xuong song danh tinh doi tac (R1-A, Issue #230) -----
//
// CANH BAO — RANG BUOC CUA R1-A KHONG CO O DAY. Chung song trong SQL tho cua migration
// `20260907140000_transport_counterparty`, vi Prisma khong co cu phap cho `CHECK`:
//
//     1. `TransportCounterparty_name_not_blank`  — ten phap nhan khong duoc rong hay toan khoang trang
//     2. `TransportCounterparty_taxCode_shape`   — ma so thue Viet Nam: 10 chu so, hoac 10-3 chu so
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// hai. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong `DROP CONSTRAINT` truoc khi
// commit — dung nhu canh bao da co o cac dau muc Transport phia tren.
// `transport-counterparty-storage.spec.ts` doc chinh tep migration va do neu mot ten bien mat.
//
// -----------------------------------------------------------------------------------------------
// VI SAO MOT XUONG SONG chu khong gop ba bang ben lam mot:
//
// R0 (`docs/kien-truc/transport-domain-v2.md` §2 `F-03`) do lai va thay da vai DA CO —
// `TransportPartnerRole` khoa kep `(partnerId, role)` la dung mau. Cai KHONG co la danh tinh: mot
// to chuc vua thue van chuyen vua chay ho hom nay phai ton tai HAI hang o HAI bang
// (`TransportCustomer` + `TransportPartner`), va khong gi noi chung lai.
//
// Gop ba bang lam mot se phai doi khoa ngoai cua cac bang tai chinh dang co du lieu that, va pha
// chinh ly do ba bang ton tai (T1 §9.1 xep nam luong cong no thanh nam so, nguon khong dong nhat).
// Nen day la mot bang DANH TINH cong them, khong hang nao cua v1 phai doi.
//
// -----------------------------------------------------------------------------------------------
// `subjectId` CO Y KHONG PHAI KHOA NGOAI.
//
// No tro toi HAI bang khac nhau tuy `kind`, va Prisma/Postgres khong co khoa ngoai da dich. Tinh
// hop le duoc kiem o tang mien qua `CounterpartySubjectPort`, ma tang lap rap hien thuc bang dung
// nhung kho DANG BAT — nen lien ket toi mot loai chu the chua co adapter bi tu choi CO TEN
// (`SUBJECT_KIND_UNAVAILABLE`), chu khong im lang.
//
// Cai gia phai tra: xoa mot `TransportCustomer` khong tu don lien ket. Chap nhan duoc vi mien nay
// khong co duong xoa cung nao cho mot ben doi tac — `GD-02` da chot huy thay xoa.

/// LOAI CHU THE ma mot lien ket danh tinh tro toi.
///
/// R1-A chi khai HAI gia tri, va do la co y: nhu cau co nguon la A/C — mot to chuc vua la khach
/// thue vua la nha xe/nguon don. Cay xang (`TransportFuelSupplier`) KHONG duoc them vao day khi
/// chua ai can, vi T1 §9.1 coi nhien lieu la mot NGUON RIENG chu khong phai mot vai doi tac. Them
/// sau la mot `ALTER TYPE ... ADD VALUE`, tuc cong them va re.
enum TransportCounterpartySubjectKind {
  CUSTOMER
  PARTNER
}

/// PHAP NHAN trong doi that — thu ma ba bang ben chi la ba MAT cua no.
///
/// `taxCode` unique khi co: o Viet Nam ma so thue la danh tinh manh nhat cua mot doanh nghiep, va
/// hai hang cung ma so thue gan nhu chac chan la mot lan nhap trung. NULL duoc phep vi ho kinh
/// doanh ca the va CTV khong phai luc nao cung co.
model TransportCounterparty {
  id        String               @id @default(cuid())
  name      String
  taxCode   String?              @unique
  status    TransportPartyStatus @default(ACTIVE)
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  links       TransportCounterpartyLink[]
  /// `#267` H1: cac dia diem van hanh vat ly cua phap nhan nay.
  sites       TransportCounterpartySite[]
  /// Lane I (#268): cac ho so nghiem thu ghi nhan phap nhan nay la ben A.
  acceptances TransportCommercialAcceptance[]

  @@index([status])
}

/// LIEN KET mot hang chuyen mon voi phap nhan so huu no.
///
/// Khoa chinh kep `(kind, subjectId)` lam DUNG MOT viec, va do la bat bien cua ca tranche: mot
/// hang chuyen mon thuoc TOI DA MOT phap nhan. Neu day la mot `id` roi mot unique khac, thi lan
/// ghi thu hai se tao ban sao thu hai cua cung mot khach duoi hai phap nhan, va bao cao cong no
/// gop theo phap nhan se dem doi.
///
/// KHONG unique tren `(counterpartyId, kind)`: mot phap nhan duoc phep gom NHIEU hang cung loai —
/// do chinh la cach hop nhat hai ban ghi khach bi nhap trung ma khong phai xoa hang nao.
model TransportCounterpartyLink {
  counterpartyId String
  counterparty   TransportCounterparty            @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  kind           TransportCounterpartySubjectKind
  subjectId      String
  linkedBy       String
  createdAt      DateTime                         @default(now())

  @@id([kind, subjectId])
  @@index([counterpartyId])
}

// ===================================================================
// TX-09 DIA DIEM VAN HANH — mot phap nhan, nhieu cho lam viec (Lane H, Issue #267)
// ===================================================================
//
// CANH BAO — RANG BUOC CUA TX-09 KHONG NAM O DAY. Chung song trong SQL tho cua migration
// `20260909230000_transport_counterparty_site`, vi Prisma khong co cu phap cho `CHECK`:
//
//     1. `TransportCounterpartySite_name_not_blank`     — ten dia diem khong duoc rong
//     2. `TransportCounterpartySite_address_not_blank`  — dia chi NULL duoc, rong thi khong
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// hai. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong `DROP` truoc khi commit.
// `transport-counterparty-site-storage.spec.ts` doc chinh tep migration va do neu mot ten bien mat.
//
// -----------------------------------------------------------------------------------------------
// VI SAO CAN MOT BANG MOI, VA VI SAO NO KHONG PHAI MOT PHAP NHAN THU HAI
//
// `#267` H1 dat dung mot cau hoi: mo hinh dang duoc chap nhan co dien ta duoc *"a real company
// with multiple pickup sites"* khong. Cau tra loi la KHONG, va cho hong khong hien nhien:
//
//   · `TransportCounterparty` la PHAP NHAN — no khong co toa do, va khong nen co: mot cong ty co
//     ba kho thi khong co "toa do cua cong ty";
//   · `TransportGeofence` co toa do nhung khong co TEN CHO lan DIA CHI, va `label` cua no la mot
//     nhan de nguoi truc doc, khong phai mot danh tinh de doi chieu;
//   · nhan ba kho thanh ba `TransportCounterparty` se lam bao cao cong no gop theo phap nhan dem
//     ba lan mot khach — dung dieu ma khoa chinh kep cua `TransportCounterpartyLink` sinh ra de
//     chan.
//
// Nen bang nay la MOT CHO LAM VIEC, khong phai mot phap nhan: no khong mang ma so thue, khong mang
// dieu khoan thanh toan, khong mang mot truong tien nao. Cau hoi no tra loi la *"xe dang dung o
// dau"*, khong phai *"hoa don xuat cho ai"*.
//
// -----------------------------------------------------------------------------------------------
// HANG RAO TRO VAO DAY, KHONG PHAI NGUOC LAI — mot chieu, va do la co y.
//
// `TransportGeofence.subjectKind = COUNTERPARTY_SITE` + `subjectId = <site.id>` la duong DUY NHAT
// noi mot dia diem voi hinh hoc cua no. Mot cot `geofenceId` tren bang nay se la duong THU HAI cho
// cung mot quan he, va tu lan lech dau tien khong ai biet ben nao dung — cung ly le da ghi o
// `TransportAssetStakeholder` ve viec khong them `counterpartyId` khong khoa ngoai.
//
// He qua duoc chap nhan: mot dia diem co the co 0 hang rao (biet cho do nhung chua ve vong), va co
// the co N (cong + bai can). Ca hai deu dung. `resolveSiteCandidates()` gom theo `siteId`, nen hai
// hang rao cua mot kho khong bien thanh hai lua chon.
//
// -----------------------------------------------------------------------------------------------
// KHONG CO BI DANH/MA DIA DIEM. `#267` H1 viet ro *"site aliases/codes only if evidenced"*, va
// chua ai dua ra mot bang ma kho nao. Them mot cot rong de "sau nay dung" la them mot cho de mot
// lan nhap tay tro thanh nguon su that thu hai cho ten mot cai kho.

/// MOT CHO LAM VIEC VAT LY cua mot phap nhan — `#267` H1.
///
/// `onDelete: Restrict` tren `counterparty`: mot phap nhan con dia diem thi khong xoa cung duoc.
/// Duong nghi viec la `status = INACTIVE`, cung khuon `GD-02` (huy thay xoa) da dung o khap mien.
model TransportCounterpartySite {
  id             String                @id @default(cuid())
  counterpartyId String
  counterparty   TransportCounterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  /// TEN CHO ma lai xe doc duoc tren man hinh: "Kho Hai Phong", "Nha may Que Vo 2".
  name           String
  /// Dia chi hanh chinh. NULL nghia la CHUA NHAP, khong phai "khong co dia chi".
  address        String?
  status         TransportPartyStatus  @default(ACTIVE)
  note           String?
  /// `authUserId` cua nguoi khai. Moi lan doi di qua `AuditLogService`.
  recordedBy     String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  /// `#267` H3/H4: cac lan lai xe nhan viec tai dia diem nay.
  intakes TransportRunSiteIntake[]

  /// Hai kho cua CUNG mot cong ty khong duoc trung ten: man hinh lai xe chi hien ten, nen hai
  /// dong chu giong het nhau la hai lua chon khong phan biet duoc.
  @@unique([counterpartyId, name], map: "TransportCounterpartySite_counterparty_name_key")
  @@index([counterpartyId, status])
  @@index([status])
}

// ===================================================================
// TX-10 NHAN VIEC TAI DIA DIEM A — cham xac nhan cua lai xe (Lane H, Issue #267 H3/H4)
// ===================================================================
//
// CANH BAO — RANG BUOC CUA TX-10 KHONG NAM O DAY. Chung song trong SQL tho cua migration
// `20260909230200_transport_run_site_intake`:
//
//     1. `TransportRunSiteIntake_businessDate_iso`    — ngay nghiep vu dang YYYY-MM-DD
//     2. `TransportRunSiteIntake_clientEventId_shape` — khoa chong lap khong duoc rong
//     3. `TransportRunSiteIntake_trust_shape`         — SERVER_BOUND thi PHAI co ban dinh vi
//     4. `transport_run_site_intake_append_only` (TRIGGER) — khong UPDATE, khong DELETE
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// bon. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong do truoc khi commit.
//
// -----------------------------------------------------------------------------------------------
// BANG NAY LA CAI CHAM CUA CON NGUOI, VA DO LA LY DO DUY NHAT NO TON TAI.
//
// `#267` mo dau bang mot cau cam: *"No trip/run may be silently auto-created solely because a
// device entered a geofence."* Mot cau cam thi khong tu no thanh mot bao dam — phai co cho de doc
// lai rang lan tao NAY da co mot con nguoi bam vao no.
//
// Nen bang nay ghi dung ba dieu ma `TransportVehicleRun` khong cho nao de ghi:
//
//   · AI da bam    -> `confirmedBy` (authUserId tu phien) + `driverId`;
//   · O DAU        -> `siteId`, tuc mot dia diem CO THAT da khai truoc do, khong phai mot chuoi;
//   · TIN DEN DAU  -> `locationTrust` + `observationId`.
//
// Bo bang nay di thi vong chay van chay, chi khong ai con tra loi duoc cau "vi sao no ton tai".
//
// -----------------------------------------------------------------------------------------------
// `locationTrust` — HAI GIA TRI, VA CHUNG KHONG BAO GIO DUOC GOP.
//
// `SERVER_BOUND` la ban dinh vi cua Lane B: no di qua mot phien bam vi tri co chu, qua kiem bien,
// qua tang cham rui ro, va no KHONG SUA DUOC. `DRIVER_REPORTED` la cap so ma dien thoai vua doc
// len — no chua di qua gi ca.
//
// Ca hai deu duoc phep TAO mot lan nhan viec, va do khong phai mot lo hong: thu cho phep tao la
// CHAM CUA CON NGUOI, khong phai toa do. Lai xe dang dung o cong nha may va noi "dung, day la kho
// Hai Phong" — do la mot loi khai truc tiep, va no khong yeu hon vi dien thoai chua kip mo phien
// bam vi tri.
//
// Cai KHONG duoc phep la de mot cap so cua may khach di vao cho ma he thong doi mot BANG CHUNG:
// `TransportRunCheckpoint.observationId` va `TransportOperationalProof.observationId` deu la khoa
// ngoai tro thang vao `TransportLocationObservation`, va khong duong nao o day sinh ra mot hang
// dinh vi. Mot lan nhan viec `DRIVER_REPORTED` de lai dung nhan do trong so — nguoi doi soat sau
// nay doc duoc rang cho nay chua tung co bang chung vi tri.
//
// -----------------------------------------------------------------------------------------------
// VI SAO `(driverId, clientEventId)` LA KHOA CHONG LAP, CHU KHONG PHAI `(runId, ...)`.
//
// Khoa phai chan duoc lan ghi THU HAI *truoc khi* co vong chay thu hai. Mot khoa co `runId` chi
// hinh thanh SAU khi vong chay da duoc tao — tuc dung sau cai ma no dang tim cach chan. Cham hai
// lan hay mot hang doi ngoai tuyen phat lai deu mang CUNG `clientEventId`, va lan thu hai dung o
// unique nay chu khong di tiep.

/// MUC DO TIN CUA VI TRI da de nghi ra mot lan nhan viec — `#267` H2/H7.
enum TransportSiteIntakeLocationTrust {
  /// Ban dinh vi cua Lane B (`TransportLocationObservation`) — da qua phien, kiem bien va cham rui ro.
  SERVER_BOUND
  /// Cap toa do may khach doc len, CHUA qua duong chung cu nao. Chi de DE NGHI.
  DRIVER_REPORTED
}

/// MOT LAN LAI XE XAC NHAN "toi dang o day, tao chuyen" — `#267` H3/H4.
///
/// GHI THEM, KHONG GHI DE, KHONG XOA: trigger `transport_run_site_intake_append_only` chan moi
/// `UPDATE`/`DELETE`. Cung nguyen tac voi `TransportRunCheckpoint` cua `#243` F1 — mot lan bam
/// nham duoc sua bang cach HUY vong chay (`cancelRun`, co ly do bang chu), khong bang cach doi
/// hang nay.
model TransportRunSiteIntake {
  id             String                           @id @default(cuid())
  /// MOT vong chay co NHIEU NHAT mot lan nhan viec. Day la bat bien chan trung o tang luu tru.
  runId          String                           @unique
  run            TransportVehicleRun              @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// Chang dau tien, tao cung luc. `#243` F1 gan moc cong/boc hang vao CHANG, nen khong co chang
  /// thi lai xe khong ghi duoc mot moc nao — tuc man hinh ke tiep khong co gi de bam.
  legId          String                           @unique
  leg            TransportRunLeg                  @relation(fields: [legId], references: [id], onDelete: Restrict)
  /// Dia diem A da duoc xac nhan. `Restrict`: mot kho da tung sinh ra vong chay thi khong bo duoc.
  siteId         String
  site           TransportCounterpartySite        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  driverId       String
  driver         TransportDriver                  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  /// `authUserId` cua chinh cham xac nhan — khong tu than yeu cau.
  confirmedBy    String
  locationTrust  TransportSiteIntakeLocationTrust
  /// MOT ban dinh vi phuc vu NHIEU NHAT mot lan nhan viec — cung khuon `TransportRunCheckpoint`.
  observationId  String?                          @unique
  observation    TransportLocationObservation?    @relation(fields: [observationId], references: [id], onDelete: Restrict)
  /// Khoang cach tu vi tri de nghi toi tam hang rao, met, lam tron. NULL khi khong do duoc.
  distanceMetres Int?
  /// Khoa chong lap do may khach sinh.
  clientEventId  String
  confirmedAt    DateTime                         @default(now())
  businessDate   String                           @db.VarChar(10)
  createdAt      DateTime                         @default(now())

  @@unique([driverId, clientEventId], map: "TransportRunSiteIntake_driver_event_key")
  @@index([siteId, businessDate])
  @@index([businessDate])
}

// ===================================================================
// TX-07b DRIVER SETTLEMENT — lan rut tien cua lai xe + phan bo (Lane D, Issue #237)
// ===================================================================
//
// CANH BAO — RANG BUOC CUA TX-07b KHONG CO O DAY. Chung song trong SQL tho cua migration
// `20260908120000_transport_driver_settlement`, vi Prisma khong co cu phap cho `CHECK`/`TRIGGER`:
//
//     1. `TransportDriverCashout_businessDate_iso`          — ngay nghiep vu dang YYYY-MM-DD
//     2. `TransportDriverCashout_method_not_blank`          — hinh thuc chi khong duoc rong
//     3. `TransportDriverCashout_reversal_shape`            — dao thi phai tro ve ban goc + co ly do
//     4. `TransportDriverCashout_no_self_reversal`          — mot phieu khong tu dao chinh no
//     5. `TransportDriverCashoutAllocation_money_range`     — khoang tien +-(2^53-1), khac 0
//     6. `TransportDriverCashoutAllocation_source_shape`    — WAGE co phieu luong, hoan ung co but toan
//     7. `transport_driver_cashout_immutable` (TRIGGER)     — phieu da ghi chi doi duoc `status`
//     8. `transport_driver_cashout_allocation_frozen`       — dong phan bo khong sua, khong xoa
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// tam. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong `DROP` truoc khi commit.
// `transport-driver-settlement-storage.spec.ts` doc chinh tep migration va do neu mot ten bien mat.
//
// -----------------------------------------------------------------------------------------------
// VI SAO KHONG CO BANG "KHOAN GHI NHAN" (`SettlementCredit`) — day la quyet dinh trung tam.
//
// #237 mo ta `monthly payroll credits + approved reimbursement payable -> available balance`. Phan
// xa dau tien la dung mot bang `credit` roi ghi mot hang moi khi phieu luong duoc duyet. Bang do se
// mang mot BAN SAO cua `TransportPayslip.netAmount` — tuc SO TIEN LUONG TON TAI O HAI CHO. Ke tu
// lan lech dau tien giua hai cho do, khong ai con biet ben nao dung, va #237 doi dung dieu nguoc
// lai: *"no double counting between Driver Fund, fuel AP and reimbursement"*.
//
// Nen o day KHONG co bang credit. Hai nguon tien da la hai so cai CO SAN, ca hai deu bat bien:
//
//   · luong    -> `TransportPayslip` (da co trigger `..._posted_immutable` dong bang tu `APPROVED`)
//   · hoan ung -> so du AM cua `TransportDriverFundAccount` (`DA-T3-01`, `describeFundBalance`)
//
// Cai THUC SU thieu — va R0 §1.4 do dung mot dong: *"Chi tra / Disbursement: CHUA CO"* — la ben
// CHI. Nen tranche nay them dung ben do, va khong hang nao cua `TX-03`/`TX-07` phai doi.
//
// -----------------------------------------------------------------------------------------------
// VI SAO MOT LAN CHI HOAN UNG PHAI GHI MOT BUT TOAN QUY:
//
// So du quy AM nghia la lai xe DANG bo tien tui (`COMPANY_OWES_DRIVER`). Khi cong ty tra lai so do,
// lai xe khong con bo tien nua — nen so du phai ve gan 0. Neu lan chi chi duoc ghi o bang nay ma
// khong cham vao so quy, thi so quy se VINH VIEN noi rang cong ty con no, va lan doi soat sau se
// tra mot lan nua. Do la dung nghia dem hai lan mot khoan tien, chi khac la no nam o hai bang.
//
// Vi vay `TransportDriverCashoutAllocation.driverFundEntryId` la BAT BUOC voi
// `source = REIMBURSEMENT`, va `@unique`: mot but toan hoan ung khong the la chan tien cua hai
// lan chi. Cung khuon `TransportTripExpense.driverFundEntryId` cua `TX-03`.

/// LOAI PHIEU CHI. `REVERSAL` tro nguoc ve ban goc qua `reversesId` — khong co duong `DELETE` nao.
enum TransportDriverCashoutKind {
  ORIGINAL
  REVERSAL
}

/// TRANG THAI QUAN TRI cua mot phieu chi. Chi doi duoc theo MOT canh: `POSTED -> REVERSED`.
enum TransportDriverCashoutStatus {
  POSTED
  REVERSED
}

/// NGUON TIEN ma mot dong phan bo rut ra.
///
/// HAI gia tri, va chung KHONG duoc gop du cung nam tren mot phieu chi. #237: *"same cash-out may
/// include reimbursement, but allocation/provenance stays separate"* va *"do not call reimbursement
/// salary"*. Mot cot `source` co kieu la cach re nhat de cau do dung duoc o tang du lieu thay vi o
/// tang giao dien: khong truy van nao co the vo tinh cong hai nguon lai ma khong go ten chung ra.
enum TransportDriverCashoutAllocationSource {
  /// Rut tu tien luong da ghi nhan tren mot phieu luong da chot. `payslipId` BAT BUOC.
  WAGE
  /// Nhan lai khoan da bo tui. `driverFundEntryId` BAT BUOC. KHONG PHAI LUONG.
  REIMBURSEMENT
}

/// MOT LAN LAI XE NHAN TIEN — su kien chi, khong phai mot khoan ghi nhan.
///
/// `TransportPayslip` tra loi "thang nay lai xe duoc bao nhieu"; bang nay tra loi "lai xe da nhan
/// bao nhieu, luc nao, bang duong nao, va rut tu nhung thang nao". Hai cau hoi khac nhau, hai bang.
///
/// KHONG CO COT `totalAmount`, va do la `INV-01` doc lai lan thu ba trong repo nay: tong cua mot
/// phieu chi la KET QUA cong `allocations`. Mot o tong ghi de duoc se lech voi cac dong ngay lan
/// dau co mot loi giua hai lenh ghi, va tu do khong con cach nao biet ben nao dung.
///
/// KHONG CO VONG DOI YEU CAU (`REQUESTED -> APPROVED -> PAID`). Hom nay khong nguon nao mo ta lai
/// xe yeu cau rut tien qua he thong — ho noi voi ke toan. Dung len mot quy trinh duyet o day la
/// bia mot buoc nghiep vu; #232 §9.5 goi do la dieu phai dung lai. Khi B mo ta quy trinh that,
/// them mot bang yeu cau tro toi phieu nay la mot buoc cong them, khong phai mot lan viet lai.
model TransportDriverCashout {
  id             String                       @id @default(cuid())
  driverId       String
  driver         TransportDriver              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  kind           TransportDriverCashoutKind   @default(ORIGINAL)
  status         TransportDriverCashoutStatus @default(POSTED)
  /// `INV-25` — NGAY nghiep vu tien roi khoi cong ty, khong phai khoanh khac ghi may.
  businessDate   String                       @db.VarChar(10)
  currencyCode   String                       @default("VND") @db.VarChar(3)
  /// Hinh thuc chi — "CASH", "BANK_TRANSFER". Van ban tu do, cung khuon
  /// `TransportSettlementAllocation.method` cua `TX-05`: danh muc nay la thu tung khach mot khac.
  method         String                       @db.VarChar(40)
  /// So tham chieu ngan hang / so phieu chi. `GD-16` — CHI la mot so tham chieu.
  reference      String?
  /// Ban goc ma phieu nay dao. NULL o `ORIGINAL`. `@unique`: mot phieu chi dao DUNG MOT LAN.
  reversesId     String?                      @unique
  reverses       TransportDriverCashout?      @relation("TransportDriverCashoutReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     TransportDriverCashout?      @relation("TransportDriverCashoutReversal")
  reversalReason String?
  note           String?
  /// Chong ghi trung — cung khuon `TransportDriverFundEntry.correlationKey` cua `TX-03`. Khoa cua
  /// but toan hoan ung sinh ra tu khoa nay, nen mot lan gui lai KHONG tao them mot but toan quy.
  correlationKey String                       @unique
  recordedBy     String
  createdAt      DateTime                     @default(now())

  allocations TransportDriverCashoutAllocation[]

  @@index([driverId, businessDate])
  @@index([driverId, status])
}

/// MOT DONG PHAN BO — "phan nay cua lan chi lay tu dau".
///
/// `amount` CO DAU, va do la cung bai hoc voi `TransportTripExpense.signedAmount` cua `TX-03`: mot
/// phieu dao mang cac dong AM doi dau ban goc, nen phep "da rut bao nhieu" luon la MOT phep cong
/// duy nhat. Neu dao la mot co `boolean` tren phieu, thi moi truy van tong se phai nho loai tru
/// cac phieu da dao — va lan quen dau tien cho ra mot lai xe da rut gap doi thuc te.
///
/// `payslipId` la NGUON GOC THANG cua so tien. Mot lan chi phu ba thang la BA dong o day, khong
/// phai mot dong 3 thang: #237 doi *"monthly source-period provenance remains immutable/visible"*,
/// va mot tong gop lai thi khong con doc nguoc ra thang nao nua.
model TransportDriverCashoutAllocation {
  id                String                                 @id @default(cuid())
  cashoutId         String
  cashout           TransportDriverCashout                 @relation(fields: [cashoutId], references: [id], onDelete: Restrict)
  source            TransportDriverCashoutAllocationSource
  /// So nguyen dong CO DAU. Duong o `ORIGINAL`, am o `REVERSAL`. Khoang bi `CHECK` bo hep cho khop
  /// `money()`.
  amount            BigInt
  /// BAT BUOC khi `source = WAGE`, NULL khi `REIMBURSEMENT`. Cuong che bang `CHECK`.
  payslipId         String?
  payslip           TransportPayslip?                      @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  /// BAT BUOC khi `source = REIMBURSEMENT`, NULL khi `WAGE`. Cuong che bang `CHECK`.
  /// `@unique` — mot but toan quy khong the la chan tien mat cua hai dong phan bo.
  driverFundEntryId String?                                @unique
  driverFundEntry   TransportDriverFundEntry?              @relation(fields: [driverFundEntryId], references: [id], onDelete: Restrict)
  note              String?
  createdAt         DateTime                               @default(now())

  @@index([cashoutId])
  @@index([payslipId])
  @@index([source])
}

// ----- Van chuyen v2: NGHIA VU THUONG MAI vs VONG CHAY VAT LY (R1-B, #232 D-01 / #234 A1) -----
//
// HAI TRUC DOC LAP. Day la quyet dinh cua chu so huu (#232 §1 `D-01`), va no dao lai phan quyet
// hoan cua R0 (`F-04`/`Q-01` trong `docs/kien-truc/transport-domain-v2.md`): R0 hoan vi CHUA co
// mot su kien nguon nao ve chieu rong; #232 `D-01` chinh la su kien do, cap boi chu so huu.
//
//   `TransportOrder`      = NGHIA VU THUONG MAI. Ai thue, cho gi, tu dau den dau, bao nhieu tien.
//   `TransportVehicleRun` = VONG CHAY VAT LY cua MOT xe. Xe roi bai, chay may chang, ve.
//   `TransportRunLeg`     = MOT chang cua mot vong chay. `LOADED` co the tro toi mot don;
//                           `EMPTY` (chay rong / deadhead) KHONG duoc tro toi don nao.
//
// Vi du hai chang ma #234 doi phai chay duoc:
//
//     TransportVehicleRun R1 (xe 29C-12345)
//     +- RunLeg 1  HN -> HP  LOADED  order = A
//     +- RunLeg 2  HP -> HN  EMPTY   order = NULL
//
// -----------------------------------------------------------------------------------------------
// QUAN HE VOI `TransportTrip` — KHONG cha, KHONG con.
//
// `D-01` ghi ro: mot Order va mot Run KHONG phai ban thay the cha/con truc tiep cua `TransportTrip`.
// Nen o day KHONG co cot `tripId` tren `TransportVehicleRun`, va KHONG co cot `runId` tren
// `TransportTrip`. Cai noi hai the gioi la mot bang TUONG UNG rieng — `TransportTripRunLegLink` —
// dung mau da co cua `TransportCounterpartyLink`: bo no di la ca hai truc van chay nguyen ven.
//
// `TransportTrip` giu nguyen cac quan he dang co du lieu that tren `transport-preview/gd1-test`,
// gom chuyen UAT `UAT-VIET-01`. Migration cua khoi nay CHI THEM: bon enum, bon bang; khong mot
// `ALTER TABLE` nao doi cot cua bang cu — bang moi tro khoa ngoai VAO chung, khong nguoc lai.
//
// -----------------------------------------------------------------------------------------------
// RANG BUOC SONG TRONG SQL THO (Prisma khong co cu phap), xem
// `20260907190000_transport_movement/migration.sql` va `transport-movement-storage.spec.ts`:
//
//   · `TransportRunLeg_empty_carries_no_order`  — chang EMPTY khong duoc co `orderId`. Day la BAT
//     BIEN cua ca tranche: neu no chi song o tang mien thi mot lan ghi thang DB lam km rong sai.
//   · `TransportRunLeg_sequence_positive`       — thu tu chang bat dau tu 1.
//   · `TransportRunLeg_distance_non_negative`   — km khong am.
//   · `TransportOrder_freightAmount_money_range`— cung khoang voi `money()`, nhu `TransportTrip`.
//   · `TransportOrder_code_not_blank` / `TransportVehicleRun_code_not_blank`
//   · `TransportRunAssignment_activeRun_key`    — unique MOT PHAN, mot ban phan cong DANG hieu luc
//     cho moi vong chay. Cung mau va cung ly do voi `TransportTripAssignment_activeTrip_key`.
// -----------------------------------------------------------------------------------------------

/// VONG DOI cua mot NGHIA VU THUONG MAI. Ba trang thai, khong hon.
///
/// KHONG co trang thai `SETTLED`/`INVOICED`: cong no va chung tu da co nguon su that rieng
/// (`TransportSettlementDocument`, T1 §9.1). Them mot trang thai thanh toan o day la tao nguon su
/// that thu hai cho cung mot cau hoi.
enum TransportOrderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

/// VONG DOI cua mot vong chay cua xe.
enum TransportVehicleRunStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// LOAI CHANG — day la truc ma toan bo phan tich km rong dua vao.
///
/// `EMPTY` la chay rong/deadhead. Hai gia tri, khong ba: mot chang hoac dang cho hang cua mot
/// nghia vu, hoac khong. Moi sac thai khac (chay ve bai, di lay vo, dieu xe) van la `EMPTY` cho
/// toi khi co mot nguon nghiep vu doi phan biet chung.
enum TransportRunLegKind {
  LOADED
  EMPTY
}

enum TransportRunLegStatus {
  PLANNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// NGHIA VU THUONG MAI — mot don van chuyen ma khach da dat.
///
/// Doc lap voi `TransportVehicleRun`: mot don ton tai truoc khi biet xe nao chay no, va co the
/// khong bao gio duoc chay bang xe cua minh. Quan he don/chang nam o `TransportRunLeg.orderId` va
/// la MOT-NHIEU: mot don co the trai tren nhieu chang (chuyen tai, ghep xe), con mot chang co hang
/// chi phuc vu MOT nghia vu.
///
/// `customerId` tro thang toi `TransportCustomer` chu KHONG toi `TransportCounterparty`: danh tinh
/// phap nhan da co duong doc rieng qua `TransportCounterpartyLink` (R1-A). Them mot khoa ngoai
/// danh tinh thu hai o day la tao hai duong tra loi cung mot cau hoi "don nay cua ai".
model TransportOrder {
  id                 String               @id @default(cuid())
  /// MA DOC DUOC ma nguoi dung go, khong phai `cuid`. Cung vai tro voi `TransportTrip.code`.
  code               String               @unique
  status             TransportOrderStatus @default(OPEN)
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate       String               @db.VarChar(10)
  customerId         String?
  customer           TransportCustomer?   @relation(fields: [customerId], references: [id])
  originLabel        String
  destinationLabel   String
  cargoDescription   String?
  /// DOANH THU — gia cuoc thu khach, SO NGUYEN DONG. `BigInt` = `BIGINT` chu khong `INTEGER`, cung
  /// ly do da ghi o `TransportTrip.freightAmount`: `INTEGER` tran o 2.147.483.647 dong.
  freightAmount      BigInt?
  currencyCode       String               @default("VND") @db.VarChar(3)
  note               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  /// `GD-02` — huy THAY CHO xoa. Khong co duong xoa cung nao cho mot nghia vu.
  cancelledAt        DateTime?
  cancellationReason String?

  legs                     TransportRunLeg[]
  /// #276 L2/L3: lan lap ke hoach da gan don nay vao mot vong chay. TOI DA MOT ban con hieu luc —
  /// xem unique mot phan `TransportOrderRunPlan_activeOrder_key` trong SQL tho.
  runPlans                 TransportOrderRunPlan[]
  /// `#275` Lane K: ho so KET THUC THUONG MAI cua don nay. TOI DA MOT — xem `orderId @unique`.
  completion               TransportCommercialAcceptance?
  /// `#275` K5: chuyen v1 da chieu ra don nay, neu co. TOI DA MOT.
  tripLink                 TransportTripOrderLink?
  /// Lane Q: ket qua A xac nhan duy nhat; sua tien qua settlement adjustment/reversal hien co.
  customerReconciliation   TransportCustomerReconciliation?
  reconciliationBatchLines TransportCustomerReconciliationBatchLine[]

  @@index([status])
  @@index([businessDate])
  @@index([customerId])
}

/// VONG CHAY VAT LY cua MOT xe.
///
/// `vehicleId` la cot BAT BUOC va nam tren chinh bang nay, khong o bang phan cong: mot vong chay
/// LA vong chay cua mot chiec xe cu the — doi xe giua chung la mot vong chay khac. Lai xe thi
/// nguoc lai, doi duoc giua chung, nen no o `TransportRunAssignment` dang LICH SU.
model TransportVehicleRun {
  id                 String                    @id @default(cuid())
  code               String                    @unique
  vehicleId          String
  vehicle            TransportVehicle          @relation(fields: [vehicleId], references: [id])
  status             TransportVehicleRunStatus @default(PLANNED)
  /// Ngay nghiep vu MO vong chay.
  businessDate       String                    @db.VarChar(10)
  startedAt          DateTime?
  completedAt        DateTime?
  note               String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?

  legs          TransportRunLeg[]
  assignments   TransportRunAssignment[]
  /// R1-C: de nghi chi gan vao vong chay nay.
  expenseClaims TransportExpenseClaim[]
  /// F1 (#243): moc van hanh cua vong chay nay.
  checkpoints   TransportRunCheckpoint[]
  /// `#267` H3/H4: lan lai xe xac nhan tai dia diem A da sinh ra vong chay nay. NHIEU NHAT mot.
  siteIntake    TransportRunSiteIntake?
  /// Lane I (#268), da THAY THE boi `#275`: ho so nghiem thu keo theo VONG CHAY. Khong con duong
  /// ghi nao dat no — chu the hien tai la `TransportOrder`. Giu lai de mot hang cu con doc duoc.
  acceptance    TransportCommercialAcceptance?
  /// Lane L (#276): cac lan lap ke hoach da dat don vao vong chay nay. NHIEU o che do
  /// `MULTI_ORDER_RUN`, DUNG MOT o che do `ONE_ORDER_PER_RUN` (cuong che bang unique mot phan).
  runPlans      TransportOrderRunPlan[]

  @@index([status])
  @@index([businessDate])
  @@index([vehicleId])
}

/// PHAN CONG LAI XE cho mot vong chay — `GD-06`: LICH SU, khong ghi de.
///
/// Cung hinh dang va cung ly do voi `TransportTripAssignment`: neu day la mot cot tren
/// `TransportVehicleRun` thi lan doi lai xe se xoa mat dau ai cam vo lang luc mot khoan chi phat
/// sinh. MOT ban hieu luc cho moi vong chay duoc cuong che O DB bang unique mot phan
/// `TransportRunAssignment_activeRun_key` (`WHERE "effectiveTo" IS NULL`) — khai trong SQL tho.
model TransportRunAssignment {
  id            String              @id @default(cuid())
  runId         String
  run           TransportVehicleRun @relation(fields: [runId], references: [id])
  driverId      String
  driver        TransportDriver     @relation(fields: [driverId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  assignedBy    String
  createdAt     DateTime            @default(now())

  @@index([runId, effectiveTo])
  @@index([driverId])
}

/// MOT CHANG cua mot vong chay. Day la hang ma phan tich km rong dem.
///
/// BAT BIEN TRUNG TAM: `kind = EMPTY` thi `orderId` PHAI la NULL. Cuong che o DB bang
/// `TransportRunLeg_empty_carries_no_order`, khong chi o tang mien — vi neu mot lan ghi thang DB
/// gan duoc mot don vao chang rong thi moi con so km rong/ty le rong sau do deu sai, va khong ai
/// biet no sai.
///
/// Chieu nguoc lai KHONG bi cam: mot chang `LOADED` duoc phep chua co `orderId` (dang cho hang
/// nhung don chua nhap xong). `D-01` viet "a loaded leg MAY reference an Order" — "may", khong
/// phai "must".
///
/// `distanceKm` nullable theo dung `GD-14` (km nhap tay). Doc gia phan tich KHONG duoc coi NULL la
/// 0: `summariseRunDistance()` dem rieng so chang thieu km va tra `complete = false`.
model TransportRunLeg {
  id                String                @id @default(cuid())
  runId             String
  run               TransportVehicleRun   @relation(fields: [runId], references: [id])
  /// Thu tu chang trong vong chay, bat dau tu 1. Duy nhat trong mot vong chay.
  sequence          Int
  kind              TransportRunLegKind
  status            TransportRunLegStatus @default(PLANNED)
  orderId           String?
  order             TransportOrder?       @relation(fields: [orderId], references: [id])
  originLabel       String
  destinationLabel  String
  businessDate      String                @db.VarChar(10)
  /// `GD-14` — nhap tay, nullable. NULL nghia la CHUA BIET, khong phai 0.
  ///
  /// Lane L (#276 L6) chot them: cot nay la QUANG DUONG DA GHI NHAN (nguon tay/odo/GPS). No KHONG
  /// bao gio duoc dien tu mot con so uoc luong — cho cua uoc luong la `plannedDistanceKm`.
  distanceKm        Int?
  /// #276 L6 — QUANG DUONG DU KIEN cua chang, do khau lap ke hoach (hoac sau nay la mot nha cung
  /// cap dan duong cua Lane M) dua ra.
  ///
  /// TACH KHOI `distanceKm` chu khong ghi de len no, va do la ca diem cua truong nay: L6 viet
  /// *"If route provider later supplies estimated distance, mark it estimated/planned. Actual
  /// distance may come from trusted GPS/odometer sources; do not overwrite raw source."* Mot con
  /// so uoc luong roi vao cot da ghi nhan se bien mot KE HOACH thanh mot QUANG DUONG DA DI ma
  /// khong ai phan biet duoc nua — va bao cao km rong sau do khong con la do dac.
  ///
  /// NULL van la CHUA BIET, khong phai 0 — cung quy uoc voi `distanceKm`.
  plannedDistanceKm Int?
  startedAt         DateTime?
  completedAt       DateTime?
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tripLink        TransportTripRunLegLink?
  /// #276 L2/L3: lan lap ke hoach da sinh ra chang CO HANG nay. NHIEU NHAT mot.
  planAsLoadedLeg TransportOrderRunPlan?   @relation("TransportOrderRunPlanLoadedLeg")
  /// #276 L3: lan lap ke hoach da sinh ra chang RONG di truoc. NHIEU NHAT mot.
  planAsEmptyLeg  TransportOrderRunPlan?   @relation("TransportOrderRunPlanEmptyLeg")
  /// R1-C: de nghi chi gan vao chang nay.
  expenseClaims   TransportExpenseClaim[]
  /// F1 (#243): moc van hanh gan vao chang nay.
  checkpoints     TransportRunCheckpoint[]
  /// `#267` H4: chang nay duoc tao boi mot lan nhan viec tai A. NHIEU NHAT mot.
  siteIntake      TransportRunSiteIntake?

  @@unique([runId, sequence])
  @@index([orderId])
  @@index([kind])
  @@index([businessDate])
}

/// BANG TUONG UNG giua mot chuyen v1 va mot chang v2. KHONG phai quan he cha/con.
///
/// `D-01` cam bien Run thanh cha hoac con truc tiep cua `TransportTrip`. Bang nay la cach giu ca
/// hai truc doc lap ma van tra loi duoc "chuyen cu nay hien ra o dau trong mo hinh moi": bo ca
/// bang di thi `TransportTrip` va `TransportVehicleRun` deu chay nguyen ven. Cung mau voi
/// `TransportCounterpartyLink`.
///
/// `tripId` la KHOA CHINH va `legId` la UNIQUE, nen quan he la MOT-MOT hai chieu: mot chuyen cu
/// chieu ra dung mot chang, va mot chang nhan nhieu nhat mot chuyen cu. Chinh cap rang buoc nay
/// lam phep chieu TAT DINH va LAP LAI DUOC — chay lai `projectTrip()` khong the sinh ban thu hai.
model TransportTripRunLegLink {
  tripId      String          @id
  trip        TransportTrip   @relation(fields: [tripId], references: [id])
  legId       String          @unique
  leg         TransportRunLeg @relation(fields: [legId], references: [id])
  projectedBy String
  createdAt   DateTime        @default(now())
}

/// BANG TUONG UNG giua mot chuyen v1 va mot NGHIA VU v2 — truc THUONG MAI.
///
/// Song song voi `TransportTripRunLegLink`, va CO Y la mot bang khac chu khong mot cot them vao
/// bang do. Hai cau hoi khac nhau, hai dieu kien khac nhau:
///
///   `TransportTripRunLegLink`  "chuyen cu nay hien ra o CHANG nao"   — doi mot chiec xe cua B
///   `TransportTripOrderLink`   "chuyen cu nay la NGHIA VU nao"       — chi doi mot khach hang
///
/// `planTripProjection` TU CHOI chieu chuyen `EXTERNAL_CARRIER` sang mot vong chay: xe khong phai
/// cua B. Nhung mot chuyen thue nha xe ngoai VAN co khach, VAN co bien nhan giao hang, va `#275`
/// K5 dat cong doi soat len DON — *"Order is the grain, so projection absence must not be an
/// authorization bypass"*. Neu chi co mot bang lien ket va no di qua vong chay, thi nhung chuyen do
/// vinh vien khong co chu the, va cong hoac chan mot duong dang chay hoac phai mo mot duong vong.
///
/// `tripId` la KHOA CHINH va `orderId` la UNIQUE, y het bang kia — nen phep chieu thuong mai cung
/// TAT DINH va LAP LAI DUOC: chay lai `projectTripOrder()` khong the sinh ban thu hai.
///
/// Bo ca bang di thi `TransportTrip` va `TransportOrder` deu chay nguyen ven. Cung mau voi
/// `TransportCounterpartyLink`.
model TransportTripOrderLink {
  tripId      String         @id
  trip        TransportTrip  @relation(fields: [tripId], references: [id])
  orderId     String         @unique
  order       TransportOrder @relation(fields: [orderId], references: [id])
  projectedBy String
  createdAt   DateTime       @default(now())
}

// ----- Van chuyen v2: DE NGHI CHI cua lai xe + duyet cua nguoi (R1-C, #232 D-06 / #234 A2) -----
//
// Duong tien hien tai (`TransportTripExpense` + `TransportDriverFundEntry`) ghi duoc moi khoan chi
// va sua duoc moi sai sot bang but toan dao. Cai no THIEU khong phai kha nang GHI, ma la mot
// CONG DUYET dat TRUOC khi mot de nghi cua lai xe tro thanh gia thanh that.
//
// `D-06`: phe duyet cua NGUOI la bat buoc truoc khi mot khoan lai xe de nghi thanh chi phi kinh
// doanh co tham quyen / thanh khoan quyet toan quy. Nen o day co dung hai bang:
//
//   `TransportExpenseClaim`          de nghi goc + trang thai hien tai
//   `TransportExpenseClaimDecision`  LICH SU QUYET DINH, chi ghi them, khong bao gio sua
//
// -----------------------------------------------------------------------------------------------
// VI SAO GIU CA SO DE NGHI LAN SO DUYET
//
// `claimedAmount` la con so lai xe de nghi; `approvedAmount` la con so ke toan duyet. Hom nay hai
// so LUON bang nhau -- `D-06` cho phep hien thuc duyet TRON KHOAN truoc, va duyet MOT PHAN van la
// an so nghiep vu (`Q-04`, chua ai quyet so bi cat di ve dau).
//
// Nhung hai CO cot ngay tu dau, va `CHECK` chi doi `approvedAmount <= claimedAmount` chu khong doi
// bang nhau. Nho vay khi `Q-04` co loi, duyet mot phan la mot lan noi long rang buoc -- KHONG phai
// mot lan viet lai lich su cua nhung de nghi da duyet.
//
// -----------------------------------------------------------------------------------------------
// NHIEN LIEU VA ETC KHONG BAO GIO DI DUONG NAY
//
// `D-05`: dau do o cay xang co hop dong la cong no cong ty, KHONG dung vao quy lai xe -- duong do
// da co san tu T4 (`TransportFuelEntry` + `fundedBy = COMPANY_DIRECT`). `D-07`: ETC la tien cong
// ty tra, va quy trinh quyet toan that cua khach CHUA AI BIET.
//
// De hai loai do lot vao day se tao NGUON SU THAT THU HAI cho cung mot khoan tien. Nen chung bi
// chan bang `CHECK` o DB (`TransportExpenseClaim_category_not_reserved`), khong chi bang mot cong
// o tang mien.
// -----------------------------------------------------------------------------------------------

enum TransportExpenseClaimStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TransportExpenseClaimDecisionOutcome {
  APPROVED
  REJECTED
}

model TransportExpenseClaim {
  id              String                      @id @default(cuid())
  driverId        String
  driver          TransportDriver             @relation(fields: [driverId], references: [id])
  status          TransportExpenseClaimStatus @default(PENDING_REVIEW)
  categoryCode    String                      @db.VarChar(60)
  /// SO LAI XE DE NGHI. Khong bao gio bi ghi de -- ke ca khi duyet it hon.
  claimedAmount   BigInt
  /// SO DUOC DUYET. `NULL` cho toi khi co mot quyet dinh `APPROVED`.
  approvedAmount  BigInt?
  currencyCode    String                      @default("VND") @db.VarChar(3)
  businessDate    String                      @db.VarChar(10)
  note            String?
  /// Khoa duc trong kho tep -- cung quy uoc voi `TransportTripExpense.evidenceLocator`.
  evidenceLocator String?

  /// Ba tham chieu, DEU tuy chon, nhung phai co IT NHAT MOT (`CHECK`).
  /// Chi `tripId` mo duong quyet toan: duong tien cua T3 di qua mot CHUYEN.
  tripId String?
  trip   TransportTrip?       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  runId  String?
  run    TransportVehicleRun? @relation(fields: [runId], references: [id], onDelete: Restrict)
  legId  String?
  leg    TransportRunLeg?     @relation(fields: [legId], references: [id], onDelete: Restrict)

  submittedBy String
  submittedAt DateTime  @default(now())
  decidedAt   DateTime?

  /// Khoan chi da ghi vao gia thanh. CHI co khi da duyet, va UNIQUE: mot de nghi sinh nhieu nhat
  /// MOT khoan chi. Neu khong unique thi mot lan bam duyet hai lan se tinh tien hai lan.
  settlementExpenseId String?               @unique
  settlementExpense   TransportTripExpense? @relation(fields: [settlementExpenseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decisions TransportExpenseClaimDecision[]

  @@index([driverId, status])
  @@index([status, businessDate])
  @@index([tripId])
  @@index([runId])
  @@index([legId])
}

/// LICH SU QUYET DINH -- chi ghi them.
///
/// Khong co duong sua hay xoa nao o tang kho, cung ly do voi `TransportDriverFundEntry`: mot lan
/// duyet la mot su kien da xay ra. Doi y ve sau la mot quyet dinh MOI (`sequence` ke tiep), khong
/// phai mot lan ghi de len quyet dinh cu -- ghi de la xoa mat dau ai duyet cai gi, luc nao.
model TransportExpenseClaimDecision {
  id             String                               @id @default(cuid())
  claimId        String
  claim          TransportExpenseClaim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  /// Bat dau tu 1, duy nhat trong mot de nghi. Cho phep lich su nhieu buoc khi `Q-04` mo them.
  sequence       Int
  outcome        TransportExpenseClaimDecisionOutcome
  /// Chi co nghia khi `outcome = APPROVED` (`CHECK`).
  approvedAmount BigInt?
  /// MA co kieu, khong phai cau chu -- de loc duoc. Vd `EVIDENCE_SUFFICIENT`, `NO_EVIDENCE`.
  reasonCode     String                               @db.VarChar(60)
  note           String?
  decidedBy      String
  decidedAt      DateTime                             @default(now())

  @@unique([claimId, sequence])
  @@index([claimId])
  @@index([decidedBy])
}

// ----- Transport domain: bam vi tri (transport-proof, Issue #235 Lane B) -----
//
// CANH BAO — RANG BUOC CUA `transport-proof` KHONG CO O DAY. Chung song trong SQL tho cua
// migration `20260907170000_transport_proof_tracking`, vi Prisma khong co cu phap cho `CHECK` va
// cho chi muc MOT PHAN. `transport-proof-storage.spec.ts` doc chinh tep migration do va do neu
// mot ten bien mat: `prisma migrate dev` sinh migration bang cach diff schema voi DB va SE sinh
// lenh xoa tat ca chung neu ai do chay no roi commit thang.
//
// Ba rang buoc quan trong nhat:
//   · `TransportTrackingSession_activeDriver_key`        — chi muc MOT PHAN: mot lai xe, mot phien;
//   · `TransportLocationObservation_session_event_key`   — chan phat lai;
//   · `TransportDeviceInstallation_installationId_key`   — mot ma cai dat, mot chu.

enum TransportTrackingSessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

/// Nguon cua mot ban dinh vi. `TELEMATICS` la hop GSHT tren xe — mot nguon DOC LAP voi dien
/// thoai, va la doi chieu cheo tot nhat ma he nay se co (`F-07` cua R0).
enum TransportLocationSource {
  DEVICE_GNSS
  DEVICE_FUSED
  DEVICE_NETWORK
  TELEMATICS
  MANUAL
}

enum TransportDevicePlatform {
  ANDROID
  IOS
  WEB
}

/// `UNKNOWN` (chua hoi) va `UNVERIFIED` (da hoi, khong chung minh duoc) la HAI dieu khac nhau.
/// Gop lai se lam mot ban web binh thuong trong y het mot may da bi can thiep.
enum TransportDeviceIntegrityVerdict {
  UNKNOWN
  UNVERIFIED
  BASIC
  STRONG
}

/// CHI HAI muc, va khong co muc thu ba kieu `BLOCK`: #232 D-02 — khong mot co nao trong he nay
/// duoc tu dong chan mot chuyen, sinh mot khoan no hay tru mot dong luong.
enum TransportProofRiskSeverity {
  INFO
  REVIEW
}

/// Khai DAY DU ngay tu dau, ke ca cac ma chi duoc phat o tranche chung cu. Ly do rat cu the:
/// `ALTER TYPE ... ADD VALUE` khong dung duoc trong cung mot giao dich voi cau lenh dung gia tri
/// moi, va Prisma chay migration trong mot giao dich — nen them mot ma ve sau la mot migration
/// rieng chi de sua mot enum.
enum TransportProofRiskCode {
  ACCURACY_POOR
  ACCURACY_UNKNOWN
  MOCK_LOCATION_REPORTED
  DEVICE_INTEGRITY_UNVERIFIED
  CLOCK_SKEW_EXCEEDED
  TIMESTAMP_NOT_ADVANCING
  LARGE_TIME_GAP
  IMPLAUSIBLE_SPEED
  OUTSIDE_OPERATING_AREA
  OUTSIDE_EXPECTED_GEOFENCE
  GEOFENCE_INDETERMINATE
  NO_GEOFENCE_CONFIGURED
  PHOTO_MISSING
  PHOTO_FROM_GALLERY
}

enum TransportGeofenceSubjectKind {
  CUSTOMER
  FUEL_SUPPLIER
  DEPOT
  AD_HOC
  /// DIA DIEM VAN HANH cua mot phap nhan (`TransportCounterpartySite`) — `#267` H1.
  ///
  /// Them mot gia tri chu KHONG them mot bang hang rao thu hai, va do la ca diem: `#267` H0 cam
  /// dung *"a second geofence engine"*. Hang rao cua mot kho hang A di qua DUNG duong ma hang rao
  /// cua kho khach va cay xang da di — cung bang, cung `assessGeofences`, cung quy uoc do chinh xac.
  ///
  /// `CUSTOMER` KHONG dung duoc cho viec nay: `subjectId` cua no tro toi `TransportCustomer`, con
  /// A la mot PHAP NHAN co the chua bao gio thue B mot chuyen nao. `AD_HOC` cung khong: hang rao
  /// cua mot kho co that thuoc ve mot cho co that, khong phai mot diem hen giao mot lan.
  COUNTERPARTY_SITE
}

/// MOT MA CAI DAT UNG DUNG, gan cung lai xe dau tien dung no.
///
/// `installationId` la chuoi do CHINH UNG DUNG sinh va giu. No khong chung minh danh tinh (mot
/// nguoi cai lai app se co ma moi), nhung no tra loi duoc mot cau khac va van huu ich: "hai phien
/// nay co den tu cung mot ban cai dat khong". Khi lai xe B trinh ma cua lai xe A, unique o cot
/// nay bien no thanh mot va cham ON AO thay vi mot lan gan lai chu so huu im lang.
model TransportDeviceInstallation {
  id                 String                          @id @default(cuid())
  driverId           String
  driver             TransportDriver                 @relation(fields: [driverId], references: [id])
  installationId     String                          @unique
  platform           TransportDevicePlatform
  appVersion         String
  integrityVerdict   TransportDeviceIntegrityVerdict @default(UNKNOWN)
  integrityCheckedAt DateTime?
  firstSeenAt        DateTime                        @default(now())
  lastSeenAt         DateTime                        @default(now())
  /// Thu hoi la mot BIA MO, khong phai mot lan xoa hang: mot ma da bi thu hoi van phai giai thich
  /// duoc nhung ban dinh vi no da gui truoc do.
  revokedAt          DateTime?
  revokedBy          String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  sessions TransportTrackingSession[]

  @@index([driverId, revokedAt])
}

/// MOT CA BAM VI TRI — bi rang buoc o PHIA MAY CHU voi lai xe da xac thuc va mot chuyen cua ho.
///
/// `vehicleId` do MAY CHU dien tu ban phan cong dang hieu luc. Khong mot tuyen HTTP nao nhan no
/// tu nguoi goi: neu nhan, mot lai xe gan duoc mot chuoi toa do bat ky vao mot chiec xe bat ky.
model TransportTrackingSession {
  id                   String                         @id @default(cuid())
  driverId             String
  driver               TransportDriver                @relation(fields: [driverId], references: [id])
  tripId               String
  trip                 TransportTrip                  @relation(fields: [tripId], references: [id])
  vehicleId            String?
  vehicle              TransportVehicle?              @relation(fields: [vehicleId], references: [id])
  deviceInstallationId String?
  deviceInstallation   TransportDeviceInstallation?   @relation(fields: [deviceInstallationId], references: [id])
  status               TransportTrackingSessionStatus @default(ACTIVE)
  businessDate         String                         @db.VarChar(10)
  startedAt            DateTime                       @default(now())
  endedAt              DateTime?
  endedReason          String?
  /// Bo dem tang dan de khung nhin tom tat khong phai dem lai ca bang moi lan doc.
  observationCount     Int                            @default(0)
  openedBy             String
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  observations TransportLocationObservation[]
  challenges   TransportProofChallenge[]

  @@index([driverId, status])
  @@index([tripId])
  @@index([businessDate])
}

/// MOT LOI THACH THUC do MAY CHU phat — de mot chung cu noi duoc "toi lap SAU luc anh hoi".
///
/// ============================================================================================
/// NO CHUNG MINH GI, VA — QUAN TRONG HON — NO KHONG CHUNG MINH GI
/// ============================================================================================
///
/// CHUNG MINH: lan gui chung cu nay xay ra trong vong `expiresAt` ke tu mot lan khu hoi MAY CHU
/// QUAN SAT DUOC. Mot chung cu lap san tu hom qua roi gui hom nay khong the mang mot `nonce` con
/// han, vi `nonce` do chua ton tai vao luc do.
///
/// KHONG CHUNG MINH: rang tam anh hay ban dinh vi duoc chup dung luc do. Mot may khach co the xin
/// mot loi thach thuc roi dinh kem mot tam anh cu. Ket hop voi `observationId` (phai thuoc phien
/// cua chinh lai xe, co `receivedAt` cua may chu) thi khoang co the noi doi bi thu hep lai — nhung
/// no KHONG bi dong. Dung tuyen bo nguoc lai (#229 §4).
///
/// DUONG NGOAI TUYEN KHONG CO LOI THACH THUC, va do la CO Y: xin mot `nonce` doi mot lan khu hoi,
/// ma mot lai xe trong vung lom thi khong co. Chung cu khong kem `nonce` VAN duoc nhan — no chi
/// khong duoc huong muc tin cay cua duong co `nonce`. Cung khuon voi anh chup trong ung dung ⟂
/// anh lay tu thu vien: he thong GHI LAI su khac biet thay vi tu choi mot ben.
model TransportProofChallenge {
  id                String                   @id @default(cuid())
  /// Bi mat do may chu sinh. `@unique` la cai lam cho "dung mot lan" cuong che duoc o tang DB.
  nonce             String                   @unique
  driverId          String
  driver            TransportDriver          @relation(fields: [driverId], references: [id])
  sessionId         String
  session           TransportTrackingSession @relation(fields: [sessionId], references: [id])
  issuedAt          DateTime                 @default(now())
  /// `issuedAt + challengeTtlSeconds`. Qua moc nay thi tu choi — day la phan "bounded" cua #235.
  expiresAt         DateTime
  /// NULL = chua dung. Di THEO CAP voi `consumedByProofId`, cuong che bang CHECK trong migration.
  consumedAt        DateTime?
  consumedByProofId String?

  @@index([driverId, expiresAt])
  @@index([sessionId])
}

/// MOT BAN DINH VI. Bang nay chi CONG THEM — khong co duong sua, khong co duong xoa.
///
/// HAI MOC THOI GIAN, va do la diem quan trong nhat cua bang: `capturedAt` la loi khai cua may
/// khach, `receivedAt` la su that cua may chu. Do lech duoc GHI vao `clockSkewSeconds` chu khong
/// bao gio duoc dung de tu choi — voi mot hang doi ngoai tuyen, do lech lon gan nhu luon co nghia
/// "may vua offline bon tieng", va tu choi se lam mat dung nhung ban ghi cua doan duong khong co
/// song.
model TransportLocationObservation {
  id                   String                   @id @default(cuid())
  sessionId            String
  /// `Restrict` chu khong `Cascade`: mot phien co ban dinh vi thi KHONG duoc xoa. Day la bang
  /// bang chung; mot lan xoa dat nham se mang theo ca chuoi.
  session              TransportTrackingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// Khoa idempotency do may khach sinh. Duy nhat TRONG mot phien.
  clientEventId        String
  latitude             Float
  longitude            Float
  accuracyMetres       Float?
  speedMetresPerSecond Float?
  bearingDegrees       Float?
  source               TransportLocationSource
  capturedAt           DateTime
  receivedAt           DateTime                 @default(now())
  clockSkewSeconds     Int
  /// `Location.isMock` cua Android. `null` = may khach khong noi gi — mot dieu KHAC voi `false`.
  mockLocationReported Boolean?
  businessDate         String                   @db.VarChar(10)
  createdAt            DateTime                 @default(now())

  riskFlags  TransportProofRiskFlag[]
  /// Nhieu nhat MOT chung cu dua tren cung mot ban dinh vi (`observationId` la `@unique` ben do).
  proof      TransportOperationalProof?
  /// Va nhieu nhat MOT moc van hanh — cung ly le, `observationId` cung la `@unique` ben do.
  checkpoint TransportRunCheckpoint?
  /// Va nhieu nhat MOT lan nhan viec tai A (`#267` H4) — cung khuon.
  siteIntake TransportRunSiteIntake?

  @@unique([sessionId, clientEventId], map: "TransportLocationObservation_session_event_key")
  @@index([sessionId, capturedAt])
  @@index([businessDate])
}

/// MOT CO RUI RO. Doc ky enum `TransportProofRiskSeverity` o tren truoc khi them ma vao day.
model TransportProofRiskFlag {
  id            String                        @id @default(cuid())
  code          TransportProofRiskCode
  severity      TransportProofRiskSeverity
  observationId String?
  observation   TransportLocationObservation? @relation(fields: [observationId], references: [id], onDelete: Restrict)
  detail        Json
  businessDate  String                        @db.VarChar(10)
  raisedAt      DateTime                      @default(now())

  @@index([code, businessDate])
  @@index([severity, businessDate])
  @@index([observationId])
}

/// HANG RAO DIA LY hinh TRON.
///
/// Chi hinh tron, co y: mot da giac doi mot thu vien hinh hoc, mot kieu luu tru phuc tap hon, va
/// — quan trong hon ca — mot nguoi phai VE no cho tung kho hang. Ban kinh la thu nhan vien dieu
/// hanh nhap duoc bang mot o so. Xem `docs/kien-truc/transport-geospatial.md` §6 cho duong nang
/// cap len da giac khi co nhu cau THAT.
model TransportGeofence {
  id           String                       @id @default(cuid())
  label        String
  subjectKind  TransportGeofenceSubjectKind
  /// NULL khi va chi khi `subjectKind = AD_HOC` — cuong che bang `CHECK` trong migration.
  subjectId    String?
  latitude     Float
  longitude    Float
  radiusMetres Int
  status       TransportPartyStatus         @default(ACTIVE)
  note         String?
  recordedBy   String
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([subjectKind, subjectId])
  @@index([status])
}

// ----- Transport domain: chung cu van hanh (transport-proof, Issue #235 Lane B) -----
//
// Rang buoc song trong SQL tho cua `20260908120000_transport_operational_proof`, va
// `transport-operational-proof-storage.spec.ts` doc chinh tep do.

enum TransportOperationalProofKind {
  START
  DELIVERY
}

/// CACH mot tam anh duoc lay — va do la mot su that ma may chu KHONG tu kiem duoc.
///
/// `LIVE_CAMERA` la loi khai cua ung dung rang no vua mo camera trong ung dung; `GALLERY` la loi
/// khai rang nguoi dung chon mot tep co san. Mot ung dung bi sua hoan toan co the khai sai. Nen
/// cot nay KHONG phai mot bien phap an ninh — no la mot ranh gioi TRUNG THUC: no cho phep he thong
/// KHONG cham cung mot muc tin cay cho hai duong khac nhau, va cho phep nguoi xem lai biet duong
/// nao da duoc dung. `#232 D-08`: anh lay tu thu vien khong duoc lang le huong cung muc tin cay.
enum TransportProofPhotoCaptureMode {
  LIVE_CAMERA
  GALLERY
  UNKNOWN
}

/// MOT CHUNG CU VAN HANH — bat dau hoac giao hang.
///
/// `observationId` la BAT BUOC: mot chung cu khong co vi tri thi khong phai chung cu ma chi la mot
/// cai nut bam. Ban dinh vi di qua dung duong ingest cua `transport-proof`, nen no da duoc cham
/// rui ro, da co `receivedAt` cua may chu, va da nam trong mot phien thuoc ve dung lai xe do.
model TransportOperationalProof {
  id                String                        @id @default(cuid())
  kind              TransportOperationalProofKind
  tripId            String
  trip              TransportTrip                 @relation(fields: [tripId], references: [id])
  driverId          String
  driver            TransportDriver               @relation(fields: [driverId], references: [id])
  /// Ban dinh vi tai thoi diem lap chung cu. MOT ban dinh vi phuc vu NHIEU NHAT mot chung cu.
  observationId     String                        @unique
  observation       TransportLocationObservation  @relation(fields: [observationId], references: [id], onDelete: Restrict)
  sessionId         String?
  /// Khoa idempotency do may khach sinh — chan mot lan bam hai lan tao hai chung cu.
  clientEventId     String
  capturedAt        DateTime
  receivedAt        DateTime                      @default(now())
  businessDate      String                        @db.VarChar(10)
  note              String?
  recordedBy        String
  /// Chung cu nay co kem mot loi thach thuc CON HAN cua may chu khong.
  ///
  /// `false` KHONG phai mot cao buoc — duong ngoai tuyen khong xin duoc `nonce`, va do la duong
  /// binh thuong cua mot lai xe trong vung lom. No chi noi rang phep kiem "gui SAU luc may chu
  /// hoi" khong ap dung duoc cho ban ghi nay.
  challengeVerified Boolean                       @default(false)
  createdAt         DateTime                      @default(now())
  /// BIA MO, khong phai mot lan xoa hang — cung khuon voi `TransportFuelReceiptEvidence`.
  withdrawnAt       DateTime?
  withdrawnBy       String?

  photos TransportProofPhoto[]

  @@unique([tripId, kind, clientEventId], map: "TransportOperationalProof_trip_kind_event_key")
  @@index([tripId, kind])
  @@index([driverId, businessDate])
  @@index([businessDate])
}

/// ANH CHUNG CU — bang CON, khong phai mot cot chuoi ngan cach bang dau phay.
///
/// Mot lan giao hang co the can nhieu tam (hang, bien ban, chu ky). Va quan trong hon: moi tam
/// mang RIENG `captureMode` cua no, nen mot chung cu co mot tam chup tai cho va mot tam lay tu thu
/// vien van noi ra duoc dieu do thay vi bi gop thanh mot muc tin cay duy nhat.
model TransportProofPhoto {
  id          String                         @id @default(cuid())
  proofId     String
  proof       TransportOperationalProof      @relation(fields: [proofId], references: [id], onDelete: Restrict)
  /// Dinh vi trong kho anh (`MediaStore` qua `TransportEvidenceService`). KHONG dung kho thu hai.
  locator     String
  captureMode TransportProofPhotoCaptureMode @default(UNKNOWN)
  contentType String?
  byteSize    Int?
  capturedAt  DateTime?
  uploadedBy  String
  createdAt   DateTime                       @default(now())
  withdrawnAt DateTime?
  withdrawnBy String?

  @@index([proofId])
  @@index([proofId, withdrawnAt])
}

/// LOAI MOC VAN HANH — `#243` F1. Xem `checkpoint.types.ts` de biet vi sao `IN_TRANSIT` va
/// `WAITING_RECEIVER` CO Y khong nam trong danh sach nay.
enum TransportRunCheckpointType {
  ASSIGNED
  DEPARTED
  PICKUP_ARRIVAL
  GATE_ENTRY
  LOADING
  PICKUP_DEPARTURE
  DELIVERY_ARRIVAL
  DELIVERY_ACCEPTED
  COMPLETED
}

/// MOC VAN HANH CUA MOT VONG CHAY — `#243` F1.
///
/// GHI THEM, KHONG GHI DE. Bang nay khong co cot `updatedAt` va khong co duong sua nao: trigger
/// `transport_run_checkpoint_append_only` chan moi `UPDATE`/`DELETE` o tang luu tru. Mot moc ghi
/// nham duoc sua bang cach ghi mot moc dinh chinh, khong bang cach doi hang cu — cung nguyen tac
/// voi `transport_driver_cashout_immutable` cua `TX-07b`.
///
/// `receivedAt` la gio MAY CHU va la gio duy nhat duoc dung de tinh. `capturedAt` la gio may khach
/// khai bao, giu de doi chieu: mot chiec dien thoai van nguoc dong ho khong duoc xe dich lich su
/// (`#243` F7).
model TransportRunCheckpoint {
  id            String                        @id @default(cuid())
  type          TransportRunCheckpointType
  runId         String
  run           TransportVehicleRun           @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// NULL o moc muc vong chay (`ASSIGNED`, `DEPARTED`, `COMPLETED`).
  legId         String?
  leg           TransportRunLeg?              @relation(fields: [legId], references: [id], onDelete: Restrict)
  /// Nguoi ghi — `authUserId` tu phien, khong tu than yeu cau.
  recordedBy    String
  driverId      String?
  driver        TransportDriver?              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  /// Ban dinh vi cua Lane B. MOT ban dinh vi phuc vu NHIEU NHAT mot moc — cung khuon
  /// `TransportOperationalProof.observationId`.
  observationId String?                       @unique
  observation   TransportLocationObservation? @relation(fields: [observationId], references: [id], onDelete: Restrict)
  /// Khoa idempotency do may khach sinh — chan mot lan bam hai lan tao hai moc.
  clientEventId String
  capturedAt    DateTime?
  receivedAt    DateTime                      @default(now())
  businessDate  String                        @db.VarChar(10)
  note          String?
  createdAt     DateTime                      @default(now())

  @@unique([runId, type, clientEventId], map: "TransportRunCheckpoint_run_type_event_key")
  @@index([runId, receivedAt])
  @@index([legId])
  @@index([driverId, businessDate])
  @@index([type, businessDate])
}

// ===================================================================
// TX-08 QUYEN SO HUU TAI SAN — co dong/dong so huu mot xe (Lane E, Issue #242)
// ===================================================================
//
// CANH BAO — RANG BUOC CUA TX-08 KHONG NAM O DAY. Chung song trong SQL tho cua migration
// `20260909140000_transport_asset_ownership`, vi Prisma khong co cu phap cho `CHECK` lan cho
// unique MOT PHAN:
//
//     1. `TransportAssetStakeholder_displayName_not_blank`  — ten ben huu quan khong duoc rong
//     2. `TransportVehicleOwnershipInterest_bps_range`      — 1..10000, so NGUYEN
//     3. `TransportVehicleOwnershipInterest_period_order`   — `effectiveTo` phai sau `effectiveFrom`
//     4. `TransportVehicleOwnershipInterest_activePair_key` — unique MOT PHAN `WHERE "effectiveTo" IS NULL`
//
// `prisma migrate dev` sinh migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca
// bon. Ai chay lenh do PHAI doc lai migration sinh ra va bo cac dong `DROP` truoc khi commit.
// `transport-asset-ownership-storage.spec.ts` doc chinh tep migration va do neu mot ten bien mat.
//
// -----------------------------------------------------------------------------------------------
// HAI TRUC DOC LAP — day la quyet dinh trung tam cua ca tranche (#241 §1, #242 E1).
//
// Mot xe co HAI thuoc tinh khong suy ra nhau:
//
//   · AI DIEU HANH no  -> `TransportVehicle.operationalControl`
//   · AI SO HUU no     -> `TransportVehicleOwnershipInterest` (0..N ben huu quan)
//
// Mot cot `isExternal` boolean se gop hai truc do lam mot, va tu lan do tro di khong ai phan biet
// duoc "xe cua B, co mot nguoi gop von" voi "xe cua nha xe ngoai". Chung khac nhau o MOI cau hoi
// van hanh: xe dong so huu VAN la xe B dieu hanh — B phan cong lai xe, B chiu chi phi, B thu cuoc.
// Xe cua nha xe ngoai thi khong.
//
// Vi vay `operationalControl` mac dinh `INTERNAL_OPERATED`: them mot ben huu quan vao mot xe KHONG
// doi cot do, va khong co duong nao trong ma nguon lam dieu do. `asset-ownership.service.spec.ts`
// khoa dieu nay bang mot bai doc thang.
//
// -----------------------------------------------------------------------------------------------
// PHAN TRAM SO HUU KHONG PHAI CONG THUC CHIA LOI — #241 §1, #242 E4.
//
// Khong bang nao o day mang mot truong tien, va do la CO Y. Ty le so huu tra loi cau hoi "ai la
// chu tai san"; no khong tra loi "ai duoc chia bao nhieu" — cau thu hai can mot THOA THUAN KINH TE
// ma chua ai ky. Neu mot ngay co thoa thuan do, no vao mot bang RIENG
// (`TransportVehicleEconomicAgreement`) tro toi day, va lich su o day van doc lai duoc nguyen ven.
//
// `no-auto-profit-distribution.spec.ts` quet ca thu muc va do neu mot truong tien xuat hien.

/// BEN HUU QUAN — mot con nguoi hoac mot to chuc nam quyen loi so huu trong mot tai san.
///
/// KHONG mang mot nhan quan he xa hoi nao (`FRIEND`, `RELATIVE`, `BOSS_FRIEND`) — #242 E3 cam dung
/// nhan xa hoi lam co so phan quyen, va cach chac chan nhat de khong ai dung la khong co cho de
/// ghi. Quan he trong doi that co the la ho hang; quyen doc trong phan mem chi den tu mot dong
/// `TransportVehicleOwnershipInterest` con hieu luc.
/// KHONG co cot `counterpartyId` o day, va do la co y. Khi mot to chuc gop von DA co ho so phap
/// nhan (`R1-A`), duong noi dung la them `ASSET_STAKEHOLDER` vao `TransportCounterpartySubjectKind`
/// roi dung chinh `TransportCounterpartyLink` — xuong song danh tinh duoc viet ra de lam viec do,
/// va no cuong che "mot hang chuyen mon thuoc TOI DA MOT phap nhan" bang khoa chinh kep. Mot cot
/// `counterpartyId` khong khoa ngoai o day se la duong noi THU HAI cho cung mot viec, va tu lan
/// lech dau tien khong ai biet ben nao dung. Chua ai can den no, nen chua lam.
model TransportAssetStakeholder {
  id          String                        @id @default(cuid())
  kind        TransportAssetStakeholderKind
  displayName String
  status      TransportPartyStatus          @default(ACTIVE)
  note        String?
  /// Cau noi user dang nhap -> ho so ben huu quan. CHI aggregate nay giu no — cung khuon
  /// `TransportDriver.authUserId`. Day la CONG THAT cua be mat "Xe toi co co phan": vai nen tang
  /// khong cap duoc pham vi nay, va khong duoc cap.
  authUserId  String?                       @unique
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  interests TransportVehicleOwnershipInterest[]

  @@index([status])
}

/// CA NHAN hay TO CHUC. Hai gia tri, va khong co gia tri thu ba cho toi khi co nguoi thuc su can.
enum TransportAssetStakeholderKind {
  PERSON
  ORGANIZATION
}

/// AI DIEU HANH mot xe — TRUC DOC LAP voi quyen so huu. Xem khoi canh bao dau muc TX-08.
enum TransportVehicleOperationalControl {
  /// B dieu hanh: B phan cong lai xe, B chiu chi phi, B thu cuoc. Ke ca khi xe co dong so huu.
  INTERNAL_OPERATED
  /// Nha xe ngoai dieu hanh. KHONG suy ra tu viec co hay khong co ben huu quan.
  EXTERNAL_CARRIER
}

/// MOT QUYEN LOI SO HUU cua mot ben huu quan tren mot xe, trong mot KHOANG THOI GIAN.
///
/// `ownershipBasisPoints` la SO NGUYEN diem co ban (1..10000 = 0,01%..100%), khong phai `Float`.
/// Ba lan cong `33.33` roi so voi `100` la mot phep so sanh khong bao gio dung; ba lan cong `3333`
/// roi so voi `10000` thi luon dung mot cau tra loi. #242 E2 doi dung dieu do.
///
/// LICH SU KHONG BI GHI DE: dong mot quyen loi la DAT `effectiveTo`, khong phai `UPDATE` ty le hay
/// `DELETE` hang. Cung khuon `TransportVehicleAssignment` cua `TX-01`. Mot ban ghi da dong van doc
/// lai duoc nguyen ven, nen cau hoi "thang 3 nam ngoai ai so huu xe nay" luon co cau tra loi.
///
/// MOT ban DANG hieu luc cho moi cap `(xe, ben huu quan)` duoc cuong che O DB bang unique mot phan
/// `TransportVehicleOwnershipInterest_activePair_key` (`WHERE "effectiveTo" IS NULL`). Unique do
/// cuong che DUNG MOT dieu: khong ai co hai ty le song song tren cung mot xe. NHIEU ban DA DONG
/// cua cung mot cap van ghi duoc — do chinh la lich su.
model TransportVehicleOwnershipInterest {
  id                   String                    @id @default(cuid())
  vehicleId            String
  vehicle              TransportVehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stakeholderId        String
  stakeholder          TransportAssetStakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Restrict)
  /// 1..10000. Xem khoi chu thich cua model — KHONG phai phan tram dau phay dong.
  ownershipBasisPoints Int
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  /// NGUON GOC: ai ghi dong nay, ai dong no, va vi sao. #242 E2 doi `provenance/audit`.
  recordedBy           String
  recordedNote         String?
  closedBy             String?
  closedNote           String?
  createdAt            DateTime                  @default(now())

  @@index([vehicleId, effectiveTo])
  @@index([stakeholderId, effectiveTo])
}

/**
 * ====================================================================== *
 * `transport-toll` (`TX-08` mo rong, Lane J / #269) — NAP DU LIEU ETC
 * KHONG mot bang nao o duoi day sinh cong no, phai tra hay mot but toan nao.
 * ETC la CONG TY TRA (#229 §8, #237), va khong bang nao co cot `driverId` —
 * do la mot bat bien CAU TRUC, duoc mot bai test quet ma nguon giu lai.
 * Nghien cuu + phan loai bang chung: `docs/kien-truc/transport-etc-ingestion.md`
 * ======================================================================
 */

enum TransportTollProvider {
  VETC
  EPASS
  OTHER
}

enum TransportTollSourceKind {
  API
  STATEMENT_FILE
  INVOICE_PDF
  MANUAL
}

enum TransportTollTransactionKind {
  TOLL_PASS
  TOP_UP
  /// Khong phai mot COT rieng: phi 6.600d/thang duoc cong bo 01/08/2026 roi tam dung ~20/08/2026.
  /// Mot cot rieng cho mot dong phi co the bien mat trong ba tuan la mot cot chet.
  ACCOUNT_FEE
  ADJUSTMENT
}

enum TransportTollLinkProvenance {
  MANUAL
  STATEMENT_DECLARED
}

enum TransportTollParseStatus {
  ACCEPTED
  REJECTED
}

/// VI SAO mot dong bi tu choi luc DOC. N duong tu choi thi N ma.
enum TransportTollRejectReason {
  TOLL_ROW_UNPARSEABLE
  TOLL_ROW_MISSING_AMOUNT
  TOLL_ROW_AMOUNT_INVALID
  TOLL_ROW_MISSING_DATE
  TOLL_ROW_DATE_INVALID
  TOLL_ROW_ACCOUNT_MISSING
  TOLL_ROW_PLATE_MISSING
  TOLL_ROW_KIND_UNKNOWN
}

/// KHONG co `OUT_OF_POLICY`: #269 J6 chi cho phep no *"if a real deterministic policy exists"*, va
/// chua ai mo ta mot chinh sach nao. KHONG co `UNSUPPORTED_KIND`: mot loai khong nhan ra hong o
/// tang DOC, khong o tang PHAN LOAI.
enum TransportTollMatchState {
  MATCHED
  ACCOUNT_UNRESOLVED
  VEHICLE_UNRESOLVED
  AMBIGUOUS
  DUPLICATE_CANDIDATE
}

/// KHONG co `PAID`/`SETTLED`/`ACCOUNTED` — #269 J7 cam thang. Ba chu do noi ve TIEN DA TRA; cai
/// duy nhat mien nay biet la mot dong da co nguoi NHIN.
enum TransportTollReviewState {
  PENDING
  CONFIRMED
  REOPENED
}

enum TransportTollReviewAction {
  RESOLVE_VEHICLE
  CONFIRM
  FLAG_DUPLICATE
  /// "Hai dong giong nhau nay la HAI su kien that" — tinh huong doc cheo lan ma VETC tu cong bo.
  CLEAR_DUPLICATE
  REOPEN
}

/// MOT TAI KHOAN GIAO THONG da khai — khai niem CO DINH NGHIA PHAP LY (ND 119/2024/ND-CP).
///
/// KHONG bao gio duoc sinh tu dong tu mot lan nhap tep: mot so tai khoan doc sai mot chu se lang
/// le tao ra mot tai khoan ma khong so sach nao biet.
model TransportTollAccount {
  id         String                @id @default(cuid())
  provider   TransportTollProvider
  accountNo  String
  /// ND 119 Phu luc cho phep CA NHAN lan TO CHUC dung ten tai khoan.
  holderName String?
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  links      TransportTollAccountVehicleLink[]
  candidates TransportTollTransactionCandidate[]

  @@unique([provider, accountNo])
  @@index([provider, active])
}

/// MOT DOAN THOI GIAN mot xe nhan chi tra tu mot tai khoan giao thong.
///
/// ND 119/2024/ND-CP Dieu 11 khoan 3: *"moi phuong tien tham gia giao thong CHI DUOC NHAN CHI TRA
/// TU MOT TAI KHOAN GIAO THONG."* Nen tai moi khoanh khac mot `vehicleId` chi duoc co DUNG MOT
/// dong `effectiveTo IS NULL`.
///
/// Bat bien do duoc cuong che O DB bang unique mot phan `TransportTollAccountVehicleLink_activeVehicle_key`
/// (`WHERE "effectiveTo" IS NULL`), giong khuon cua `TransportVehicleOwnershipInterest`. Kiem o
/// tang mien chi dung khi co MOT nguoi ghi.
model TransportTollAccountVehicleLink {
  id                 String                      @id @default(cuid())
  accountId          String
  account            TransportTollAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  vehicleId          String
  vehicle            TransportVehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// ND 119 Phu luc co "ma dinh danh the dau cuoi" (RFID) — mot khoa BEN HON bien so.
  /// `null` la truong hop THUONG: chua do duoc no co xuat hien tren tep xuat hay khong.
  providerVehicleRef String?
  /// NGAY nghiep vu, hai dau DEU TINH.
  effectiveFrom      String                      @db.VarChar(10)
  effectiveTo        String?                     @db.VarChar(10)
  provenance         TransportTollLinkProvenance @default(MANUAL)
  createdAt          DateTime                    @default(now())
  createdBy          String
  closedAt           DateTime?
  closedBy           String?

  @@index([accountId, effectiveTo])
  @@index([vehicleId, effectiveTo])
}

/// MOT LAN NAP — bat bien sau khi ghi.
///
/// `@@unique([provider, sourceDigest])` la ca co che chong lap o tang NGUON: nap lai dung bo byte
/// do tra ve chinh ban ghi nay, khong tao gi (#269 J4 — *"same source re-upload => idempotent"*).
model TransportTollImport {
  id            String                  @id @default(cuid())
  provider      TransportTollProvider
  sourceKind    TransportTollSourceKind
  /// Ten tep / ma ky sao ke. KHONG phai duong dan he thong tep, va khong bao gio ra DTO duoi dang
  /// mot dinh vi doc duoc.
  sourceLabel   String
  /// SHA-256 cua BYTE goc.
  sourceDigest  String                  @db.VarChar(64)
  /// Ky cua nguon NEU nguon co mot ky. Hoa don tung giao dich thi khong co.
  periodStart   String?                 @db.VarChar(10)
  periodEnd     String?                 @db.VarChar(10)
  rowCount      Int
  acceptedCount Int
  rejectedCount Int
  importedAt    DateTime                @default(now())
  importedBy    String

  candidates TransportTollTransactionCandidate[]

  @@unique([provider, sourceDigest])
  @@index([provider, importedAt])
}

/// MOT DONG cua nguon. Dong BI TU CHOI van duoc luu, voi moi o so lieu de NULL.
///
/// #269 J3 goi do la *"preserve partial success"*: mot tep 500 dong doc duoc 497 la ket qua BINH
/// THUONG. Nem ca lan nap di se lam nguoi dung mat ca 497 dong dung — roi ho se khong bao gio biet
/// ba dong kia ton tai.
model TransportTollTransactionCandidate {
  id                     String                        @id @default(cuid())
  importId               String
  import                 TransportTollImport           @relation(fields: [importId], references: [id], onDelete: Cascade)
  provider               TransportTollProvider
  /// So dong TRONG TEP, tu 1 — de nguoi doi soat mo tep ra tim dung dong.
  rowNumber              Int
  parseStatus            TransportTollParseStatus
  rejectReason           TransportTollRejectReason?
  /// So tai khoan DOC DUOC TU TEP, giu nguyen ke ca khi khong ung tai khoan nao.
  accountNoRaw           String
  accountId              String?
  account                TransportTollAccount?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  kind                   TransportTollTransactionKind?
  /// Bien so DOC DUOC TU TEP, giu nguyen ke ca khi khong khop xe nao.
  vehiclePlateRaw        String
  vehicleId              String?
  vehicle                TransportVehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  passedAt               DateTime?
  /// `INV-25` — NGAY nghiep vu, tinh MOT LAN luc doc theo mui gio tenant.
  businessDate           String?                       @db.VarChar(10)
  /// So nguyen DONG (`GD-03`), CO DAU. `CHECK` bien dat o migration, trung bien cua `money()`.
  signedAmount           BigInt?
  currencyCode           String                        @default("VND") @db.VarChar(3)
  stationLabel           String?
  providerRef            String?
  /// TIN HIEU chong lap o tang DONG — KHONG phai mot khoa duy nhat. #269 J4 cam bia ra mot luat
  /// duy nhat cho `providerReference` khi khong nha cung cap nao bao dam co mot cai.
  fingerprint            String?                       @db.VarChar(64)
  matchState             TransportTollMatchState?
  reviewState            TransportTollReviewState      @default(PENDING)
  /// Dong ma nguoi doi soat noi dong nay trung. KHONG phai mot ket luan cua may.
  ///
  /// KHONG co cot `resolvedVehicleId` di kem, va do la mot lua chon: ban dau co mot cot nhu vay de
  /// "tach xe nguoi chon khoi xe may doc ra", nhung khong duong doc nao dung toi no — trong khi
  /// `TransportTollReviewDecision.previousVehicleId/nextVehicleId` DA giu dung ca hai dau cua moi
  /// lan sua. Mot cot ghi-mot-chieu ben canh mot lich su day du la mot nguon su that thu hai, va
  /// no se lech.
  duplicateOfCandidateId String?
  /// Dong nguyen ban, de doi chieu khi ai do nghi bo cot dang doc sai tep.
  rawValues              Json
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  decisions TransportTollReviewDecision[]

  @@unique([importId, rowNumber])
  @@index([provider, fingerprint])
  @@index([accountId, businessDate])
  @@index([matchState, reviewState])
  @@index([vehicleId, businessDate])
}

/// MOT QUYET DINH cua nguoi doi soat — GHI THEM, khong bao gio ghi de.
///
/// #269 J7 doi giu `actor / time / reason / old-new linkage / append-supersede history`. Nen bang
/// nay khong co `updatedAt` va khong co duong sua: mot lan doi y la mot DONG MOI.
model TransportTollReviewDecision {
  id                     String                            @id @default(cuid())
  candidateId            String
  candidate              TransportTollTransactionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  action                 TransportTollReviewAction
  actor                  String
  at                     DateTime                          @default(now())
  /// Ly do CO MA, khong phai mot cau tu do.
  reason                 String
  note                   String?
  previousVehicleId      String?
  nextVehicleId          String?
  previousMatchState     TransportTollMatchState?
  nextMatchState         TransportTollMatchState?
  duplicateOfCandidateId String?

  @@index([candidateId, at])
  @@index([actor, at])
}

// ----- Transport domain: NGHIEM THU CHUNG TU / THUONG MAI (capability `transport-acceptance`,
// Issue #268 Lane I) -----
//
// TRUC THU HAI, KHONG PHAI MOT TRANG THAI MOI CUA VONG CHAY.
//
//     TransportVehicleRun.status = COMPLETED   =  xe da chay xong
//     nghiem thu APPROVED                      =  B da co chung tu duoc A xac nhan
//
// Hai cau do do hai nguoi khac nhau tra loi, o hai thoi diem khac nhau. `TransportVehicleRun` giu
// nguyen bon trang thai cua Lane A va KHONG duoc noi them mot gia tri nao.
//
// `PENDING` KHONG CO TRONG ENUM, va do la co y: no la SU VANG MAT cua mot hang, khong phai mot gia
// tri phai ghi. Nho vay Lane I khong phai cam mot duong ghi nao vao luong van hanh (khong sua
// `MovementService`, khong dung vao lich su moc cua #243), va mot vong chay chua ai nghiem thu thi
// mac dinh KHONG du dieu kien doi soat.
//
// CANH BAO — TRIGGER CHI-GHI-THEM KHONG CO TRONG TEP NAY. No song trong SQL tho cua migration
// `20260910110000_transport_commercial_acceptance`, cung ly do voi `TransportRunCheckpoint`:
// Prisma khong co cu phap cho TRIGGER, va `prisma migrate dev` SE sinh lenh xoa no neu ai do chay
// roi commit thang. `transport-commercial-acceptance-storage.spec.ts` doc chinh tep migration do.

enum TransportCommercialAcceptanceOutcome {
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

/// CAN CU cua mot lan duyet. #268 I2 goi ten duong thu hai:
/// *"support an explicit auditable EXTERNAL_PHYSICAL_CONFIRMATION basis rather than inventing a
/// fake file"*. Mot he thong chi cho phep DOCUMENT se day nguoi dung toi viec tai len mot tam anh
/// bat ky de qua cong — tuc bien mot rang buoc thanh mot nghi thuc.
enum TransportCommercialAcceptanceBasis {
  DOCUMENT
  EXTERNAL_PHYSICAL_CONFIRMATION
}

/// HO SO KET THUC THUONG MAI cua MOT DON HANG — chu the + hinh chieu trang thai hien tai.
///
/// `state` KHONG phai mot co `boolean` mat lich su. No la hinh chieu cua quyet dinh moi nhat, va no
/// chi duoc ghi trong CUNG MOT giao dich voi viec them mot hang `...Decision`. Dung khuon da chay
/// cua `TransportExpenseClaim.status` + `TransportExpenseClaimDecision`.
///
/// ===========================================================================================
/// CHU THE DA DOI TU `runId` SANG `orderId` — `#275` K1, va no la mot MIGRATION THEM VAO
/// ===========================================================================================
///
/// `#268` Lane I khoa ho so nay vao mot VONG CHAY. `#275` chot lai: *"FINAL COMPLETION SUBJECT =
/// TransportOrder, NOT VehicleRun, NOT projected-work-only"*. Ly do la nghiep vu — sep va ke toan
/// lam viec tren DON; mot vong chay co the cho hai don, co the dong lai truoc khi mot trong hai
/// duoc nghiem thu, va mot don co the khong bao gio chay bang xe cua B.
///
/// `#275` K0 doi *"prefer additive migration/compatibility over destructive rewrite"*, nen cot
/// `runId` KHONG bi go: no chi tro thanh nullable, va mot `CHECK` doi DUNG MOT trong hai chu the co
/// mat. Mot hang cu (neu co) van doc duoc nguyen ven; moi hang MOI deu la chu the don. Tang mien
/// khong con bieu dien duoc chu the vong chay — xem `CommercialAcceptance` trong
/// `acceptance.types.ts`.
///
/// `orderId @unique`: MOT don, MOT ho so. Neu khong unique thi hai lan bam se tao hai ho so cho
/// cung mot don, va cau hoi "don nay da ket thuc chua" co hai cau tra loi.
model TransportCommercialAcceptance {
  id               String                               @id @default(cuid())
  /// CHU THE HIEN TAI. Nullable CHI de mot hang cu cua `#268` con doc duoc — moi lan ghi moi deu
  /// dat truong nay, va `CHECK` o migration `20260910120000` cuong che dieu do.
  orderId          String?                              @unique
  order            TransportOrder?                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// CHU THE CU cua `#268`. Khong con duong ghi nao dat no; giu lai de khong xoa lich su.
  runId            String?                              @unique
  run              TransportVehicleRun?                 @relation(fields: [runId], references: [id], onDelete: Restrict)
  state            TransportCommercialAcceptanceOutcome
  /// Phap nhan ben A khi biet. #268 I1 goi day la truong TUY CHON.
  counterpartyId   String?
  counterparty     TransportCounterparty?               @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  /// Ngay nghiep vu cua ho so, tinh MOT lan luc mo theo mui gio tenant. `INV-25`.
  businessDate     String                               @db.VarChar(10)
  /// Con tro toi quyet dinh moi nhat. KHONG khai khoa ngoai: mot FK vong lai (ho so -> quyet dinh
  /// -> ho so) buoc migration phai hoan lai rang buoc, doi lay mot bao dam ma giao dich cua kho da
  /// cho san. `transport-commercial-acceptance.int.spec.ts` kiem tinh toan ven nay tren DB that.
  ///
  /// Cong dung THU HAI cua no quan trong khong kem: no la THE DANH DAU PHIEN BAN. Mot lenh sua phai
  /// khai `supersedesId` bang DUNG gia tri nay, nen hai nguoi cung bam thi nguoi thu hai bi tu choi
  /// thay vi ghi de len mot quyet dinh ho chua he nhin thay.
  latestDecisionId String?
  openedBy         String
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt

  decisions TransportCommercialAcceptanceDecision[]

  @@index([state, businessDate])
  @@index([counterpartyId])
}

/// LICH SU QUYET DINH — CHI GHI THEM, cuong che bang TRIGGER o DB.
///
/// Manh hon khuon cua `TransportExpenseClaimDecision` (chi giu ky luat o tang kho) mot bac, va co
/// ly do: hang o day quyet dinh mot cong TAI CHINH. #268 I7 bai 11 doi chung minh
/// *"Approved decision cannot be silently edited after settlement lock"* — mot TRIGGER chung minh
/// duoc dieu do ke ca voi mot cau `UPDATE` viet tay tren psql, mot doan ma dich vu khong chung
/// minh duoc.
///
/// Vi trigger chan CA `DELETE`, khoa ngoai la `Restrict` chu khong `Cascade`: mot lenh xoa day
/// chuyen se that bai o trigger thay vi that bai o FK, va thong diep loi noi dung ly do. Cung quy
/// uoc voi `TransportRunCheckpoint`, va cung ly do no khong nam trong duong reset demo.
model TransportCommercialAcceptanceDecision {
  id             String                               @id @default(cuid())
  acceptanceId   String
  acceptance     TransportCommercialAcceptance        @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  /// Bat dau tu 1, duy nhat trong mot ho so. Tinh BEN TRONG giao dich; unique la luoi cuoi.
  sequence       Int
  outcome        TransportCommercialAcceptanceOutcome
  /// MA co kieu de loc duoc, khong phai cau chu. Cung do rong voi `TransportExpenseClaimDecision`.
  reasonCode     String                               @db.VarChar(60)
  basis          TransportCommercialAcceptanceBasis
  /// Khoa DUC cua chung tu lam can cu. RONG khi can cu la `EXTERNAL_PHYSICAL_CONFIRMATION`.
  /// KHONG phai duong dan bucket — quy uoc giong `TransportProofPhoto.locator`.
  evidenceRefs   String[]
  /// B thuc su nhan/xac nhan cai gi. BAT BUOC o duong khong-co-ban-so (cuong che o tang mien).
  externalNote   String?
  /// Quyet dinh ma hang nay SUA. NULL o lan dau. #268 I4: doi y la mot quyet dinh MOI.
  supersedesId   String?
  /// Khoa chong ghi trung do ben goi dat. #268 I4: gui lai cung khoa = cung mot hieu qua nghiep vu.
  idempotencyKey String                               @db.VarChar(120)
  /// Danh tinh tu PHIEN, khong tu than yeu cau. #268 I3: *"no caller-supplied decidedBy"*.
  decidedBy      String
  /// Gio MAY CHU. #268 I7 bai 14: *"Client clock cannot choose approvedAt"*.
  decidedAt      DateTime                             @default(now())

  @@unique([acceptanceId, sequence], map: "TransportCommercialAcceptanceDecision_sequence_key")
  @@unique([acceptanceId, idempotencyKey], map: "TransportCommercialAcceptanceDecision_idempotency_key")
  @@index([acceptanceId])
  @@index([decidedBy])
}

// ----- Van chuyen v2 — LAP KE HOACH VONG CHAY DO HE THONG QUAN (Lane L, #276) -----------------
//
// #274 chot lai hinh dang san pham: sep/ke toan lam viec voi DON. `TransportVehicleRun` va
// `TransportRunLeg` van la su that van hanh, nhung KHONG con la thu ma nguoi dung phai tu tao va
// tu dong.
//
// Khoi duoi day KHONG them mot mo hinh vong chay thu hai. No them dung mot thu ma mo hinh hom nay
// khong tra loi duoc: *lan lap ke hoach nao da gan don nay vao vong chay nay, o che do gom nhom
// nao, va no con hieu luc khong*. Ba cau hoi do khong doc ra duoc tu `TransportRunLeg`:
//
//   · mot chang co hang noi "don X dang o tren vong chay Y", nhung khong noi ai da quyet dieu do,
//     luc nao, theo che do nao — nen mot lan doi chinh sach ve sau khong doi chieu duoc voi lich su;
//   · khong co cho nao de dat MOT rang buoc duy nhat "mot don co dung mot ke hoach dang hieu luc",
//     va thieu no thi hai yeu cau den cung luc se gan mot don len hai chiec xe;
//   · huy mot ke hoach roi lap lai la mot viec that (dieu xe doi y), va no can mot thuc the co
//     vong doi rieng — khong phai mot chang bi xoa.
//
// -----------------------------------------------------------------------------------------------
// VI SAO KHONG DAT UNIQUE THANG LEN `TransportRunLeg.orderId`
//
// Do la cach re hon (mot index, khong bang moi), va no SAI. Khoi chu thich cua `TransportOrder`
// viet ro quan he don/chang la MOT-NHIEU: *"mot don co the trai tren nhieu chang (chuyen tai, ghep
// xe)"*. Mot unique tren `orderId` bien cau do thanh khong con dung duoc, tuc lane nay se lang le
// go mat mot kha nang ma lane khac da khai.
//
// Bang nay cam dieu #276 L3 that su cam — *"one Order must never be silently attached to two
// active loaded legs"* — o dung grain cua no: mot KE HOACH dang hieu luc cho mot don. Chang van
// tu do nhu cu.
// -----------------------------------------------------------------------------------------------

/// CHE DO GOM NHOM — #276 L1. La CAU HINH cua khach, khong phai mot nhanh `if tenant === ...`.
enum TransportRunGrouping {
  /// Moi don mot vong chay rieng. MAC DINH, va la lua chon giu nguyen hanh vi cu: khong lan lap
  /// ke hoach nao gop hai don lai voi nhau ma nguoi dung khong khai bao dieu do.
  ONE_ORDER_PER_RUN
  /// Mot vong chay mang nhieu chang co hang cua nhieu don, xen ke chang rong khi co di chuyen that.
  MULTI_ORDER_RUN
}

/// Lan lap ke hoach nay da TAO mot vong chay moi hay NOI vao mot vong chay dang chay.
enum TransportRunPlanOutcome {
  NEW_RUN
  APPENDED
}

/// MOT LAN LAP KE HOACH — gan MOT don vao MOT vong chay, kem cac chang no sinh ra.
///
/// `idempotencyKey` la khoa chong lap do nguoi goi dat, cung khuon voi
/// `TransportCommercialAcceptanceDecision.idempotencyKey`: gui lai cung khoa = cung mot hieu qua
/// nghiep vu, khong phai mot ke hoach thu hai. Day la thu duy nhat dung khi mot nguoi bam hai lan
/// hoac mot may khach thu lai sau khi mat song.
///
/// `grouping` duoc CHOT LUC GHI chu khong doc lai tu cau hinh khi bao cao. #276 L1 doi *"changing
/// policy affects future planning only ... do not rewrite active/closed historical runs silently"*
/// — mot bao cao doc lai chinh sach HIEN TAI se ke lai lich su theo mot che do chua he ap dung.
model TransportOrderRunPlan {
  id                 String                  @id @default(cuid())
  orderId            String
  order              TransportOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  runId              String
  run                TransportVehicleRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// Xe cua vong chay, chep lai de tra loi "don nay giao cho xe nao" ma khong phai noi bang.
  vehicleId          String
  /// CHANG CO HANG cua don. BAT BUOC: mot ke hoach khong sinh ra chang co hang thi khong lap gi ca.
  loadedLegId        String                  @unique
  loadedLeg          TransportRunLeg         @relation("TransportOrderRunPlanLoadedLeg", fields: [loadedLegId], references: [id], onDelete: Restrict)
  /// CHANG RONG di truoc chang co hang — CHI khi co di chuyen that (#276 L4: khong bia chang rong).
  /// NULL nghia la diem ket thuc truoc do TRUNG diem lay hang, khong phai "chua biet".
  emptyLegId         String?                 @unique
  emptyLeg           TransportRunLeg?        @relation("TransportOrderRunPlanEmptyLeg", fields: [emptyLegId], references: [id], onDelete: Restrict)
  grouping           TransportRunGrouping
  outcome            TransportRunPlanOutcome
  idempotencyKey     String                  @unique @db.VarChar(120)
  /// Danh tinh tu PHIEN, khong tu than yeu cau — cung quy uoc voi ca mien van tai.
  plannedBy          String
  businessDate       String                  @db.VarChar(10)
  createdAt          DateTime                @default(now())
  /// `GD-02`: HUY thay cho xoa. Mot ke hoach da huy giai phong don cho mot lan lap ke hoach moi —
  /// do la y nghia cua unique MOT PHAN `WHERE "cancelledAt" IS NULL`.
  cancelledAt        DateTime?
  cancellationReason String?

  @@index([runId])
  @@index([orderId])
  @@index([vehicleId])
  @@index([businessDate])
}
