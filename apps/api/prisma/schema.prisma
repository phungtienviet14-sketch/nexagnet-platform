// Prisma schema — Phase 3 (luu tru ben Postgres).
// Nguon su that mo hinh: docs/khach-hang/ultty/nghiep-vu/mo-ta-nghiep-vu.md + docs/phat-trien/kien-truc/he-thong.md (ERD).
// GHI CHU QUAN TRONG: app VAN chay in-memory mac dinh (PERSISTENCE=memory). Prisma chi bat khi
// PERSISTENCE=prisma -> demo/test khong can DB. Migration tao khi co Postgres: docker compose up -d postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Enums (khop literal union trong packages/shared) -----

enum DealerTier {
  dai_ly
  ctv
}

enum DealerStatus {
  active
  inactive
}

enum PolicyType {
  cong_no_30
  cong_no_45
  ky_gui
  thanh_toan_ngay
  cod
}

enum OrderStatus {
  draft
  pending_review
  needs_edit
  approved
  rejected
  sent
  synced
}

/// Trang thai map nhom -> dai ly. `pending` = nhom la (hop thu "nhom chua map").
enum GroupMappingStatus {
  pending
  mapped
  ignored
}

enum CustomerRank {
  dai_ly
  ctv
  khach_le
  unknown
}

enum OperationalRole {
  khach_hang
  sale
  ke_toan
  quan_ly
  ksnb
  bpvh
  ky_thuat
  unknown
}

enum ParticipantHandlingMode {
  inherit_group
  process
  ignore
  manual_review
}

enum ParticipantSource {
  zca_sync
  manual
  // Hoc tu luong tin: moi tin (zca lan Bot) deu kem uid + ten nguoi gui. Duong duy nhat con lai
  // sau khi getGroupInfo tra danh sach rong va Bot Platform khong co API thanh vien (04/08/2026).
  message_stream
}

enum RuleConfigStatus {
  draft
  preview
  active
  archived
}

enum CampaignStatus {
  draft
  approved
  scheduled
  running
  completed
  partially_failed
  cancelled
}

enum CampaignDeliveryStatus {
  pending
  claimed
  sent
  failed
  cancelled
}

enum CampaignKind {
  one_off
  recurring
  birthday
  lunar_month_start
  lunar_full_moon
}

enum PricePeriodStatus {
  draft
  active
  archived
}

enum ContentStatus {
  draft
  reviewed
  approved
  active
}

enum ContentAssetKind {
  image
  video
  pdf
  catalog
  company_profile
}

enum ContentSourceKind {
  local_manifest
  google_drive
  object_storage
  operator
}

enum ContentLinkKind {
  video
  catalog
  company_profile
}

enum UserRole {
  SALE
  MANAGER
  ACCOUNTING
  ADMIN
}

// ----- Nguon su that (tang 6) -----

model Dealer {
  id            String                @id @default(cuid())
  code          String?               @unique
  name          String
  aliases       String[]              @default([])
  tier          DealerTier
  defaultPolicy PolicyType
  phone         String?
  status        DealerStatus          @default(active)
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  groups        Group[]
  overrides     DealerPriceOverride[]
  orders        Order[]
}

/// 1 nhom Zalo -> 1 dai ly. Identity theo globalId khi Zalo co tra; chatId chi de routing.
model Group {
  id              String                @id @default(cuid())
  platform        String                @default("zalo")
  chatId          String
  /// Dinh danh on dinh cua Zalo cho cung mot nhom qua nhieu tai khoan. `chatId` chi la routing
  /// ID theo tai khoan dang dang nhap va co the thay doi khi doi tai khoan zca.
  globalId        String?               @unique
  name            String?
  branch          String?
  dealerId        String?
  dealer          Dealer?               @relation(fields: [dealerId], references: [id])
  status          GroupMappingStatus    @default(pending)
  source          String? // manual | auto_suggest | import
  lastSeenAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        Message[]
  orders          Order[]
  participants    GroupParticipant[]
  campaignTargets CampaignTarget[]
  mappingHistory  GroupMappingHistory[]

  @@unique([platform, chatId])
  @@index([status])
}

/// Lich su append-only cho moi lan map/remap/unmap. Group canonical giu nguyen id noi bo khi
/// routing chatId thay doi theo tai khoan Zalo.
model GroupMappingHistory {
  id               String             @id @default(cuid())
  groupId          String
  group            Group              @relation(fields: [groupId], references: [id])
  previousDealerId String?
  nextDealerId     String?
  previousStatus   GroupMappingStatus
  nextStatus       GroupMappingStatus
  source           String
  actor            String
  requestId        String?
  createdAt        DateTime           @default(now())

  @@index([groupId, createdAt])
}

model GroupParticipant {
  id              String                  @id @default(cuid())
  groupId         String
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalUserId  String
  /// Dinh danh on dinh cua thanh vien qua nhieu tai khoan zca; externalUserId chi la routing UID.
  globalId        String?
  displayName     String
  zaloName        String?
  avatarUrl       String?
  customerRank    CustomerRank            @default(unknown)
  operationalRole OperationalRole         @default(unknown)
  handlingMode    ParticipantHandlingMode @default(inherit_group)
  active          Boolean                 @default(true)
  source          ParticipantSource       @default(zca_sync)
  lastSeenAt      DateTime?
  syncedAt        DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([groupId, externalUserId])
  @@unique([groupId, globalId])
  @@index([groupId, active])
  @@index([externalUserId])
}

model Product {
  sku          String                @id
  name         String
  aliases      String[]              @default([])
  unit         String
  description  String?
  prices       Price[]
  overrides    DealerPriceOverride[]
  orderItems   OrderItem[]
  assets       ProductAsset[]
  faqs         FAQ[]
  advice       AdviceContent[]
  contentLinks ContentLink[]
  readiness    ContentReadiness?
}

/// Bang gia thang (gia dai ly/CTV TRA = wholesale = "Don gia CTV").
model Price {
  id             String      @id @default(cuid())
  periodId       String
  period         PricePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sku            String
  product        Product     @relation(fields: [sku], references: [sku])
  wholesale      Int
  minRetailPrice Int?
  retailPrice    Int?
  listPrice      Int?
  updatedAt      DateTime    @updatedAt

  @@unique([periodId, sku])
  @@index([sku])
}

model Campaign {
  id          String             @id @default(cuid())
  name        String
  content     String
  kind        CampaignKind       @default(one_off)
  templateKey String?
  recurrence  Json?
  metadata    Json               @default("{}")
  status      CampaignStatus     @default(draft)
  approvedBy  String?
  approvedAt  DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  scheduledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  targets     CampaignTarget[]
  deliveries  CampaignDelivery[]

  @@index([status, scheduledAt])
}

model CampaignTarget {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  chatId      String
  displayName String?
  enabled     Boolean           @default(true)
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())
  delivery    CampaignDelivery?

  @@unique([campaignId, chatId])
  @@index([groupId])
}

model CampaignDelivery {
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId       String                 @unique
  target         CampaignTarget         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status         CampaignDeliveryStatus @default(pending)
  scheduledFor   DateTime
  nextAttemptAt  DateTime?
  attempts       Int                    @default(0)
  claimedAt      DateTime?
  claimedBy      String?
  claimExpiresAt DateTime?
  sentAt         DateTime?
  lastError      String?
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, scheduledFor, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([campaignId, status])
}

/// Mot ky gia co vong doi draft -> active -> archived. validMonth nullable CHI de giu du lieu
/// legacy khong co thang; row null luon archived va khong bao gio duoc dung/activate.
model PricePeriod {
  id          String            @id @default(cuid())
  validMonth  String?
  status      PricePeriodStatus @default(draft)
  source      String?
  note        String?
  createdBy   String?
  activatedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activatedAt DateTime?
  prices      Price[]

  @@index([validMonth])
  @@index([status])
}

/// Deal rieng: override gia si theo dealer + sku.
model DealerPriceOverride {
  id            String    @id @default(cuid())
  dealerId      String
  dealer        Dealer    @relation(fields: [dealerId], references: [id])
  sku           String
  product       Product   @relation(fields: [sku], references: [sku])
  price         Int
  /// So luong toi thieu de deal co hieu luc. NULL = ap cho moi so luong (hanh vi truoc 12/08/2026).
  minQuantity   Int?
  enabled       Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([dealerId, sku])
  @@index([enabled, effectiveFrom, effectiveTo])
}

model GlossaryEntry {
  term    String @id
  meaning String
}

// ----- Product content (metadata only; binary remains in Drive/object storage) -----

model SourceProvenance {
  id         String            @id
  kind       ContentSourceKind
  sourceId   String
  locator    String?
  hash       String?
  version    String?
  importedAt DateTime          @default(now())
  assets     Asset[]
  faqs       FAQ[]
  advice     AdviceContent[]
  links      ContentLink[]

  @@unique([kind, sourceId])
}

model Asset {
  id             String            @id
  externalId     String
  kind           ContentAssetKind
  title          String?
  locator        String
  mimeType       String?
  source         ContentSourceKind
  sourceFileId   String?
  hash           String?
  version        String?
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductAsset[]

  @@unique([provenanceId, externalId])
  @@index([status, kind])
}

model ProductAsset {
  productSku String
  product    Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([productSku, assetId])
  @@index([assetId])
}

model FAQ {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  question       String
  answer         String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model AdviceContent {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  title          String
  body           String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model ContentLink {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  kind           ContentLinkKind
  title          String
  url            String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status, kind])
}

model ContentReadiness {
  key        String   @id
  productSku String?  @unique
  product    Product? @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  ready      Boolean  @default(false)
  missing    String[] @default([])
  checkedAt  DateTime @updatedAt
}

// ----- Tin nhan & don (tuan thu: luu MOI tin ngay khi nhan) -----

model Message {
  id                String         @id @default(cuid())
  externalMessageId String
  platform          String         @default("zalo")
  source            String // zca_listener | bot | copilot
  chatId            String
  groupId           String?
  group             Group?         @relation(fields: [groupId], references: [id])
  senderExternalId  String?
  senderDisplayName String?
  text              String
  // Pha 1 (18/08/2026) — huong tin: 'inbound' = khach/dai ly gui vao, 'outbound' = he thong gui ra.
  // Cot da ton tai tren DB tu migration 20260815140000_message_direction; truoc do schema thieu
  // field nay nen `prisma migrate dev` se sinh migration DROP cot. Dung xoa.
  direction         String         @default("inbound")
  // Vai nguoi gui, de dung lai lich su hoi thoai co nhan cho LLM. 'customer' | 'bot' | 'sale'.
  senderRole        String         @default("customer")
  imageUrl          String?
  // Dot A' Task 2 — anh da TAI VE kho ben vung. `imageUrl` la link Zalo, chet sau <=35 ngay
  // (Zalo xoa object phia server); `mediaKey` moi la thu con lai sau do.
  // mediaError != null = da thu tai va that bai — tin VAN nguyen ven, chi thieu file anh.
  mediaKey          String?
  mediaBytes        Int?
  mediaFetchedAt    DateTime?
  mediaError        String?
  sentAt            DateTime
  receivedAt        DateTime       @default(now())
  raw               Json?
  orders            Order[] // legacy first-message relation
  orderProvenance   OrderMessage[]

  @@unique([platform, externalMessageId])
  @@index([chatId])
  // Cua so hoi thoai doc theo nhom + thoi gian giam dan (ConversationContextBuilder.build).
  @@index([chatId, sentAt])
}

model Order {
  id                String          @id @default(cuid())
  status            OrderStatus     @default(pending_review)
  orderType         String? // TH1 | TH2
  intent            String
  senderType        String
  chatId            String
  groupId           String?
  group             Group?          @relation(fields: [groupId], references: [id])
  dealerId          String?
  dealer            Dealer?         @relation(fields: [dealerId], references: [id])
  dealerName        String?
  branch            String?
  groupName         String?
  rawText           String
  imageUrl          String?
  messageId         String?
  message           Message?        @relation(fields: [messageId], references: [id])
  confidence        Json?
  parsed            Json?
  priced            Json?
  trace             Json?
  grandTotal        Int?
  /// Ma don ben ERP cua khach. Trung tinh theo nha cung cap (G1-12); GD1 khong ghi truong nay.
  erpCode           String?
  ruleConfigVersion Int?
  /// Ban day du OrderView (nguon su that cho repo — round-trip khong mat field long nhau).
  view              Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  feedback          ParseFeedback[]
  sourceMessages    OrderMessage[]

  @@index([status])
  @@index([chatId])
}

/// Complete, append-only provenance for orders assembled from one or more chat messages.
/// Order.messageId is retained as a forward-compatible legacy pointer to the first message.
model OrderMessage {
  orderId   String
  messageId String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([orderId, messageId])
  @@index([messageId])
}

/// MACH HOI THOAI theo TUNG KHACH trong MOT nhom (Pha 6 — 21/08/2026).
///
/// Khoa la `(chatId, senderExternalId)`, KHONG phai chatId: mot nhom Zalo co 200 dai ly cung ban
/// tin, khoa theo nhom nghia la cau tra loi "20 cai" cua nguoi nay dien vao don nhap cua nguoi kia.
///
/// `draft` la JSON cua `OrderDraft` (don NUA VOI). Khong tach thanh bang dong hang: no la trang
/// thai tam, song vai chuc phut roi chot thanh `Order` — bang con chi them viec don dep.
model ConversationThread {
  id                String   @id @default(cuid())
  chatId            String
  senderExternalId  String
  senderDisplayName String?
  /// collecting | awaiting_answer | closed | handed_off
  status            String   @default("collecting")
  draft             Json
  /// Slot dang cho khach tra loi: product | quantity | recipient
  awaitingSlots     String[] @default([])
  askCount          Int      @default(0)
  lastQuestion      String?
  lastOrderId       String?
  /// Qua moc nay, tin sau mo mach MOI — khong ke thua don nhap cu.
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([chatId, senderExternalId])
  @@index([chatId, status])
  @@index([expiresAt])
}

model RuleConfigVersion {
  id          String           @id @default(cuid())
  version     Int              @unique @default(autoincrement())
  status      RuleConfigStatus @default(draft)
  payload     Json
  createdBy   String?
  activatedBy String?
  createdAt   DateTime         @default(now())
  activatedAt DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actor])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String?
  product     Product? @relation(fields: [sku], references: [sku])
  skuRaw      String
  productName String?
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  matched     Boolean  @default(false)
}

/// Feedback loop: cap (AI output, ban Sale sua) -> mo rong glossary/few-shot.
model ParseFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  aiOutput  Json
  corrected Json
  createdAt DateTime @default(now())
}

// ----- Quan tri (Phase 5) -----

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String
  role              UserRole
  disabledAt        DateTime?
  credentialVersion Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
}

/// Persistent backing store for express-session. `data` contains the serialized server-side
/// session; the browser receives only the opaque signed sid cookie.
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model KpiEvent {
  id      String   @id @default(cuid())
  type    String
  orderId String?
  payload Json?
  at      DateTime @default(now())

  @@index([type])
}

/// Trang thai mot hang OUTBOX. `dispatched` = engine DA nhan; no KHONG noi gi ve viec workflow
/// chay xong hay chua — do la viec cua engine, va Nexagnet khong nhan ban sao lich su do.
enum WorkflowOutboxStatus {
  pending
  claimed
  dispatched
  failed
  cancelled
}

/// BAN GIAO TIN CAY tu DB nghiep vu sang workflow engine (bai toan ghi hai noi).
///
/// Hang nay duoc ghi TRONG CUNG `$transaction` voi thay doi nghiep vu, nen khong co cua so nao
/// de mot su kien bien mat giua "Order da commit" va "engine da nhan". Xem
/// `apps/api/src/workflow/workflow-outbox.repository.ts` de biet ranh gioi voi Hatchet.
///
/// KHONG phai workflow engine thu hai: khong buoc, khong cay thuc thi, khong replay, khong lich su.
model WorkflowOutbox {
  id                 String               @id @default(cuid())
  /// Khoa thao tac cua Nexagnet. DUY NHAT — xep hai lan cung mot thao tac chi ra mot hang.
  operationKey       String               @unique
  workflowKey        String
  /// Phien ban khuon (`v1`). Ghim tai thoi diem XEP HANG: mot su kien xep hom qua phai chay
  /// bang phien ban cua hom qua, ke ca khi hom nay khach da chuyen sang v2.
  workflowVersion    String
  entityType         String
  entityId           String
  /// Da qua `buildWorkflowInput` — danh sach trang, khong PII, khong bi mat.
  payload            Json
  /// Da qua `buildWorkflowMetadata` — chi neo tuong quan.
  metadata           Json
  traceId            String?
  status             WorkflowOutboxStatus @default(pending)
  attempts           Int                  @default(0)
  maxAttempts        Int
  baseBackoffSeconds Int
  nextAttemptAt      DateTime?
  claimedAt          DateTime?
  claimedBy          String?
  claimExpiresAt     DateTime?
  dispatchedAt       DateTime?
  /// Tham chieu sang lan thuc thi ben engine. Day la SOI DAY duy nhat Nexagnet giu — lich su
  /// chi tiet nam ben engine va bi xoa sau 30 ngay theo cau hinh luu tru cua no.
  engineRunId        String?
  lastError          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([entityType, entityId])
}

// ----- Transport domain: TX-01 Fleet + TX-02 Trip Operations (capability `transport-core`) -----
//
// Nguon mo hinh: docs/kien-truc/transport-domain-contract.md §5 (aggregate), §6 (bat bien),
// §7.1 (may trang thai chuyen). Day la schema CUA MIEN VAN TAI, dung chung cho MOI khach van tai —
// khong co gi rieng cua mot khach o day (guardrail NO_TRANSPORT_TENANT_SLUG_IN_DOMAIN_CODE).
//
// Tien: `BigInt` = SO NGUYEN DONG, kem mot cot `currencyCode`. `GD-03` — VND khong co don vi phu,
// va them cot tien te ve sau la mot migration doc du lieu; them bay gio gan nhu mien phi.
// T2.1/F1 doi `Int` -> `BigInt`: `INTEGER` tran o ~2,1 ty dong, thap hon bien ma HTTP va `money()`
// deu chap nhan, nen ton tai mot khoang gia tri "hop le voi mien, chet o DB".
//
// Ngay nghiep vu: `VarChar(10)` chua `YYYY-MM-DD` theo mui gio tenant (`INV-25`, `GD-04`). CO Y
// khong dung `DateTime`: mot cot timestamp la thu duy nhat ma nguoi doc co the "suy nguoc ra ngay"
// — va suy nguoc bang UTC chinh la loi ma `INV-25` sinh ra de chan. Khong co timestamp thi khong
// co gi de suy nguoc. So sanh khoang va sap xep van dung vi ISO-8601 sap xep theo tu dien.
// T2.1/F3 GIU nguyen quyet dinh nay va them `CHECK` o DB cho dang chuoi (xem duoi).
//
// NAM DOI TUONG DB CUA MIEN NAY KHONG BIEU DIEN DUOC BANG PRISMA SCHEMA
// -----------------------------------------------------------------------------------------------
// Chung song trong SQL tho cua migration `20260830090000_transport_storage_invariants`.
//
//   HAI unique MOT PHAN
//     1. `TransportTripAssignment_activeTrip_key`        — `WHERE "effectiveTo" IS NULL`, theo chuyen
//     2. `TransportVehicleAssignment_activeVehicle_key`  — nhu tren, theo xe
//   BA rang buoc CHECK
//     3. `TransportTrip_freightAmount_money_range`       — khoang tien +-(2^53-1)
//     4. `TransportTrip_businessDate_iso`                — ngay nghiep vu dang YYYY-MM-DD
//     5. `TransportDriver_licenceExpiry_iso`             — han GPLX, cung rang buoc
//
// Prisma khong co cu phap cho `WHERE` tren index lan cho `CHECK`. `migrate deploy` — duong cua CI
// va cua trien khai trong repo nay — giu ca NAM nguyen ven. Nhung `prisma migrate dev` sinh
// migration bang cach diff schema nay voi DB, nen no se sinh lenh XOA ca NAM: dung nhu su co cot
// `direction` da ghi o ke-hoach/tong-quan.md §Pha 0. Ai chay `migrate dev` PHAI doc lai migration
// sinh ra va bo cac dong `DROP INDEX`/`DROP CONSTRAINT` do truoc khi commit.
// -----------------------------------------------------------------------------------------------

enum TransportVehicleStatus {
  IDLE
  ON_TRIP
  UNDER_MAINTENANCE
}

enum TransportDriverStatus {
  ACTIVE
  INACTIVE
}

enum TransportPartyStatus {
  ACTIVE
  INACTIVE
}

/// VT-054: mot doi tac mang NHIEU vai. Day la enum cua tung DONG vai, khong phai cot loai doi tac.
enum TransportPartnerRoleKind {
  CARRIER
  ORDER_REFERRER
}

enum TransportTripKind {
  OWN_DIRECT
  EXTERNAL_CARRIER
  PARTNER_REFERRED_INTERNAL_RUN
}

enum TransportTripStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  RECONCILED
  CANCELLED
}

model TransportVehicle {
  id                String                 @id @default(cuid())
  registrationPlate String                 @unique
  vehicleClass      String
  /// VT-010. NULL = chua nhap.
  allowedPayloadKg  Int?
  /// VT-012. T2 chi GIU so; cap nhat tu dong moi lan do dau la viec cua T4.
  currentOdoKm      Int                    @default(0)
  status            TransportVehicleStatus @default(IDLE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  driverAssignments TransportVehicleAssignment[]
  tripAssignments   TransportTripAssignment[]

  @@index([status])
}

model TransportDriver {
  id            String                @id @default(cuid())
  fullName      String
  phone         String
  licenceClass  String
  /// Han GPLX — NGAY nghiep vu, khong phai khoanh khac.
  licenceExpiry String                @db.VarChar(10)
  status        TransportDriverStatus @default(ACTIVE)
  /// Cau noi user dang nhap -> ho so lai xe. CHI aggregate nay giu no.
  authUserId    String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  vehicleAssignments TransportVehicleAssignment[]
  tripAssignments    TransportTripAssignment[]
  /// `TX-03` — mot lai xe MOT so quy. Chi co mat khi khach bat `transport-costing`.
  fundAccount        TransportDriverFundAccount?
  tripExpenses       TransportTripExpense[]

  @@index([status])
  @@index([licenceExpiry])
}

/// Gan lai xe phu trach mot xe — tang DOI XE. `effectiveTo = NULL` la ban dang hieu luc.
///
/// MOT ban hieu luc cho moi xe duoc CUONG CHE O DB bang unique mot phan
/// `TransportVehicleAssignment_activeVehicle_key` (`WHERE "effectiveTo" IS NULL`), khai trong SQL
/// tho vi Prisma khong co cu phap cho no. Xem khoi canh bao dau muc Transport.
///
/// Unique do cuong che DUNG MOT DIEU: toi da mot ban DANG hieu luc. NHIEU ban DA DONG cua cung mot
/// xe van ghi duoc — `GD-06` doi hoi giu lich su. Dieu do KHONG noi bat bien T1 §5 `TX-01`
/// (*khong chong lap thoi gian cho cung mot xe*): duong ghi dong ban cu DUNG TAI moc mo ban moi,
/// nen ghi binh thuong khong sinh chong lap. Chan chong lap TUY Y can EXCLUSION CONSTRAINT
/// (`btree_gist` + `tstzrange`) — ghi nhan la lua chon siet them ve sau, khong lam o T2.1.
model TransportVehicleAssignment {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       TransportVehicle @relation(fields: [vehicleId], references: [id])
  driverId      String
  driver        TransportDriver  @relation(fields: [driverId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([vehicleId, effectiveTo])
  @@index([driverId])
}

/// KHACH HANG VAN TAI — ben thue van chuyen. KHONG dung chung bang voi `Dealer` cua mien ban hang.
model TransportCustomer {
  id        String               @id @default(cuid())
  name      String
  phone     String?
  address   String?
  taxCode   String?
  status    TransportPartyStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  trips TransportTrip[]

  @@index([status])
}

model TransportPartner {
  id        String               @id @default(cuid())
  name      String
  phone     String?
  status    TransportPartyStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  roles         TransportPartnerRole[]
  carriedTrips  TransportTrip[]        @relation("TransportTripCarrier")
  referredTrips TransportTrip[]        @relation("TransportTripReferrer")

  @@index([status])
}

/// VAI cua doi tac — mot BANG rieng, khong phai mot cot tren `TransportPartner`.
///
/// Khoa chinh kep `(partnerId, role)` lam hai viec cung luc: mot vai khong lap lai duoc, va khong
/// co cho nao de dat mot cot `partnerType` loai tru. Mo hinh XOR ma VT-054 dan tranh khong bieu
/// dien duoc o day — do la ly do bang nay ton tai thay vi mot cot enum.
model TransportPartnerRole {
  partnerId String
  partner   TransportPartner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  role      TransportPartnerRoleKind
  createdAt DateTime                 @default(now())

  @@id([partnerId, role])
  @@index([role])
}

model TransportTrip {
  id                String              @id @default(cuid())
  code              String              @unique
  kind              TransportTripKind
  status            TransportTripStatus @default(PLANNED)
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate      String              @db.VarChar(10)
  /// `GD-05`: v1 mot diem di, mot diem den. Da diem se la bang `TransportTripStop` khi co nguon.
  originLabel       String
  destinationLabel  String
  cargoDescription  String?
  customerId        String?
  customer          TransportCustomer?  @relation(fields: [customerId], references: [id])
  /// Nha xe cho chuyen `EXTERNAL_CARRIER`.
  carrierPartnerId  String?
  carrierPartner    TransportPartner?   @relation("TransportTripCarrier", fields: [carrierPartnerId], references: [id])
  /// Doi tac mang don cho chuyen `PARTNER_REFERRED_INTERNAL_RUN`.
  referrerPartnerId String?
  referrerPartner   TransportPartner?   @relation("TransportTripReferrer", fields: [referrerPartnerId], references: [id])
  /// DOANH THU — gia cuoc thu khach (VT-021), SO NGUYEN DONG. Be mat lai xe khong bao gio thay
  /// cot nay (`INV-09`): `DriverTripView` khong co truong tuong ung de nhan no.
  ///
  /// `BigInt` = `BIGINT` chu khong `INTEGER`: T2.1/F1 — `INTEGER` tran o 2.147.483.647 dong, tuc
  /// mot cuoc 3 ty qua duoc kiem HTTP va kiem mien roi chet o `INSERT`. Khoang thuc te bi `CHECK`
  /// `TransportTrip_freightAmount_money_range` bo hep ve `+-(2^53-1)` cho khop `money()`.
  freightAmount     BigInt?
  currencyCode      String              @default("VND") @db.VarChar(3)
  /// `GD-14` — nhap tay, nullable.
  distanceKm        Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// `GD-02` — huy THAY CHO xoa. Khong co duong xoa cung nao cho mot chuyen.
  cancelledAt       DateTime?
  cancellationReason String?

  assignments TransportTripAssignment[]
  /// `TX-03` — hai lop cua mot khoan chi (`INV-03`). Chuyen la NGUON SU THAT cua ca hai.
  fundEntries TransportDriverFundEntry[]
  expenses    TransportTripExpense[]

  @@index([status])
  @@index([businessDate])
  @@index([kind])
}

/// PHAN CONG CHUYEN — `GD-06`: LICH SU, khong ghi de.
///
/// `effectiveTo = NULL` la ban dang hieu luc; doi xe/lai xe giua chuyen DONG ban cu lai va mo ban
/// moi. Neu day la hai cot tren `TransportTrip` thi lan doi lai xe se xoa mat dau ai cam vo lang
/// luc mot khoan chi phat sinh — va quy trach nhiem so quy theo lai xe (T3) mat co so.
///
/// MOT ban hieu luc cho moi chuyen duoc CUONG CHE O DB bang unique mot phan
/// `TransportTripAssignment_activeTrip_key` (`WHERE "effectiveTo" IS NULL`). Giao dich dong-roi-mo
/// trong `PrismaTripRepository.assign()` la dung voi MOT nguoi ghi; unique nay la thu duy nhat
/// dung voi HAI nguoi ghi cung luc.
///
/// Nhu tren: unique chi cam ban thu hai DANG hieu luc, khong cam nhieu ban DA DONG. `assign()`
/// dat `previous.effectiveTo = current.effectiveFrom`, nen chuoi lich su noi lien nhau, khong ho
/// va khong chong lap.
model TransportTripAssignment {
  id            String            @id @default(cuid())
  tripId        String
  trip          TransportTrip     @relation(fields: [tripId], references: [id])
  vehicleId     String?
  vehicle       TransportVehicle? @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        TransportDriver?  @relation(fields: [driverId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  assignedBy    String
  createdAt     DateTime          @default(now())

  @@index([tripId, effectiveTo])
  @@index([driverId])
  @@index([vehicleId])
}

// ----- Transport domain: TX-03 Costing + Driver Fund (capability `transport-costing`) -----
//
// CANH BAO — BON DOI TUONG DB CUA T3 KHONG CO O DAY. Chung song trong SQL tho cua migration
// `20260830140000_transport_costing` vi Prisma khong co cu phap cho chung:
//
//     1. `TransportDriverFundPeriod_no_overlap`  — EXCLUDE ... USING gist, chan hai ky chong lap
//     2. `TransportDriverFundEntry_sign_by_kind` — CHECK dau theo loai but toan
//     3. `TransportTripExpense_sign_by_kind`     — CHECK dau: khoan chi duong, dong dao am
//     4. `TransportTripExpense_fund_leg`         — CHECK: chi khoan tu quy moi co dong quy sinh doi
//
// (cong hai `CHECK` khoang tien va hai `CHECK` dang ngay — dem day du o `transport-costing-storage.spec.ts`)
//
// `prisma db push` va `prisma migrate dev --create-only` deu KHONG biet nhung thu nay. Sinh lai
// migration tu schema roi ap thang len mot DB dang chay se lam chung BIEN MAT — va he thong van
// chay binh thuong, chi khong con chan gi ca. Do la kieu hong im lang nhat co the co o mot so cai.
//
// `EXCLUDE` doi extension `btree_gist`. DO DUOC tren PostgreSQL 16.15 (30/08/2026): day la mot
// TRUSTED extension, nen role `zalo` cua stack deploy — KHONG superuser, chi la CHU database — tao
// duoc no. Da chay thu bang dung hinh dang do truoc khi viet migration.

enum TransportDriverFundEntryKind {
  ADVANCE
  RETURN
  TRIP_EXPENSE
  ADJUSTMENT
  REVERSAL
}

enum TransportTripExpenseKind {
  EXPENSE
  REVERSAL
}

enum TransportExpenseFundingSource {
  DRIVER_FUND
  COMPANY_DIRECT
}

enum TransportFundPeriodStatus {
  OPEN
  CLOSING
  CLOSED
  REOPENED
}

/// SO QUY cua mot lai xe. MOT tai khoan cho MOT lai xe (`driverId` unique).
///
/// KHONG CO COT `balance`, va do la ca noi dung cua `INV-01`: so du la KET QUA cong don but toan.
/// Mot cot so du ghi de duoc se lech voi so cai ngay lan dau co mot loi giua hai lan ghi, va tu do
/// khong con cach nao biet ben nao dung. Doc so du = `SUM("signedAmount")`.
model TransportDriverFundAccount {
  id           String          @id @default(cuid())
  driverId     String          @unique
  driver       TransportDriver @relation(fields: [driverId], references: [id])
  currencyCode String          @default("VND") @db.VarChar(3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  entries TransportDriverFundEntry[]
  periods TransportDriverFundPeriod[]
}

/// BUT TOAN SO QUY — BAT BIEN (`INV-20`). Khong co duong `UPDATE`/`DELETE` nao o tang kho.
///
/// `signedAmount` la `BigInt` = `BIGINT`, cung ly le voi `TransportTrip.freightAmount` sau T2.1/F1:
/// `INTEGER` tran o 2.147.483.647 dong, va T3 con CONG DON nhieu but toan lai nen tran som hon nua.
/// Khoang thuc te bi `CHECK` bo hep ve +-(2^53-1) cho khop `money()`.
///
/// `tripId` NULLABLE — `INV-02`, hat giong `FUND-002`: mot lan tam ung khong gan chuyen la duong
/// chay thuong ngay, khong phai ngoai le.
///
/// `correlationKey` UNIQUE lam HAI viec cung luc: chong ghi trung (gui lai cung khoa khong sinh
/// them dong), va noi hai lop cua mot su kien (`INV-03`) — but toan quy va dong gia thanh mang cung
/// mot gia tri.
///
/// `reversalOfId` UNIQUE: mot but toan chi duoc dao DUNG MOT LAN.
model TransportDriverFundEntry {
  id             String                       @id @default(cuid())
  accountId      String
  account        TransportDriverFundAccount   @relation(fields: [accountId], references: [id])
  kind           TransportDriverFundEntryKind
  signedAmount   BigInt
  currencyCode   String                       @default("VND") @db.VarChar(3)
  /// `YYYY-MM-DD` theo mui gio tenant — tinh MOT LAN luc ghi (`INV-25`).
  businessDate   String                       @db.VarChar(10)
  tripId         String?
  trip           TransportTrip?               @relation(fields: [tripId], references: [id])
  correlationKey String                       @unique
  reversalOfId   String?                      @unique
  reversalOf     TransportDriverFundEntry?    @relation("FundEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy     TransportDriverFundEntry?    @relation("FundEntryReversal")
  note           String?
  recordedBy     String
  createdAt      DateTime                     @default(now())

  fundedExpense TransportTripExpense?

  @@index([accountId, businessDate])
  @@index([tripId])
  @@index([kind])
}

/// MOT DONG GIA THANH cua mot chuyen. `tripId` BAT BUOC — `INV-02`.
///
/// `signedAmount` CO DAU: khoan chi duong, dong dao am. Gia thanh truc tiep cua chuyen = tong cot
/// nay. Neu dong dao la mot co `boolean` thay vi mot so am, moi truy van tong se phai nho loai tru
/// no — va lan quen dau tien cho ra mot chuyen dat gap doi thuc te ma khong bao loi.
///
/// `fundedBy` la mot THUOC TINH, khong phai mot bang khac (T1 §5). Hai bang se buoc moi bao cao gia
/// thanh phai UNION hai nguon, va lan quen mot ve dau tien cho ra mot chuyen re hon thuc te.
///
/// `driverFundEntryId` UNIQUE: mot but toan quy khong the la chan cua hai khoan chi.
model TransportTripExpense {
  id                String                        @id @default(cuid())
  tripId            String
  trip              TransportTrip                 @relation(fields: [tripId], references: [id])
  kind              TransportTripExpenseKind
  categoryCode      String                        @db.VarChar(60)
  signedAmount      BigInt
  currencyCode      String                        @default("VND") @db.VarChar(3)
  businessDate      String                        @db.VarChar(10)
  fundedBy          TransportExpenseFundingSource
  driverFundEntryId String?                       @unique
  driverFundEntry   TransportDriverFundEntry?     @relation(fields: [driverFundEntryId], references: [id])
  driverId          String?
  driver            TransportDriver?              @relation(fields: [driverId], references: [id])
  correlationKey    String                        @unique
  reversalOfId      String?                       @unique
  reversalOf        TransportTripExpense?         @relation("TripExpenseReversal", fields: [reversalOfId], references: [id])
  reversedBy        TransportTripExpense?         @relation("TripExpenseReversal")
  /// Tham chieu BANG CHUNG. `PG-05` (chung tu co vong doi) thuoc Platform Track va chua co; Issue
  /// #85 cho phep giu mot tham chieu nho thuoc mien thay vi chan T3, va CAM dung mot he tai lieu
  /// song song. Khi `PG-05` dong, cot nay tro thanh khoa ngoai tro toi chung tu that.
  evidenceLocator   String?
  note              String?
  recordedBy        String
  createdAt         DateTime                      @default(now())

  @@index([tripId, businessDate])
  @@index([driverId])
  @@index([categoryCode])
}

/// KY QUYET TOAN QUY cua MOT so quy — T1 §7.3.
///
/// KHONG chong lap voi ky khac cua cung so quy: cuong che boi EXCLUDE constraint
/// `TransportDriverFundPeriod_no_overlap` (`btree_gist` + `daterange`), khai trong SQL tho vi Prisma
/// khong co cu phap cho EXCLUDE. Kiem o service dung voi MOT nguoi ghi; constraint kia moi dung voi
/// hai nguoi ghi cung luc — dung bai hoc T2.1/F2.
///
/// `CLOSING` va `CLOSED` deu DONG BANG ky. `REOPENED` khong quay ve `OPEN` vi hai trang thai do noi
/// hai dieu khac nhau: mot ky `REOPENED` la ky DA TUNG duoc bao cao ra ngoai.
model TransportDriverFundPeriod {
  id           String                     @id @default(cuid())
  accountId    String
  account      TransportDriverFundAccount @relation(fields: [accountId], references: [id])
  /// Khoang NGAY NGHIEP VU, hai dau DEU TINH.
  startDate    String                     @db.VarChar(10)
  endDate      String                     @db.VarChar(10)
  status       TransportFundPeriodStatus  @default(OPEN)
  closedAt     DateTime?
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  snapshots TransportDriverFundPeriodSnapshot[]

  @@index([accountId, status])
  @@index([accountId, startDate])
}

/// ANH CHUP luc dong ky — APPEND-ONLY, mot hang moi lan dong.
///
/// Mot ky co the dong, mo lai, roi dong lai. Ghi de anh cu se xoa mat "con so da bao cao lan truoc"
/// — dung thu nguoi doi soat can khi ho hoi "vi sao bao cao thang truoc khac?".
///
/// Dong ky KHONG tao but toan (T1 §7.3): bang nay khong nam trong so cai, va tong cua no khong bao
/// gio duoc cong vao so du.
model TransportDriverFundPeriodSnapshot {
  id             String                    @id @default(cuid())
  periodId       String
  period         TransportDriverFundPeriod @relation(fields: [periodId], references: [id])
  /// Lan chup thu may cua ky nay, tu 1.
  sequence       Int
  openingBalance BigInt
  periodNet      BigInt
  /// `openingBalance + periodNet`. Duoc phep AM — hat giong `FUND-003`.
  closingBalance BigInt
  entryCount     Int
  currencyCode   String                    @default("VND") @db.VarChar(3)
  takenAt        DateTime                  @default(now())
  takenBy        String

  @@unique([periodId, sequence])
  @@index([periodId])
}
