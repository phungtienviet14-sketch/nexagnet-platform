// Prisma schema — Phase 3 (luu tru ben Postgres).
// Nguon su that mo hinh: docs/khach-hang/ultty/nghiep-vu/mo-ta-nghiep-vu.md + docs/phat-trien/kien-truc/he-thong.md (ERD).
// GHI CHU QUAN TRONG: app VAN chay in-memory mac dinh (PERSISTENCE=memory). Prisma chi bat khi
// PERSISTENCE=prisma -> demo/test khong can DB. Migration tao khi co Postgres: docker compose up -d postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Enums (khop literal union trong packages/shared) -----

enum DealerTier {
  dai_ly
  ctv
}

enum DealerStatus {
  active
  inactive
}

enum PolicyType {
  cong_no_30
  cong_no_45
  ky_gui
  thanh_toan_ngay
  cod
}

enum OrderStatus {
  draft
  pending_review
  needs_edit
  approved
  rejected
  sent
  synced
}

/// Trang thai map nhom -> dai ly. `pending` = nhom la (hop thu "nhom chua map").
enum GroupMappingStatus {
  pending
  mapped
  ignored
}

enum CustomerRank {
  dai_ly
  ctv
  khach_le
  unknown
}

enum OperationalRole {
  khach_hang
  sale
  ke_toan
  quan_ly
  ksnb
  bpvh
  ky_thuat
  unknown
}

enum ParticipantHandlingMode {
  inherit_group
  process
  ignore
  manual_review
}

enum ParticipantSource {
  zca_sync
  manual
  // Hoc tu luong tin: moi tin (zca lan Bot) deu kem uid + ten nguoi gui. Duong duy nhat con lai
  // sau khi getGroupInfo tra danh sach rong va Bot Platform khong co API thanh vien (04/08/2026).
  message_stream
}

enum RuleConfigStatus {
  draft
  preview
  active
  archived
}

enum CampaignStatus {
  draft
  approved
  scheduled
  running
  completed
  partially_failed
  cancelled
}

enum CampaignDeliveryStatus {
  pending
  claimed
  sent
  failed
  cancelled
}

enum CampaignKind {
  one_off
  recurring
  birthday
  lunar_month_start
  lunar_full_moon
}

enum PricePeriodStatus {
  draft
  active
  archived
}

enum ContentStatus {
  draft
  reviewed
  approved
  active
}

enum ContentAssetKind {
  image
  video
  pdf
  catalog
  company_profile
}

enum ContentSourceKind {
  local_manifest
  google_drive
  object_storage
  operator
}

enum ContentLinkKind {
  video
  catalog
  company_profile
}

enum UserRole {
  SALE
  MANAGER
  ACCOUNTING
  ADMIN
}

// ----- Nguon su that (tang 6) -----

model Dealer {
  id            String                @id @default(cuid())
  code          String?               @unique
  name          String
  aliases       String[]              @default([])
  tier          DealerTier
  defaultPolicy PolicyType
  phone         String?
  status        DealerStatus         @default(active)
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  groups        Group[]
  overrides     DealerPriceOverride[]
  orders        Order[]
}

/// 1 nhom Zalo -> 1 dai ly. Map theo (platform, chatId) — KHONG theo ten nhom.
model Group {
  id              String             @id @default(cuid())
  platform        String             @default("zalo")
  chatId          String
  name            String?
  branch          String?
  dealerId        String?
  dealer          Dealer?            @relation(fields: [dealerId], references: [id])
  status          GroupMappingStatus @default(pending)
  source          String? // manual | auto_suggest | import
  lastSeenAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        Message[]
  orders          Order[]
  participants    GroupParticipant[]
  campaignTargets CampaignTarget[]
  mappingHistory  GroupMappingHistory[]

  @@unique([platform, chatId])
  @@index([status])
}

/// Lich su append-only cho moi lan map/remap/unmap. Group khong bi xoa nen tin/don va lich su
/// luon quy ve cung mot khoa tu nhien (platform, chatId).
model GroupMappingHistory {
  id               String             @id @default(cuid())
  groupId          String
  group            Group              @relation(fields: [groupId], references: [id])
  previousDealerId String?
  nextDealerId     String?
  previousStatus   GroupMappingStatus
  nextStatus       GroupMappingStatus
  source           String
  actor            String
  requestId        String?
  createdAt        DateTime           @default(now())

  @@index([groupId, createdAt])
}

model GroupParticipant {
  id              String                  @id @default(cuid())
  groupId         String
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalUserId  String
  displayName     String
  zaloName        String?
  avatarUrl       String?
  customerRank    CustomerRank            @default(unknown)
  operationalRole OperationalRole         @default(unknown)
  handlingMode    ParticipantHandlingMode @default(inherit_group)
  active          Boolean                 @default(true)
  source          ParticipantSource       @default(zca_sync)
  lastSeenAt      DateTime?
  syncedAt        DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([groupId, externalUserId])
  @@index([groupId, active])
  @@index([externalUserId])
}

model Product {
  sku          String                @id
  name         String
  aliases      String[]              @default([])
  unit         String
  description  String?
  prices       Price[]
  overrides    DealerPriceOverride[]
  orderItems   OrderItem[]
  assets       ProductAsset[]
  faqs         FAQ[]
  advice       AdviceContent[]
  contentLinks ContentLink[]
  readiness    ContentReadiness?
}

/// Bang gia thang (gia dai ly/CTV TRA = wholesale = "Don gia CTV").
model Price {
  id             String      @id @default(cuid())
  periodId       String
  period         PricePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  sku            String
  product        Product     @relation(fields: [sku], references: [sku])
  wholesale      Int
  minRetailPrice Int?
  retailPrice    Int?
  listPrice      Int?
  updatedAt      DateTime    @updatedAt

  @@unique([periodId, sku])
  @@index([sku])
}

model Campaign {
  id          String             @id @default(cuid())
  name        String
  content     String
  kind        CampaignKind       @default(one_off)
  templateKey String?
  recurrence  Json?
  metadata    Json               @default("{}")
  status      CampaignStatus     @default(draft)
  approvedBy  String?
  approvedAt  DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  scheduledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  targets     CampaignTarget[]
  deliveries  CampaignDelivery[]

  @@index([status, scheduledAt])
}

model CampaignTarget {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  chatId      String
  displayName String?
  enabled     Boolean           @default(true)
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())
  delivery    CampaignDelivery?

  @@unique([campaignId, chatId])
  @@index([groupId])
}

model CampaignDelivery {
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId       String                 @unique
  target         CampaignTarget         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status         CampaignDeliveryStatus @default(pending)
  scheduledFor   DateTime
  nextAttemptAt  DateTime?
  attempts       Int                    @default(0)
  claimedAt      DateTime?
  claimedBy      String?
  claimExpiresAt DateTime?
  sentAt         DateTime?
  lastError      String?
  idempotencyKey String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, scheduledFor, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([campaignId, status])
}

/// Mot ky gia co vong doi draft -> active -> archived. validMonth nullable CHI de giu du lieu
/// legacy khong co thang; row null luon archived va khong bao gio duoc dung/activate.
model PricePeriod {
  id          String            @id @default(cuid())
  validMonth  String?
  status      PricePeriodStatus @default(draft)
  source      String?
  note        String?
  createdBy   String?
  activatedBy String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  activatedAt DateTime?
  prices      Price[]

  @@index([validMonth])
  @@index([status])
}

/// Deal rieng: override gia si theo dealer + sku.
model DealerPriceOverride {
  id            String   @id @default(cuid())
  dealerId      String
  dealer        Dealer   @relation(fields: [dealerId], references: [id])
  sku           String
  product       Product  @relation(fields: [sku], references: [sku])
  price         Int
  enabled       Boolean  @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([dealerId, sku])
  @@index([enabled, effectiveFrom, effectiveTo])
}

model GlossaryEntry {
  term    String @id
  meaning String
}

// ----- Product content (metadata only; binary remains in Drive/object storage) -----

model SourceProvenance {
  id         String            @id
  kind       ContentSourceKind
  sourceId   String
  locator    String?
  hash       String?
  version    String?
  importedAt DateTime          @default(now())
  assets     Asset[]
  faqs       FAQ[]
  advice     AdviceContent[]
  links      ContentLink[]

  @@unique([kind, sourceId])
}

model Asset {
  id             String            @id
  externalId     String
  kind           ContentAssetKind
  title          String?
  locator        String
  mimeType       String?
  source         ContentSourceKind
  sourceFileId   String?
  hash           String?
  version        String?
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductAsset[]

  @@unique([provenanceId, externalId])
  @@index([status, kind])
}

model ProductAsset {
  productSku String
  product    Product @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  assetId    String
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([productSku, assetId])
  @@index([assetId])
}

model FAQ {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  question       String
  answer         String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model AdviceContent {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  title          String
  body           String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status])
}

model ContentLink {
  id             String            @id
  externalId     String
  productSku     String?
  product        Product?          @relation(fields: [productSku], references: [sku], onDelete: SetNull)
  kind           ContentLinkKind
  title          String
  url            String
  status         ContentStatus     @default(draft)
  provenanceId   String?
  provenance     SourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  operatorEdited Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provenanceId, externalId])
  @@index([productSku, status, kind])
}

model ContentReadiness {
  key        String   @id
  productSku String?  @unique
  product    Product? @relation(fields: [productSku], references: [sku], onDelete: Cascade)
  ready      Boolean  @default(false)
  missing    String[] @default([])
  checkedAt  DateTime @updatedAt
}

// ----- Tin nhan & don (tuan thu: luu MOI tin ngay khi nhan) -----

model Message {
  id                String    @id @default(cuid())
  externalMessageId String
  platform          String    @default("zalo")
  source            String // zca_listener | bot | copilot
  chatId            String
  groupId           String?
  group             Group?    @relation(fields: [groupId], references: [id])
  senderExternalId  String?
  senderDisplayName String?
  text              String
  imageUrl          String?
  // Dot A' Task 2 — anh da TAI VE kho ben vung. `imageUrl` la link Zalo, chet sau <=35 ngay
  // (Zalo xoa object phia server); `mediaKey` moi la thu con lai sau do.
  // mediaError != null = da thu tai va that bai — tin VAN nguyen ven, chi thieu file anh.
  mediaKey          String?
  mediaBytes        Int?
  mediaFetchedAt    DateTime?
  mediaError        String?
  sentAt            DateTime
  receivedAt        DateTime  @default(now())
  raw               Json?
  orders            Order[]

  @@unique([platform, externalMessageId])
  @@index([chatId])
}

model Order {
  id                String          @id @default(cuid())
  status            OrderStatus     @default(pending_review)
  orderType         String? // TH1 | TH2
  intent            String
  senderType        String
  chatId            String
  groupId           String?
  group             Group?          @relation(fields: [groupId], references: [id])
  dealerId          String?
  dealer            Dealer?         @relation(fields: [dealerId], references: [id])
  dealerName        String?
  branch            String?
  groupName         String?
  rawText           String
  imageUrl          String?
  messageId         String?
  message           Message?        @relation(fields: [messageId], references: [id])
  confidence        Json?
  parsed            Json?
  priced            Json?
  trace             Json?
  grandTotal        Int?
  /// Ma don ben ERP cua khach. Trung tinh theo nha cung cap (G1-12); GD1 khong ghi truong nay.
  erpCode           String?
  ruleConfigVersion Int?
  /// Ban day du OrderView (nguon su that cho repo — round-trip khong mat field long nhau).
  view              Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             OrderItem[]
  feedback          ParseFeedback[]

  @@index([status])
  @@index([chatId])
}

model RuleConfigVersion {
  id          String           @id @default(cuid())
  version     Int              @unique @default(autoincrement())
  status      RuleConfigStatus @default(draft)
  payload     Json
  createdBy   String?
  activatedBy String?
  createdAt   DateTime         @default(now())
  activatedAt DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actor])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String?
  product     Product? @relation(fields: [sku], references: [sku])
  skuRaw      String
  productName String?
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  matched     Boolean  @default(false)
}

/// Feedback loop: cap (AI output, ban Sale sua) -> mo rong glossary/few-shot.
model ParseFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  aiOutput  Json
  corrected Json
  createdAt DateTime @default(now())
}

// ----- Quan tri (Phase 5) -----

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  name              String
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String
  role              UserRole
  disabledAt        DateTime?
  credentialVersion Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
}

/// Persistent backing store for express-session. `data` contains the serialized server-side
/// session; the browser receives only the opaque signed sid cookie.
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model KpiEvent {
  id      String   @id @default(cuid())
  type    String
  orderId String?
  payload Json?
  at      DateTime @default(now())

  @@index([type])
}
