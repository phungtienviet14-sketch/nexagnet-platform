# CONG PHUC VU PWA Nexagent Transport — MOT origin cho ca vo ung dung LAN API (#394).
#
# VI SAO CUNG ORIGIN: PWA dang nhap bang cookie phien HttpOnly + CSRF, dung mo hinh cua web hien tai
# (`apps/transport-mobile/src/session/auth-carrier.web.ts`). Cookie phien khong co `Domain`, tuc chi
# thuoc DUNG host trinh duyet nhin thay — nen trinh duyet phai goi `/auth`, `/transport`, `/files`
# vao chinh host phuc vu PWA, va Caddy nay chuyen tiep sang API. Khong co token nao trong JS.
#
# TLS do tang phia truoc cat (edge Railway, hoac edge Caddy tren VM); Caddy nay chi noi HTTP noi bo.
#
# BIEN MOI TRUONG (khong bien nao la bi mat):
#   PORT                   cong nghe (Railway tu dat; mac dinh 8080)
#   API_UPSTREAM           http://<host API noi bo>:<cong> — vd http://api-321.railway.internal:3001
#   PWA_FORCE_HTTPS_PROTO  on | off (mac dinh on) — xem snippet `api_proxy_on`
#   PWA_ROOT               thu muc ban xuat web (mac dinh /srv — image Docker chep dist-web vao do)
#
# Chay thu: caddy validate --config deploy/pwa/Caddyfile --adapter caddyfile (can API_UPSTREAM).
{
	# Khong co ACME, khong co cong quan tri: container nay khong giu chung chi, va mot endpoint
	# quan tri trong mang noi bo cho ai cung viet lai duoc dinh tuyen.
	auto_https off
	admin off
}

# API — chuyen tiep NGUYEN VEN: Host cua PWA (cookie phien la host-only cua origin nay), Cookie,
# Set-Cookie, x-csrf-token, Authorization (neu co) — khong them, khong bot tieu de nao.
#
# `X-Forwarded-Proto https`: API chay `trust proxy 1` + cookie `secure: true`. Edge (Railway) da cat
# TLS va noi HTTP tran toi Caddy; Caddy mac dinh GHI DE `X-Forwarded-Proto` bang scheme no nhan
# (`http`) vi edge khong nam trong `trusted_proxies`. Khi do express-session thay yeu cau "khong an
# toan" va KHONG dat cookie Secure — dang nhap tra 200 ma phien khong bao gio co, im lang. Chi tat
# (`PWA_FORCE_HTTPS_PROTO=off`) khi chay thu HTTP tran ma API cung khong o NODE_ENV=production.
(api_proxy_on) {
	reverse_proxy {$API_UPSTREAM} {
		header_up X-Forwarded-Proto https
	}
}

(api_proxy_off) {
	reverse_proxy {$API_UPSTREAM}
}

# TIEU DE BAO MAT cho vo ung dung (khong ap len phan hoi API — do la viec cua API).
#
# CSP, tung dong mot ly do (do bang e2e-web: trang chay DUOI chinh chinh sach nay, xem docs/pwa.md):
#   script-src 'self'            ban xuat Expo (web.output "single") KHONG co script noi dong nao —
#                                pwa-postexport.mjs do neu co; khong can hash/nonce/'unsafe-inline'.
#   style-src 'unsafe-inline'    react-native-web + expo-font chen <style> luc chay; khong co cach dat
#                                nonce cho chung. Rui ro con lai: CSS injection, khong phai chay ma.
#   connect-src blob: data:      hang doi ngoai tuyen chep anh chung tu tu `blob:`/`data:` (camera/thu
#                                vien cua trinh duyet) vao IndexedDB bang `fetch`.
#   *.openfreemap.org            ban do nen (MapLibre): style/tile/glyph qua fetch, sprite qua img.
#   worker-src blob:             MapLibre dung worker tu blob; `'self'` cho /sw.js.
(pwa_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' blob: data: https://tiles.openfreemap.org; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

:{$PORT:8080} {
	log
	encode zstd gzip

	# Trung tien to voi `API_PREFIXES` trong apps/transport-mobile/public/sw.js — SW khong bao gio
	# cache nhung duong nay; them mot tien to o day thi them o do.
	@api path /auth* /transport* /files* /health*
	handle @api {
		import api_proxy_{$PWA_FORCE_HTTPS_PROTO:on}
	}

	# Tep co BAM trong ten: cache vinh vien. Thieu tep thi 404 THAT (khong roi ve index.html) — mot
	# trang HTML tra cho mot URL .js, kem `immutable`, se nam trong cache trinh duyet mai mai.
	@hashed path /_expo/static/* /assets/*
	handle @hashed {
		import pwa_headers
		root * {$PWA_ROOT:/srv}
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Vo ung dung, SW, manifest, icon: LUON hoi lai may chu (ETag) — ban moi len la thay ngay.
	handle {
		import pwa_headers
		root * {$PWA_ROOT:/srv}
		header Cache-Control "no-cache"
		# Go khong biet duoi .webmanifest -> se tra khong co Content-Type.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}
}
