{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 14,
        "matchesPrefix": [
          "daily/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 35,
        "matchesPrefix": [
          "weekly/"
        ]
      }
    },
    {
      "action": {
        "storageClass": "NEARLINE",
        "type": "SetStorageClass"
      },
      "condition": {
        "age": 60,
        "matchesPrefix": [
          "media/"
        ],
        "matchesStorageClass": [
          "STANDARD"
        ]
      }
    },
    {
      "action": {
        "storageClass": "COLDLINE",
        "type": "SetStorageClass"
      },
      "condition": {
        "age": 365,
        "matchesPrefix": [
          "media/"
        ],
        "matchesStorageClass": [
          "NEARLINE"
        ]
      }
    }
  ]
}
