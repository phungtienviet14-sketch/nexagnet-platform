{
	admin off
	email {$ACME_EMAIL}
}

(app_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

(app_routes) {
	# Liet ke TUNG endpoint API duoi /settings thay vi /settings/*: `/settings/` (co dau / cuoi)
	# van khop /settings/* nen se bi day sang NestJS va tra 404 — nguoi van hanh tuong chua co trang.
	#
	# DANH SACH NAY PHAI THEO KIP CONTROLLER. Route co trong code ma thieu o day thi tren ban deploy
	# no roi xuong Next.js va tra 404 — dung kieu hong da gap 04/08/2026 ("giao dien co du, chi la
	# khong co duong di toi"). caddy-route-contract.test.mjs doc nguoc tu apps/api/src va bat CI do
	# neu thieu, nen dung sua tay danh sach nay ma khong chay test.
	@api path /events /orders* /messages* /demo* /erp* /kiotviet* /knowledge* /broadcast* /campaigns* /auth* /health /health/media /media/catalog/* /zalo/* /groups/* /settings/summary /settings/source-truth* /settings/groups/* /settings/rules* /settings/automation* /settings/audit* /settings/readiness /settings/price-periods* /settings/dealers/* /settings/deals/* /settings/content* /settings/master-data* /settings/users* /admin*
	handle @api {
		reverse_proxy api:3001 {
			header_up x-api-key "{$API_KEY}"
			header_up -Authorization
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up -Authorization
		}
	}
}

http://:8080 {
	import app_headers
	import app_routes
}

# MOI TRUONG DEV/DEMO — KHONG CO XAC THUC (quyet dinh nguoi van hanh 04/08/2026).
# Ca hai hostname duoi day mo cong khai, khong Basic Auth; API phia sau chay AUTH_MODE=none.
#
# 04/08/2026 (dot 2): BO not @blocked tren hostname demo. Truoc do demo tra 404 cho /settings*,
# /zalo*, /groups*, /broadcast*, /admin* -> nguoi van hanh mo demo.../settings chi thay
# "Khong co quyen truy cap" va tuong he thong chua co trang cau hinh. Nay HAI hostname hanh xu
# GIONG HET NHAU, khong con "trang nay chay o cho kia thi khong".
# DANH DOI da biet: /broadcast gui tin Zalo THAT, gio goi duoc tu ca hostname demo.
# Bat lai bao ve: them `basic_auth` + khoi @blocked o day, va dat AUTH_MODE=api-key
# trong .runtime/secrets.env (xem README muc "Moi truong dev/demo").
{$DEMO_DOMAIN} {
	import secure_headers
	import app_headers
	import app_routes
}

{$OPERATOR_DOMAIN} {
	import secure_headers
	import app_headers
	import app_routes
}

{$FLOWISE_DOMAIN} {
	import secure_headers
	reverse_proxy flowise:3000 {
		header_down Set-Cookie (.*) "$1; Secure"
	}
}
