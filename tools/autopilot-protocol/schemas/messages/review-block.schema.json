{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexagnet:autopilot:v0:message:review-block",
  "title": "REVIEW_BLOCK",
  "description": "ChatGPT Reviewer chan DUNG mot HEAD, kem danh sach blocker. REVIEWING -> FIXING neu con luot sua. Khoa review-verdict:<pr>:<head_sha>:REVIEW_BLOCK.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "marker", "type", "issue", "pr", "head_sha", "blockers"],
  "properties": {
    "protocol": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/protocolVersion" },
    "marker": { "const": "CHATGPT_REVIEW_V0" },
    "type": { "const": "REVIEW_BLOCK" },
    "issue": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/issueNumber" },
    "pr": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/prNumber" },
    "head_sha": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/sha40" },
    "blockers": {
      "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/nonEmptyTextList",
      "description": "Mot REVIEW_BLOCK khong co blocker nao la vo nghia — bi tu choi."
    }
  }
}
