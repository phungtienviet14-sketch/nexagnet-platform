{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexagnet:autopilot:v0:message:ci-fail",
  "title": "CI_FAIL",
  "description": "GitHub Actions bao CI do tren dung HEAD. CI -> FIXING neu con luot sua, nguoc lai -> BLOCKED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "marker", "type", "issue", "pr", "head_sha", "ci_run"],
  "properties": {
    "protocol": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/protocolVersion" },
    "marker": { "const": "AUTOPILOT_CI_FAIL_V0" },
    "type": { "const": "CI_FAIL" },
    "issue": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/issueNumber" },
    "pr": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/prNumber" },
    "head_sha": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/sha40" },
    "ci_run": { "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/runId" },
    "failed_checks": {
      "$ref": "urn:nexagnet:autopilot:v0:common#/$defs/nonEmptyTextList",
      "description": "Ten cac check do (tuy chon). Ten khop context cua required_status_checks."
    }
  }
}
